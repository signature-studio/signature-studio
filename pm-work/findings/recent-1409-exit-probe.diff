 /* ---- the call ---- */
+/* Issue #1409 (a measurement; it runs only while the window-API trace is on, so the default run is unchanged): FL64.exe calls instance->vtable[0](instance) when CreateFruityInstance
+ * returns 0 or 2 (the reading in fruity_run). The stage 1 harness does not make that call; with the trace on, this makes it, so the writes of the instance's own shutdown reach the trace. */
+static void exit_probe(uint64_t inst) {
+    uint64_t vt = 0, s0 = 0, r = 0, calls0;
+    char nb[160];
+    if (!inst || !(fle_win_api_trace_on && fle_win_api_trace_on())) return;
+    if (!peek(inst, &vt, 8) || !peek(vt, &s0, 8)) {
+        printf("fruity: exit probe: the instance %#llx is not readable\n", ULL(inst));
+        return;
+    }
+    printf("fruity: exit probe: calling instance->vtable[0] %#llx (%s) with rcx=instance %#llx\n", ULL(s0), func_name(s0, nb, sizeof nb), ULL(inst));
+    fflush(stdout);
+    calls0 = trace_call_count();
+    trace_set_call_limit(calls0 + cfg_max_calls);
+    trace_limit_hook = on_calls_limit;
+    if (fle_thread_set_idle_stop) fle_thread_set_idle_stop(1);   /* a wait for input with no event ends the probe by name (the page's idle would wait for it) */
+    active = 1;
+    r = fle_call_guest(s0, inst, 0, 0, 0);
+    active = 0;
+    trace_limit_hook = NULL;
+    printf("fruity: exit probe: returned rax=%#llx after %llu lifted entries\n", ULL(r), ULL(trace_call_count() - calls0));
+    fflush(stdout);
+}
+
