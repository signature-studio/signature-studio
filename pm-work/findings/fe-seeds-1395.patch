+/// The seed file of a DLL is the installer's file, which the extraction puts in the host tree from the plugin rows. A host tree that was
+/// extracted before the plugin row was there (the base of a run) has the DLL under its key and not the seed file: the seed file is then
+/// copied from the key's file, whose SHA-256 must be the row's.
+fn seed_copies(dlls: &[Dll]) -> Result<(), String> {
+    for d in dlls {
+        let seed = format!("{HOST_DIR}/{}", d.seed_file());
+        if Path::new(&seed).exists() {
+            continue;
+        }
+        let host = format!("{HOST_DIR}/{}", d.host_file());
+        let got = crate::sha256_hex(&host)?;
+        if got != d.sha256 {
+            return Err(format!("{host}: SHA-256 {got}, expected {} (the plugin row of {})", d.sha256, d.key));
+        }
+        if let Some(dir) = Path::new(&seed).parent() {
+            fs::create_dir_all(dir).map_err(|e| format!("{}: {e}", dir.display()))?;
+        }
+        fs::copy(&host, &seed).map_err(|e| format!("{seed}: {e}"))?;
+    }
+    Ok(())
+}
+
 /// The tables of the build, from the plugin rows and the fixed rows. `with_base` is false in the extraction (no host yet): the
 /// extraction table and the seed table do not depend on the bases, and the lists are left alone. With the bases, lists/ gets the
 /// fixed lists again (the lists stage then writes the plugins' lists, so no list of a removed plugin is left behind).
@@ -704,6 +726,7 @@ pub fn generate(with_base: bool) -> Result<(), String> {
     if !with_base {
         return Ok(());
     }
+    seed_copies(&dlls)?;
     let lists = format!("{OUT_DIR}/lists");
     let _ = fs::remove_dir_all(&lists);
     fs::create_dir_all(&lists).map_err(|e| format!("{lists}: {e}"))?;
diff --git a/lift/crates/fe-decode/src/relocseeds.rs b/lift/crates/fe-decode/src/relocseeds.rs
index c2386d43..152cce73 100644
--- a/lift/crates/fe-decode/src/relocseeds.rs
+++ b/lift/crates/fe-decode/src/relocseeds.rs
@@ -57,3 +57,36 @@ pub fn reloc_seeds(pe: &Pe<'_>) -> Result<RelocSeeds, String> {
 pub fn reloc_pdata_seeds(pe: &Pe<'_>) -> Result<Vec<u64>, String> {
     Ok(reloc_seeds(pe)?.seeds)
 }
+
+/// Issue #1395 (`--rva-tables`): the rows of a table file, `RVA COUNT` (hex RVA, decimal count; `#` comments). Each names a table of
+/// `COUNT` 32-bit values that hold RVAs from the ImageBase (the switch tables of MSVC code that jumps to `ImageBase + entry`, whose
+/// targets are other functions, so the analysis has no function entry for them).
+pub fn rva_tables(text: &str) -> Result<Vec<(u32, usize)>, String> {
+    let mut out = Vec::new();
+    for l in text.lines().map(str::trim).filter(|l| !l.is_empty() && !l.starts_with('#')) {
+        let f: Vec<&str> = l.split_whitespace().collect();
+        let (Some(rva), Some(n)) = (f.first().and_then(|r| u32::from_str_radix(r.trim_start_matches("0x"), 16).ok()), f.get(1).and_then(|n| n.parse::<usize>().ok())) else {
+            return Err(format!("bad table row: {l}"));
+        };
+        out.push((rva, n));
+    }
+    Ok(out)
+}
+
+/// The code addresses that the entries of the tables of `rva_tables` hold (ImageBase + entry, inside `.text`), ascending.
+pub fn rva_table_seeds(pe: &Pe<'_>, tables: &[(u32, usize)]) -> Result<Vec<u64>, String> {
+    let text = Text::from_pe(pe)?;
+    let base = pe.optional.image_base;
+    let mut out = BTreeSet::new();
+    for &(rva, n) in tables {
+        let raw = pe.slice_at_rva(rva, 4 * n).map_err(|e| format!("table {rva:#x}: {e}"))?;
+        for k in 0..n {
+            let v = u32::from_le_bytes(raw[4 * k..4 * k + 4].try_into().unwrap());
+            let va = base + v as u64;
+            if text.contains(va) {
+                out.insert(va);
+            }
+        }
+    }
+    Ok(out.into_iter().collect())
+}
