#!/usr/bin/env bash
# pre-push: (1) scan every tracked file, (2) refuse when the remote repository is PUBLIC or its visibility cannot be determined.
# Arguments from git: $1 = remote name, $2 = remote URL. There is no environment variable or option that skips this
# (docs/policies: no options). A human who has decided to push anyway uses `git push --no-verify`.
# Limit: only the files of the current tree are scanned, not the history of earlier commits.
set -o pipefail

root=$(git rev-parse --show-toplevel) || { echo "pre-push: not inside a git work tree" >&2; exit 1; }
cd "$root" || { echo "pre-push: cannot enter $root" >&2; exit 1; }
url="${2:-}"

[ -x scripts/scan-forbidden.sh ] || { echo "pre-push: scripts/scan-forbidden.sh is missing or not executable; refusing to push without the scan" >&2; exit 1; }
git ls-files -z | xargs -0 scripts/scan-forbidden.sh > /dev/null || {
  echo "pre-push: the push is rejected: tracked files contain forbidden strings. Run scripts/scan-forbidden.sh for rule, file and line." >&2
  exit 1
}

owner_repo=$(printf '%s' "$url" | sed -nE 's#^(https://([^/@]+@)?github\.com/|git@github\.com:|ssh://git@github\.com/)([^/]+/[^/]+)$#\3#p' | sed -E 's#\.git$##')
if [ -z "$owner_repo" ]; then
  echo "pre-push: the push is rejected: '$url' is not a GitHub URL, so its visibility cannot be checked. A human who knows the remote is private can use: git push --no-verify" >&2
  exit 1
fi
command -v gh > /dev/null || { echo "pre-push: the push is rejected: gh is not installed, so the visibility of $owner_repo cannot be checked" >&2; exit 1; }
private=$(gh api "repos/$owner_repo" --jq .private 2> /dev/null)
case "$private" in
  true) exit 0 ;;
  false)
    echo "pre-push: the push is rejected: $owner_repo is PUBLIC. lift output, wasm, FL binaries and investigation excerpts would be published. Visibility has to be confirmed or changed by the owner. A human who decided otherwise can use: git push --no-verify" >&2
    exit 1 ;;
  *)
    echo "pre-push: the push is rejected: could not read the visibility of $owner_repo (gh api failed). Treated as PUBLIC. A human who knows it is private can use: git push --no-verify" >&2
    exit 1 ;;
esac
