# ci/versions.env - the tool versions of the build (sourced by ci/*.sh; part of the stage keys). Changing a line rebuilds the stages that use the tool.
# The values are what the machine that produced the reference bundles uses (checked 2026-11-04): emcc 6.0.12 (emsdk repo rev below, node 24.19.0 and wasm-opt version 133 inside it), rustc 1.99.0, python 3.14.
EMSDK_VERSION=6.0.12
EMSDK_REPO=https://github.com/emscripten-core/emsdk.git
EMSDK_REV=35ff8a6d150541276abbc6bae512ca90bcfbe220
RUST_TOOLCHAIN=1.99.0
PYTHON_VERSION=3.14
NODE_VERSION=24
EMSDK_DIR=${EMSDK_DIR:-/opt/emsdk}   # build-engine-bundle.sh hard-codes /opt/emsdk: override only to test the installation
# upstream Blend2D (decision 0160, 0167): pinned in lift/harness/b2d1/build_upstream.sh (commit + tarball SHA-256); fetched from github.com/blend2d/blend2d at run time.
