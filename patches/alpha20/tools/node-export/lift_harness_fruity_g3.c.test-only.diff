+/* decision 0308/0310 (alpha1, TEST ONLY): the callback of vfsdumpdir */
+struct vdd { const char *dir; unsigned idx; };
+static int g3_vdd_cb(const uint16_t *name, size_t nlen, const uint8_t *data, uint64_t size, int is_dir, void *u) {
+    struct vdd *st = (struct vdd *)u;
+    char nm[300], path[700], hex[65];
+    size_t i;
+    sha_t sh;
+    FILE *f;
+    for (i = 0; i < nlen && i < sizeof nm - 1; i++) {
+        uint16_t c = name[i];
+        nm[i] = (c < 128 && ((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '.' || c == '_' || c == '-')) ? (char)c : '_';
+    }
+    nm[i] = 0;
+    if (is_dir) { printf("g3-vfsdumpdir: %s: directory\n", nm); return 0; }
+    sha_init(&sh); if (size) sha_update(&sh, data, (size_t)size); sha_final(&sh, hex);
+    if (st->dir && st->dir[0]) {
+        snprintf(path, sizeof path, "%s/%02u-%s", st->dir, st->idx, nm);
+        f = fopen(path, "wb");
+        if (f) {   /* TEST ONLY: copy through a staging buffer in low memory (a pointer above 2 GiB must not reach the JS file system as a signed number) */
+            static unsigned char stage[1u << 20];
+            uint64_t off = 0;
+            while (off < size) { size_t c = (size - off) > sizeof stage ? sizeof stage : (size_t)(size - off); memcpy(stage, data + off, c); fwrite(stage, 1, c, f); off += c; }
+            fclose(f);
+        }
+        printf("g3-vfsdumpdir: %s: %" PRIu64 " bytes sha256 %s -> %s%s\n", nm, size, hex, path, f ? "" : " (NOT WRITTEN)");
+    } else printf("g3-vfsdumpdir: %s: %" PRIu64 " bytes sha256 %s\n", nm, size, hex);
+    st->idx++;
+    return 0;
+}
