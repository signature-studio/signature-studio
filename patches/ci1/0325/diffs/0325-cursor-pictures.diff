diff -ruN a/lift/harness/c0325/build.sh b/lift/harness/c0325/build.sh
--- a/lift/harness/c0325/build.sh	1970-01-01 09:00:00.000000000 +0900
+++ b/lift/harness/c0325/build.sh	2026-11-07 08:12:45.726348965 +0900
@@ -0,0 +1,19 @@
+#!/bin/bash
+# Decision 0325 (ci1, native test). usage: build.sh TREE WORKDIR [I|M|S]   -> WORKDIR/cursor_img (clang -O0, nice 19) and its output WORKDIR/cursor_img.out
+set -eu -o pipefail
+T=$(readlink -f "$1"); mkdir -p "$2"; W=$(readlink -f "$2"); RT=$T/lift/runtime; HERE=$T/lift/harness/c0325
+WL="fle_api2_call fle_appview fle_callback fle_class fle_comctl fle_cursor fle_env fle_event fle_gdc fle_gdi fle_host fle_imports fle_input fle_layered fle_locale fle_mxcsr fle_proc fle_raster fle_res fle_sys fle_thread fle_time fle_token fle_vfs fle_visrgn fle_vmap fle_vol fle_wall_ia2 fle_wall_ia2w fle_win fle_x87 fle_x87ctl fle_loadimage"
+O=""
+for f in $WL; do
+  if [ ! -f "$W/$f.o" ] || [ "$RT/$f.c" -nt "$W/$f.o" ]; then nice -n 19 clang -O0 -std=gnu11 -w -fPIE -c -I"$RT" "$RT/$f.c" -o "$W/$f.o"; fi
+  O="$O $W/$f.o"
+done
+for i in 1 2 3 4 5 6 7 8; do
+  miss=$(nice -n 19 clang -O0 -std=gnu11 -w -fPIE -pthread -I"$RT" "$HERE/cursor_img.c" $O -o "$W/cursor_img" -lm 2>&1 | grep "undefined reference" | sed "s/.*undefined reference to .\(.*\)'/\1/" | sort -u || true)
+  [ -z "$miss" ] && break
+  for s in $miss; do
+    f=$(grep -l "^[a-z].* $s(" "$RT"/*.c 2>/dev/null | head -1 || true)
+    if [ -n "$f" ]; then n=$(basename "$f" .c); case " $WL " in *" $n "*) ;; *) WL="$WL $n"; nice -n 19 clang -O0 -std=gnu11 -w -fPIE -c -I"$RT" "$f" -o "$W/$n.o"; O="$O $W/$n.o";; esac; fi
+  done
+done
+set +e; "$W/cursor_img" ${3:-} ${4:-} ${5:-} > "$W/cursor_img.out" 2> "$W/cursor_img.err"; echo "rc=$?"
diff -ruN a/lift/harness/c0325/cursor_img.c b/lift/harness/c0325/cursor_img.c
--- a/lift/harness/c0325/cursor_img.c	1970-01-01 09:00:00.000000000 +0900
+++ b/lift/harness/c0325/cursor_img.c	2026-11-07 08:12:45.722680291 +0900
@@ -0,0 +1,322 @@
+/* Decision 0325 (ci1, native test): the picture and the hot spot of a cursor, as fle_av_cursor_image gives them to the browser (O18). Self-checking: every line is PASS or FAIL, the exit code is the number of FAILs.
+ *   I  cursors made by CreateIconIndirect: a colour cursor (mask bit 1 and black = transparent, mask bit 0 = the colour), a monochrome cursor (AND / XOR halves), an icon (hot spot in the centre), the number that is new
+ *      for a recreated cursor, the picture going away with DestroyCursor
+ *   M  cursors of a module's resources, read from a PE image built in memory at 0x400000 (FLE_EXE_HANDLE): a 1-bit cursor, a 32-bit cursor with alpha, a 24-bit cursor with an AND mask, by ordinal (LoadImageW) and by name
+ *      (LoadCursorW)
+ *   S  a standard cursor and handles without a picture give none */
+#define _GNU_SOURCE
+#include <stdio.h>
+#include <string.h>
+#include <stdint.h>
+#include <sys/mman.h>
+#include "fle_runtime.h"
+#include "fle_sse.h"
+#include "fle_dispatch.h"
+#include "fle_imports.h"
+#include "fle_env.h"
+#include "fle_callback.h"
+#include "fle_class.h"
+#include "fle_win.h"
+#include "fle_thread.h"
+#include "fle_cursor.h"
+#include "fle_loadimage.h"
+#include "fle_input.h"
+#include "fle_gdc.h"
+#include "fle_gdi.h"
+#include "fle_appview.h"
+#include "fle_api2.h"
+uint64_t R[16];
+fle_eflags FL;
+fle_xmm X[16];
+void fle_imp_CreateBitmap(void);
+void fle_imp_CreateCompatibleBitmap(void);
+void fle_imp_CreateCompatibleDC(void);
+void fle_imp_SelectObject(void);
+void fle_imp_SetPixel(void);
+void fle_imp_GetDC(void);
+void fle_imp_ReleaseDC(void);
+void fle_imp_DeleteObject(void);
+void fle_imp_DeleteDC(void);
+void fle_imp_CreateIconIndirect(void);
+void fle_imp_DestroyCursor(void);
+void fle_imp_DestroyIcon(void);
+void fle_imp_SetCursor(void);
+void fle_imp_LoadImageW(void);
+void fle_imp_LoadCursorW(void);
+const fle_fn_entry fle_dispatch_table[] = { { 0x2000, 0 } };
+const uint64_t fle_dispatch_count = 0;
+static uint64_t stk[0x4000] __attribute__((aligned(4096)));
+#define A(x) ((uint64_t)(uintptr_t)(x))
+#define API(name, ...) fle_api2_call(fle_imp_##name, __VA_ARGS__)
+static int fails;
+#define CHECK(cond, ...) do { if (cond) printf("PASS "); else { printf("FAIL "); fails++; } printf(__VA_ARGS__); printf("\n"); } while (0)
+
+static const fle_av_cursor_img *img_of(uint64_t h) { return fle_av_cursor_image((uint32_t)h); }
+static const uint8_t *px(const fle_av_cursor_img *im, int x, int y) { return (const uint8_t *)(uintptr_t)im->rgba + 4 * (y * (int)im->width + x); }
+static int is_px(const fle_av_cursor_img *im, int x, int y, int r, int g, int b, int a) { const uint8_t *p = px(im, x, y); return p[0] == r && p[1] == g && p[2] == b && p[3] == a; }
+
+static uint64_t make_mask(int w, int h, const uint8_t *rows /* h rows of ceil(w/16)*2 bytes */) { return API(CreateBitmap, (uint32_t)w, (uint32_t)h, 1, 1, A(rows), 0, 0, 0); }
+static uint64_t make_color(int w, int h, const uint32_t *cref)
+{
+    uint64_t scr = API(GetDC, 0, 0, 0, 0, 0, 0, 0, 0), dc = API(CreateCompatibleDC, scr, 0, 0, 0, 0, 0, 0, 0), b = API(CreateCompatibleBitmap, scr, (uint32_t)w, (uint32_t)h, 0, 0, 0, 0, 0), old;
+    int x, y;
+    old = API(SelectObject, dc, b, 0, 0, 0, 0, 0, 0);
+    for (y = 0; y < h; y++) for (x = 0; x < w; x++) (void)API(SetPixel, dc, (uint32_t)x, (uint32_t)y, cref[y * w + x], 0, 0, 0, 0);
+    (void)API(SelectObject, dc, old, 0, 0, 0, 0, 0, 0);
+    (void)API(DeleteDC, dc, 0, 0, 0, 0, 0, 0, 0);
+    (void)API(ReleaseDC, 0, scr, 0, 0, 0, 0, 0, 0);
+    return b;
+}
+static uint64_t icon_indirect(int ficon, int hx, int hy, uint64_t mask, uint64_t color)
+{
+    uint8_t ii[32];
+    uint32_t f = (uint32_t)ficon, x = (uint32_t)hx, y = (uint32_t)hy;
+    memset(ii, 0, sizeof ii);
+    memcpy(ii, &f, 4); memcpy(ii + 4, &x, 4); memcpy(ii + 8, &y, 4); memcpy(ii + 16, &mask, 8); memcpy(ii + 24, &color, 8);
+    return API(CreateIconIndirect, A(ii), 0, 0, 0, 0, 0, 0, 0);
+}
+
+static void sc_I(void)
+{
+    /* I1: a colour cursor, 4 x 4, hot spot (1, 2). Mask rows (4 pixels per row, bit 7 = x 0, 1 = bit set): y0: 0110, y1: 0000, y2: 1111, y3: 1001. Colours (COLORREF 0x00BBGGRR): y0: x0 red, x1 any, x2 any, x3 blue;
+     * y1: all green; y2: x0 black (transparent), x1 non-black (shown), x2 black, x3 black; y3: x0 black, x1 white, x2 white, x3 black. */
+    const uint8_t mk[8] = { 0x60, 0, 0x00, 0, 0xF0, 0, 0x90, 0 };
+    uint32_t col[16] = { 0x000000FF, 0x00112233, 0x00112233, 0x00FF0000,
+                         0x0000FF00, 0x0000FF00, 0x0000FF00, 0x0000FF00,
+                         0x00000000, 0x00123456, 0x00000000, 0x00000000,
+                         0x00000000, 0x00FFFFFF, 0x00FFFFFF, 0x00000000 };
+    uint64_t m = make_mask(4, 4, mk), c = make_color(4, 4, col), h1, h2, h3;
+    const fle_av_cursor_img *im;
+    uint32_t s1;
+
+    h1 = icon_indirect(0, 1, 2, m, c);
+    (void)API(SetCursor, h1, 0, 0, 0, 0, 0, 0, 0);
+    im = img_of(h1);
+    CHECK(im != NULL && im->magic == FLE_AV_CURSOR_MAGIC && im->width == 4 && im->height == 4, "I1 a colour cursor has a 4 x 4 picture");
+    if (im) {
+        CHECK(im->hot_x == 1 && im->hot_y == 2, "I1 hot spot (1, 2): %u, %u", im->hot_x, im->hot_y);
+        CHECK(is_px(im, 0, 0, 255, 0, 0, 255), "I1 (0,0) mask 0 shows the colour red");
+        CHECK(is_px(im, 1, 0, 0x33, 0x22, 0x11, 255), "I1 (1,0) mask 1 and a colour that is not black shows the colour (S-cursor-xor)");
+        CHECK(is_px(im, 3, 0, 0, 0, 255, 255), "I1 (3,0) mask 0 shows blue");
+        CHECK(is_px(im, 0, 1, 0, 255, 0, 255), "I1 (0,1) mask 0 shows green");
+        CHECK(px(im, 0, 2)[3] == 0, "I1 (0,2) mask 1 and black is transparent");
+        CHECK(is_px(im, 1, 2, 0x56, 0x34, 0x12, 255), "I1 (1,2) mask 1 and a colour that is not black shows the colour (S-cursor-xor)");
+        CHECK(px(im, 3, 3)[3] == 0 && is_px(im, 1, 3, 255, 255, 255, 255), "I1 (3,3) mask 1 and black is transparent; (1,3) mask 0 and white shows white");
+    }
+    s1 = im ? im->serial : 0;
+    CHECK(s1 != 0, "I1 the picture has a serial (%u)", s1);
+    /* I2: a monochrome cursor 8 x 4: the mask bitmap is 8 x 8: the top 4 rows AND, the bottom 4 rows XOR. */
+    {
+        /* AND rows: y0 0111 1111 (x0 AND 0), y1 0x00 (all AND 0), y2 0xFF (all AND 1), y3 0xFF.  XOR rows: y0 1000 0000 (x0 white), y1 0x0F (x4..7 white), y2 0x80 (x0 XOR 1 with AND 1: invert), y3 0x00 */
+        const uint8_t mono[16] = { 0x7F, 0, 0x00, 0, 0xFF, 0, 0xFF, 0, 0x80, 0, 0x0F, 0, 0x80, 0, 0x00, 0 };
+        uint64_t mm = make_mask(8, 8, mono);
+
+        h2 = icon_indirect(0, 7, 3, mm, 0);
+        im = img_of(h2);
+        CHECK(im != NULL && im->width == 8 && im->height == 4 && im->hot_x == 7 && im->hot_y == 3, "I2 a monochrome cursor is 8 x 4 (the mask is twice the height), hot spot (7, 3)");
+        if (im) {
+            CHECK(is_px(im, 0, 0, 255, 255, 255, 255), "I2 AND 0 XOR 1: white");
+            CHECK(px(im, 1, 0)[3] == 0, "I2 (1,0) AND 1 XOR 0: transparent");
+            CHECK(is_px(im, 0, 1, 0, 0, 0, 255), "I2 (0,1) AND 0 XOR 0: black");
+            CHECK(is_px(im, 4, 1, 255, 255, 255, 255), "I2 (4,1) AND 0 XOR 1: white");
+            CHECK(px(im, 3, 2)[3] == 0, "I2 (3,2) AND 1 XOR 0: transparent");
+            CHECK(is_px(im, 0, 2, 255, 255, 255, 255), "I2 (0,2) AND 1 XOR 1 (invert): white (S-cursor-xor)");
+        }
+    }
+    /* I3: an icon (fIcon TRUE): the hot spot is the centre */
+    h3 = icon_indirect(1, 0, 0, m, c);
+    im = img_of(h3);
+    CHECK(im != NULL && im->hot_x == 2 && im->hot_y == 2, "I3 an icon has its hot spot in the centre (2, 2)");
+    /* I4: destroy and recreate: the picture goes, a new object has a new serial */
+    (void)API(SetCursor, 0, 0, 0, 0, 0, 0, 0, 0);
+    (void)API(DestroyCursor, h1, 0, 0, 0, 0, 0, 0, 0);
+    CHECK(img_of(h1) == NULL, "I4 a destroyed cursor has no picture");
+    {
+        uint64_t h4 = icon_indirect(0, 0, 0, m, c);
+        const fle_av_cursor_img *i4 = img_of(h4);
+
+        CHECK(i4 != NULL && i4->serial != s1, "I4 a new cursor has a new serial (%u, was %u)", i4 ? i4->serial : 0, s1);
+    }
+}
+
+/* ---- a PE image in memory with resources (Learn "PE Format", "The .rsrc Section") ---- */
+static uint8_t *pe;
+static void w16(uint32_t off, uint32_t v) { pe[off] = (uint8_t)v; pe[off + 1] = (uint8_t)(v >> 8); }
+static void w32(uint32_t off, uint32_t v) { w16(off, v & 0xFFFF); w16(off + 2, v >> 16); }
+static void dir(uint32_t at, uint32_t named, uint32_t ids) { w32(at, 0); w32(at + 4, 0); w16(at + 8, 0); w16(at + 10, 0); w16(at + 12, named); w16(at + 14, ids); }
+static void ent(uint32_t at, uint32_t name, uint32_t target) { w32(at, name); w32(at + 4, target); }
+#define RS 0x1000u
+static void data_entry(uint32_t at, uint32_t rva, uint32_t size) { w32(at, rva); w32(at + 4, size); w32(at + 8, 0); w32(at + 12, 0); }
+static uint32_t put_blob(uint32_t at, const uint8_t *b, uint32_t n) { memcpy(pe + at, b, n); return at; }
+
+static void build_pe(void)
+{
+    uint8_t blob[256];
+    uint32_t p = 0x1800;      /* the data blobs start here (RVA = offset: the image is flat) */
+    uint32_t rva_c1, rva_c2, rva_c3, rva_ga = 0, rva_gb = 0, rva_gc = 0;
+    uint32_t i;
+
+    pe = (uint8_t *)mmap((void *)0x400000, 0x10000, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE, -1, 0);
+    if (pe != (uint8_t *)0x400000) { printf("FAIL cannot map the image at 0x400000\n"); fails++; return; }
+    memset(pe, 0, 0x10000);
+    pe[0] = 'M'; pe[1] = 'Z'; w32(0x3c, 0x80);
+    memcpy(pe + 0x80, "PE\0\0", 4);
+    w16(0x98, 0x20b);
+    memcpy(pe + 0xB0, &(uint64_t){ 0x400000 }, 8);
+    w32(0xD0, 0x10000);
+    w32(0x104, 16);
+    w32(0x118, RS); w32(0x11C, 0x800);
+    /* the resource tree (offsets inside the directory) */
+    dir(RS + 0x000, 0, 2); ent(RS + 0x010, 1, 0x80000000u | 0x030); ent(RS + 0x018, 12, 0x80000000u | 0x0A0);
+    dir(RS + 0x030, 0, 3); ent(RS + 0x040, 1, 0x80000000u | 0x058); ent(RS + 0x048, 2, 0x80000000u | 0x070); ent(RS + 0x050, 3, 0x80000000u | 0x088);
+    dir(RS + 0x058, 0, 1); ent(RS + 0x068, 0x409, 0x120);
+    dir(RS + 0x070, 0, 1); ent(RS + 0x080, 0x409, 0x130);
+    dir(RS + 0x088, 0, 1); ent(RS + 0x098, 0x409, 0x140);
+    dir(RS + 0x0A0, 1, 2); ent(RS + 0x0B0, 0x80000000u | 0x110, 0x80000000u | 0x0C8); ent(RS + 0x0B8, 32762, 0x80000000u | 0x0E0); ent(RS + 0x0C0, 32763, 0x80000000u | 0x0F8);
+    dir(RS + 0x0C8, 0, 1); ent(RS + 0x0D8, 0x409, 0x150);
+    dir(RS + 0x0E0, 0, 1); ent(RS + 0x0F0, 0x409, 0x160);
+    dir(RS + 0x0F8, 0, 1); ent(RS + 0x108, 0x409, 0x170);
+    w16(RS + 0x110, 5); { const char *nm = "MYCUR"; for (i = 0; i < 5; i++) w16(RS + 0x112 + 2 * i, (uint32_t)nm[i]); }
+    /* cursor 1: 1 bit, 8 x 8, hot spot (1, 2). XOR (bottom-up rows, 4 bytes each, palette black white), then AND. Row y of the picture: y0: XOR 10000000 AND 01111111; y1: XOR 0 AND 0 (black); the others: AND 0xFF XOR 0 (transparent) */
+    memset(blob, 0, sizeof blob);
+    { uint8_t *b = blob; b[0] = 1; b[1] = 0; b[2] = 2; b[3] = 0;
+      b[4] = 40; b[8] = 8; b[12] = 16; b[16] = 1; b[18] = 1; b[20] = 0;
+      /* palette at 44: black, white */ b[44 + 4] = 255; b[44 + 5] = 255; b[44 + 6] = 255;
+      /* XOR at 52, bottom-up: image row y is stored at index 7 - y */
+      b[52 + 4 * 7] = 0x80;                                        /* y0 */
+      /* AND at 52 + 32 = 84 */
+      for (i = 0; i < 8; i++) b[84 + 4 * (7 - i)] = 0xFF;
+      b[84 + 4 * 7] = 0x7F;                                        /* y0: x0 AND 0 */
+      b[84 + 4 * 6] = 0x00;                                        /* y1: all AND 0, XOR 0: black */
+    }
+    rva_c1 = put_blob(p, blob, 116); p += 128;
+    /* cursor 2: 32 bit, 4 x 4, hot spot (0, 3), alpha: (0,0) = B 0x10 G 0x20 R 0x30 A 0x80, the rest alpha 0; the AND mask is all 1 (not used) */
+    memset(blob, 0, sizeof blob);
+    { uint8_t *b = blob; b[0] = 0; b[1] = 0; b[2] = 3; b[3] = 0;
+      b[4] = 40; b[8] = 4; b[12] = 8; b[16] = 1; b[18] = 32;
+      b[44 + 4 * 4 * 3 + 0] = 0x10; b[44 + 4 * 4 * 3 + 1] = 0x20; b[44 + 4 * 4 * 3 + 2] = 0x30; b[44 + 4 * 4 * 3 + 3] = 0x80;   /* row y0 is stored last */
+      for (i = 0; i < 16; i++) b[44 + 64 + i] = 0xFF; }
+    rva_c2 = put_blob(p, blob, 44 + 64 + 16); p += 160;
+    /* cursor 3: 24 bit, 4 x 4, hot spot (3, 3): (0,0) R1 G2 B3 AND 0 (opaque); (1,0) black AND 1 (transparent); (2,0) R9 G9 B9 AND 1 (shown); the stride is 12 */
+    memset(blob, 0, sizeof blob);
+    { uint8_t *b = blob; b[0] = 3; b[1] = 0; b[2] = 3; b[3] = 0;
+      b[4] = 40; b[8] = 4; b[12] = 8; b[16] = 1; b[18] = 24;
+      uint32_t x0 = 44 + 12 * 3;                                  /* row y0 */
+      b[x0 + 0] = 3; b[x0 + 1] = 2; b[x0 + 2] = 1;                /* B G R */
+      b[x0 + 6] = 9; b[x0 + 7] = 9; b[x0 + 8] = 9;
+      for (i = 0; i < 4; i++) b[44 + 48 + 4 * i] = 0xFF;          /* AND: all 1 ... */
+      b[44 + 48 + 4 * 3] = 0x3F; }                                /* ... except y0: x0 AND 0, x1 AND 0 (black but opaque), x2 AND 1, x3 AND 1 */
+    rva_c3 = put_blob(p, blob, 44 + 48 + 16); p += 160;
+    /* the groups: NEWHEADER (0, 2, 1) and one RESDIR (14 bytes) each; the width and height of the entry are the picture's */
+    for (i = 0; i < 3; i++) {
+        uint8_t g[20];
+        uint32_t id = i + 1, w = i == 0 ? 8 : 4, hh = i == 0 ? 16 : 8, bpp = i == 0 ? 1 : i == 1 ? 32 : 24, sz = i == 0 ? 116 : i == 1 ? 124 : 108;
+
+        memset(g, 0, sizeof g);
+        g[2] = 2; g[4] = 1; g[6] = (uint8_t)w; g[8] = (uint8_t)hh; g[10] = 1; g[12] = (uint8_t)bpp; g[14] = (uint8_t)sz; g[18] = (uint8_t)id;
+        if (i == 0) rva_ga = put_blob(p, g, 20);
+        else if (i == 1) rva_gb = put_blob(p, g, 20);
+        else rva_gc = put_blob(p, g, 20);
+        p += 32;
+    }
+    data_entry(RS + 0x120, rva_c1, 116); data_entry(RS + 0x130, rva_c2, 124); data_entry(RS + 0x140, rva_c3, 108);
+    data_entry(RS + 0x150, rva_ga, 20); data_entry(RS + 0x160, rva_gb, 20); data_entry(RS + 0x170, rva_gc, 20);
+}
+
+static void sc_M(void)
+{
+    uint16_t myname[] = { 'M', 'Y', 'C', 'U', 'R', 0 };
+    uint64_t h;
+    const fle_av_cursor_img *im;
+
+    build_pe();
+    if (!pe) return;
+    h = API(LoadImageW, 0x400000, 32762, 2, 32, 32, 0x8000, 0, 0);
+    CHECK(h != 0, "M0 LoadImageW(32762) gives a handle (0x%llx)", (unsigned long long)h);
+    im = img_of(h);
+    CHECK(im != NULL && im->width == 4 && im->height == 4 && im->hot_x == 0 && im->hot_y == 3, "M1 the 32-bit cursor (ordinal 32762) is 4 x 4 with hot spot (0, 3)");
+    if (im) {
+        CHECK(is_px(im, 0, 0, 0x30, 0x20, 0x10, 0x80), "M1 (0,0) has the colour and the alpha of the pixel (R 30 G 20 B 10 A 80)");
+        CHECK(px(im, 1, 0)[3] == 0 && px(im, 0, 1)[3] == 0, "M1 the other pixels have alpha 0 (the AND mask is not used when there is alpha)");
+    }
+    h = API(LoadImageW, 0x400000, 32763, 2, 32, 32, 0x8000, 0, 0);
+    im = img_of(h);
+    CHECK(im != NULL && im->width == 4 && im->height == 4 && im->hot_x == 3 && im->hot_y == 3, "M2 the 24-bit cursor (ordinal 32763) is 4 x 4 with hot spot (3, 3)");
+    if (im) {
+        CHECK(is_px(im, 0, 0, 1, 2, 3, 255), "M2 (0,0) R1 G2 B3 AND 0: opaque");
+        CHECK(is_px(im, 1, 0, 0, 0, 0, 255), "M2 (1,0) black with AND 0: opaque black");
+        CHECK(is_px(im, 2, 0, 9, 9, 9, 255), "M2 (2,0) colour with AND 1: shown (S-cursor-xor)");
+        CHECK(px(im, 3, 0)[3] == 0, "M2 (3,0) black with AND 1: transparent");
+    }
+    h = API(LoadCursorW, 0x400000, A(myname), 0, 0, 0, 0, 0, 0);
+    CHECK(h != 0, "M3 LoadCursorW(L\"MYCUR\") gives a handle (0x%llx)", (unsigned long long)h);
+    im = img_of(h);
+    CHECK(im != NULL && im->width == 8 && im->height == 8 && im->hot_x == 1 && im->hot_y == 2, "M3 the named 1-bit cursor is 8 x 8 with hot spot (1, 2)");
+    if (im) {
+        CHECK(is_px(im, 0, 0, 255, 255, 255, 255), "M3 (0,0) XOR 1 AND 0: white");
+        CHECK(is_px(im, 0, 1, 0, 0, 0, 255), "M3 (0,1) XOR 0 AND 0: black");
