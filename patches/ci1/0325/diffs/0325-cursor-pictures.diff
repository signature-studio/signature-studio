+    CHECK(img_of(0) == NULL, "S2 NULL has no picture");
+    CHECK(img_of(0x12345678) == NULL, "S3 a number that is no handle has no picture");
+    CHECK(img_of(0x7FDA0000 + 4 * 5) == NULL, "S4 a module-cursor handle of a group the image does not have has no picture");
