+// Decision 0325 (O18): the picture of the guest's own cursors reaches the browser. The layout is the one of lift/runtime/fle_appview.h (read from the file), the store makes the CSS value, the cursor of the page uses it.
+import fs from 'node:fs';
+import path from 'node:path';
+import { describe, expect, it } from 'vitest';
+import { CURSOR_IMG_BYTES, CURSOR_MAGIC, readAppView, readCursorImage } from '../../src/engine/appview.ts';
+import { osStateKey, osStateOf } from '../../src/engine/os-state.ts';
+import { cursorCss, CursorPictureStore, scale2x, type CursorPictureHost } from '../../src/ui/cursor.ts';
+
+const REPO = process.env.APP_REPO_ROOT || path.resolve(__dirname, '../../..');
+const rt = (f: string): string => fs.readFileSync(path.join(REPO, 'lift/runtime', f), 'utf8');
+
+describe('the picture structure is the one of lift/runtime/fle_appview.h', () => {
+  const h = rt('fle_appview.h'), c = rt('fle_appview.c');
+  it('magic, size and the fields in the order the reader assumes', () => {
+    expect(Number(/#define FLE_AV_CURSOR_MAGIC (0x[0-9a-fA-F]+)u/.exec(h)?.[1])).toBe(CURSOR_MAGIC);
+    const st = /typedef struct \{([^}]*)\} fle_av_cursor_img;/.exec(h)?.[1] ?? '';
+    expect(st.replace(/\/\*.*?\*\//g, '').replace(/\s+/g, ' ')).toContain('uint32_t magic, serial, width, height, hot_x, hot_y; uint64_t rgba;');
+    expect(c).toContain(`sizeof(fle_av_cursor_img) == ${CURSOR_IMG_BYTES} && offsetof(fle_av_cursor_img, rgba) == 24`);
+    expect(c).toContain('offsetof(fle_av_state, cursor_serial) == 56');
+  });
+});
+
+function picture(opts: { w: number; h: number; hx: number; hy: number; serial?: number; px?: (x: number, y: number) => [number, number, number, number]; at?: number; magic?: number }): { buf: ArrayBuffer; ptr: number } {
+  const at = opts.at ?? 256, ptr = 64;
+  const buf = new ArrayBuffer(at + opts.w * opts.h * 4 + 16);
+  const dv = new DataView(buf), u8 = new Uint8Array(buf);
+  dv.setUint32(ptr, opts.magic ?? CURSOR_MAGIC, true); dv.setUint32(ptr + 4, opts.serial ?? 7, true);
+  dv.setUint32(ptr + 8, opts.w, true); dv.setUint32(ptr + 12, opts.h, true); dv.setUint32(ptr + 16, opts.hx, true); dv.setUint32(ptr + 20, opts.hy, true); dv.setUint32(ptr + 24, at, true);
+  for (let y = 0; y < opts.h; y++) for (let x = 0; x < opts.w; x++) u8.set(opts.px ? opts.px(x, y) : [x, y, 3, 255], at + (y * opts.w + x) * 4);
+  return { buf, ptr };
+}
+
+describe('readCursorImage', () => {
+  it('reads the size, the hot spot, the serial and COPIES the pixels', () => {
+    const { buf, ptr } = picture({ w: 4, h: 3, hx: 1, hy: 2 });
+    const im = readCursorImage(buf, ptr);
+    expect(im).toMatchObject({ serial: 7, width: 4, height: 3, hotX: 1, hotY: 2 });
+    expect(Array.from((im?.rgba ?? new Uint8ClampedArray()).subarray(0, 8))).toEqual([0, 0, 3, 255, 1, 0, 3, 255]);
+    new Uint8Array(buf)[256] = 99;      // the engine reuses its buffer: the copy keeps what it was
+    expect(im?.rgba[0]).toBe(0);
+  });
+  it('the hot spot is pulled inside the picture', () => {
+    expect(readCursorImage(...Object.values(picture({ w: 2, h: 2, hx: 9, hy: 9 })) as [ArrayBuffer, number])).toMatchObject({ hotX: 1, hotY: 1 });
+  });
+  it('null for no picture (pointer 0), a wrong magic, a size outside 1..128, a pixel address outside the memory', () => {
+    expect(readCursorImage(new ArrayBuffer(1024), 0)).toBeNull();
+    const bad = picture({ w: 2, h: 2, hx: 0, hy: 0, magic: 5 });
+    expect(readCursorImage(bad.buf, bad.ptr)).toBeNull();
+    const big = picture({ w: 129, h: 1, hx: 0, hy: 0 });
+    expect(readCursorImage(big.buf, big.ptr)).toBeNull();
+    const ok = picture({ w: 128, h: 128, hx: 0, hy: 0 });
+    expect(readCursorImage(ok.buf, ok.ptr)).toMatchObject({ width: 128, height: 128 });
+    const away = picture({ w: 2, h: 2, hx: 0, hy: 0 });
+    new DataView(away.buf).setUint32(away.ptr + 24, away.buf.byteLength - 8, true);      // the 16 pixel bytes would run past the end of the memory
+    expect(readCursorImage(away.buf, away.ptr)).toBeNull();
+  });
+});
+
+describe('scale2x', () => {
+  it('repeats every pixel into a 2 x 2 block', () => {
+    const src = new Uint8ClampedArray([1, 2, 3, 4, 5, 6, 7, 8]);      // two pixels, 2 x 1
+    const out = scale2x(src, 2, 1);
+    expect(out.length).toBe(4 * 2 * 4);
+    expect(Array.from(out.subarray(0, 16))).toEqual([1, 2, 3, 4, 1, 2, 3, 4, 5, 6, 7, 8, 5, 6, 7, 8]);
+    expect(Array.from(out.subarray(16, 32))).toEqual(Array.from(out.subarray(0, 16)));
+  });
+});
+
+const host = (imageSet: boolean): CursorPictureHost & { calls: [number, number][] } => {
+  const calls: [number, number][] = [];
+  return { calls, encode: (_rgba, w, h) => { calls.push([w, h]); return `data:${w}x${h}`; }, imageSet: () => imageSet };
+};
+type Msg = { handle: number; serial: number; width: number; height: number; hotX: number; hotY: number; rgba: ArrayBuffer };
+const msg = (o: Partial<Msg> = {}): Msg => ({ handle: 0x7fda0004, serial: 1, width: 32, height: 32, hotX: 4, hotY: 5, rgba: new ArrayBuffer(32 * 32 * 4), ...o });
+
+describe('CursorPictureStore', () => {
+  it('a picture becomes a url() cursor with its hot spot and the arrow as fallback; without image-set it is the 1x picture only', () => {
+    const h = host(false), s = new CursorPictureStore(h);
+    expect(s.add(msg())).toBe('url("data:32x32") 4 5, default');
+    expect(h.calls).toEqual([[32, 32]]);
+    expect(s.css(0x7fda0004, 1)).toBe('url("data:32x32") 4 5, default');
+  });
+  it('with image-set the 2x picture is made too (when it fits 128 x 128), and a larger picture stays 1x', () => {
+    const s = new CursorPictureStore(host(true));
+    expect(s.add(msg())).toBe('image-set(url("data:32x32") 1x, url("data:64x64") 2x) 4 5, default');
+    expect(s.add(msg({ handle: 9, width: 100, height: 100, rgba: new ArrayBuffer(100 * 100 * 4) }))).toBe('url("data:100x100") 4 5, default');
+  });
+  it('the hot spot is pulled inside; a size outside 1..128 or a pixel array of the wrong length is refused', () => {
+    const s = new CursorPictureStore(host(false));
+    expect(s.add(msg({ hotX: 99, hotY: 99 }))).toBe('url("data:32x32") 31 31, default');
+    expect(s.add(msg({ width: 129 }))).toBeNull();
+    expect(s.add(msg({ width: 0 }))).toBeNull();
+    expect(s.add({ ...msg(), rgba: new ArrayBuffer(10) })).toBeNull();
+  });
+  it('a handle with another serial is another cursor (the engine reuses handles)', () => {
+    const s = new CursorPictureStore(host(false));
+    s.add(msg({ serial: 1 }));
+    expect(s.css(0x7fda0004, 2)).toBeNull();
+    s.add(msg({ serial: 2, width: 16, height: 16, rgba: new ArrayBuffer(16 * 16 * 4) }));
+    expect(s.css(0x7fda0004, 2)).toBe('url("data:16x16") 4 5, default');
+    expect(s.css(0x7fda0004, 1)).toBe('url("data:32x32") 4 5, default');
+  });
+});
+
+describe('the cursor of the page', () => {
+  const store = new CursorPictureStore(host(false));
+  store.add(msg({ handle: 0x7fba0100, serial: 3, width: 16, height: 16, hotX: 0, hotY: 0, rgba: new ArrayBuffer(16 * 16 * 4) }));
+  store.add(msg());
+  it('a module cursor and a cursor the guest made use their picture', () => {
+    expect(cursorCss({ cursor: 0x7fda0004, cursorIdc: 0, cursorShared: true, cursorSerial: 1 }, store)).toMatchObject({ css: 'url("data:32x32") 4 5, default' });
+    expect(cursorCss({ cursor: 0x7fba0100, cursorIdc: 0, cursorShared: false, cursorSerial: 3 }, store).css).toBe('url("data:16x16") 0 0, default');
+  });
+  it('without the picture (not arrived, or the engine has none) the arrow, and the reason says so', () => {
+    const c = cursorCss({ cursor: 0x7fba0100, cursorIdc: 0, cursorShared: false, cursorSerial: 99 }, store);
+    expect(c.css).toBe('default');
+    expect(c.why).toContain('picture');
+    expect(cursorCss({ cursor: 0x7fda0004, cursorIdc: 0, cursorShared: true }, store).css).toBe('default');
+  });
+  it('a standard cursor keeps its CSS cursor; NULL keeps none: no picture is looked up', () => {
+    expect(cursorCss({ cursor: 0x7fca0004, cursorIdc: 32644, cursorShared: false, cursorSerial: 0 }, store).css).toBe('ew-resize');
+    expect(cursorCss({ cursor: 0, cursorIdc: 0, cursorShared: false, cursorSerial: 0 }, store).css).toBe('none');
+  });
+});
+
+describe('the serial is part of the state the Worker reports', () => {
+  it('another serial for the same handle changes the key, so the page hears of the new picture', () => {
+    const v = (serial: number) => osStateOf({ seq: 1, cursor: 0x7fba0100, cursorIdc: 0, cursorShared: false, cursorSerial: serial, pointerX: 0, pointerY: 0, pendingEvents: 0, windows: [] }, '');
+    expect(osStateKey(v(1))).not.toBe(osStateKey(v(2)));
+    expect(osStateKey(v(1))).toBe(osStateKey(v(1)));
+  });
+  it('readAppView returns cursorSerial from offset 56', () => {
+    const dv = new DataView(new ArrayBuffer(68 + 144 * 32));
+    dv.setUint32(0, 0x50414c46, true); dv.setUint32(4, 1, true); dv.setUint32(8, 144, true); dv.setUint32(12, 32, true); dv.setUint32(56, 42, true);
