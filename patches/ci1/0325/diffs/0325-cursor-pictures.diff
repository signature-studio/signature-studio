+    if (!only || only == 'M') sc_M();
+    if (!only || only == 'S') sc_S();
+    if (only == 'R' && argc > 3) sc_R(argv[2], argv[3]);
+    printf("%s: %d FAIL\n", fails ? "RESULT FAIL" : "RESULT OK", fails);
+    return fails;
