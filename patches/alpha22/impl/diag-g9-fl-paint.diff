+/* Decision 0319 TEST-ONLY diagnostic (FLE_DIAG_WIN=1; FLE_TEST_GETENV is a null constant in the product, so this is dead code there): O9 'the picture breaks / a window that never appears'. Per window (lid), on stderr as
+ * "fl-diag: vis|show|paint-msg|BeginPaint|EndPaint|draw-discard lid ...": every change of is_visible() (found by a scan after CreateWindowExW, ShowWindow, SetWindowPos, SetWindowLongPtr(GWL_STYLE), ShowOwnedPopups: the
+ * route that caused it is named), every ShowWindow call, every WM_PAINT the retrieval calls make, every BeginPaint / EndPaint, and every drawing call that was discarded because the window is not visible (S-draw-hidden;
+ * the first window of the chain that lacks WS_VISIBLE is named). Each kind prints the first 3 events of a window and then every power of two (the counters are exact); 8000 lines at most. Observation only. */
+enum { DPT_SHOW, DPT_PAINT, DPT_BEGIN, DPT_END, DPT_DISCARD, DPT_KINDS };
+static int diag_pt_on(void)
+{
+    static int on = -1;
+
+    if (on < 0) { const char *e = FLE_TEST_GETENV("FLE_DIAG_WIN"); on = e != NULL && e[0] == '1'; }
+    return on;
+}
+
+static uint32_t diag_pt_count(int kind, int64_t i, int *print)
+{
+    static uint32_t *cnt[DPT_KINDS];
+    static uint64_t cap;
+    static unsigned lines;
+
+    if (cap <= (uint64_t)i) {
+        uint64_t nc = (uint64_t)i + 256u;
+        int k;
+
+        for (k = 0; k < DPT_KINDS; k++) {
+            uint32_t *g = (uint32_t *)calloc((size_t)nc, sizeof *g);
+
+            if (!g) { *print = 0; return 0; }
+            if (cnt[k]) { memcpy(g, cnt[k], (size_t)cap * sizeof *g); free(cnt[k]); }
+            cnt[k] = g;
+        }
+        cap = nc;
+    }
+    {
+        uint32_t n = ++cnt[kind][i];
+
+        *print = (n <= 3u || (n & (n - 1u)) == 0) && lines < 8000u;
+        if (*print) lines++;
+        return n;
+    }
+}
+
+static int64_t diag_first_hidden(int64_t i)
+{
+    int64_t a = i;
+    int d = 0;
+
+    for (; a >= 0 && d < 64; d++) {
+        if (!(tab[a].style & FLE_WS_VISIBLE)) return (int64_t)tab[a].lid;
+        a = tab[a].parent >= 0 ? tab[a].parent : -1;
+    }
+    return -1;
+}
+
+static void diag_pt_class(int64_t i, char *cls, size_t n)
+{
+    uint16_t nm[FLE_CLASS_NAME_MAX_UNITS + 1], nl = 0;
+
+    cls[0] = 0;
+    if (fle_class_name_of(tab[i].atom, nm, &nl)) u16_ascii(cls, n, nm, nl < n - 1 ? nl : (uint16_t)(n - 1));
+}
+
+static void diag_vis_scan(const char *what)
+{
+    static uint8_t *seen;
+    static uint64_t cap;
+    uint64_t k;
+
+    if (!diag_pt_on()) return;
+    if (cap < tab_n) {
+        uint8_t *g = (uint8_t *)calloc((size_t)tab_n + 256u, 1);
+
+        if (!g) return;
+        if (seen) { memcpy(g, seen, (size_t)cap); free(seen); }
+        seen = g;
+        cap = tab_n + 256u;
+    }
+    for (k = 0; k < tab_n; k++) {
+        int v = tab[k].live && is_visible((int64_t)k) ? 1 : 0;
+        char cls[60];
+
+        if (v == seen[k]) continue;
+        seen[k] = (uint8_t)v;
+        diag_pt_class((int64_t)k, cls, sizeof cls);
+        fprintf(stderr, "fl-diag: vis lid %u class \"%s\" %d->%d by %s own-bit %d first-hidden-lid %d rect (%d,%d,%dx%d) style %#x parent_lid %d\n", (unsigned)tab[k].lid, cls, !v, v, what,
+                (tab[k].style & FLE_WS_VISIBLE) != 0, (int)diag_first_hidden((int64_t)k), (int)tab[k].px, (int)tab[k].py, (int)tab[k].pcx, (int)tab[k].pcy, (unsigned)tab[k].style,
+                tab[k].parent >= 0 ? (int)tab[tab[k].parent].lid : -1);
+    }
+}
+
+static void diag_pt_event(int kind, int64_t i, const char *what, const char *extra)
+{
+    static const char *const nm[DPT_KINDS] = { "show", "paint-msg", "BeginPaint", "EndPaint", "draw-discard" };
+    int print;
+    uint32_t n;
+    char cls[60];
+
+    if (!diag_pt_on() || i < 0) return;
+    n = diag_pt_count(kind, i, &print);
+    if (!print) return;
+    diag_pt_class(i, cls, sizeof cls);
+    fprintf(stderr, "fl-diag: %s lid %u class \"%s\" n %u visible %d own-bit %d first-hidden-lid %d %s%s%s\n", nm[kind], (unsigned)tab[i].lid, cls, (unsigned)n, is_visible(i) ? 1 : 0,
+            (tab[i].style & FLE_WS_VISIBLE) != 0, (int)diag_first_hidden(i), what ? what : "", what && extra ? " " : "", extra ? extra : "");
+}
+
+void fle_win_diag_discard(uint64_t hwnd, const char *api);
+void fle_win_diag_discard(uint64_t hwnd, const char *api)
+{
+    if (!diag_pt_on()) return;
+    diag_pt_event(DPT_DISCARD, live_index(hwnd), api, NULL);
+}
