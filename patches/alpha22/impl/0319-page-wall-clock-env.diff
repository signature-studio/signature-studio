+// Decision 0319 (PROVISIONAL, PM 07:2x; O8 'Starting at 12:00:00 AM', 'Temporary folder C:\Windows\...'): the wall-clock time, the time zone and the initial environment block of the guest are RUN VALUES the page puts into the
+// engine's environment (the manifest's engine.env, which the Worker hands to the engine), like the refresh rate (hz.ts, decision 0182) and the screen size (ui/screen-fit.ts, decision 0212):
+//     FLE_WALL_FILETIME=<decimal FILETIME, 100 ns since 1601-01-01 UTC>   the UTC instant at which the engine starts (the page reads the host clock ONCE; the engine's virtual clock runs from it)
+//     FLE_TZ_BIAS_MIN=<decimal minutes>                                    the Windows bias (UTC = local + bias; Japan standard time is -540); JavaScript's getTimezoneOffset() has the same sign
+//     FLE_ENV_DEFAULTS=1                                                   the guest's environment block starts with TEMP, TMP, USERPROFILE, APPDATA, LOCALAPPDATA, windir ... (runtime/fle_env.c)
+// The runtime side is lift/runtime/fle_time.c and fle_env.c (impl 0319-time-env-run-values.diff). Without these values the engine keeps its fixed origin (2021-01-01 00:00 UTC) and an empty environment: every test and the Export
+// harness (which does not use this page) are unchanged. DETERMINISM: a value that the manifest already carries (a pinned run, a test) is never overwritten, and the URL parameter `fle_wall=off` (or `fle_wall=<unix ms>`)
+// leaves the origin fixed (or pins it) for a reproducible run of the product page. daylight saving time and Windows time-zone names are not modelled (the bias is the one at start).
+// Everything here is pure: the clock is passed in (test/unit/wall-clock.test.ts).
+
+/** FILETIME of 1970-01-01T00:00:00Z (100 ns since 1601-01-01) */
+export const FILETIME_UNIX_EPOCH = 116444736000000000n;
+/** the runtime's accepted bias range, minutes (fle_time.c: -1440..1440) */
+export const TZ_BIAS_LIMIT = 1440;
+
+/** the decimal FILETIME of a Unix time in ms; null when the time is not a finite number or is before 1970 or after 9999 (the SYSTEMTIME range ends at 30827, the engine's limit is lower) */
+export function filetimeOfUnixMs(ms: number): string | null {
+  if (!Number.isFinite(ms) || ms < 0 || ms > 253402300799999) return null;
+  return (BigInt(Math.trunc(ms)) * 10000n + FILETIME_UNIX_EPOCH).toString();
+}
+
+/** the Windows bias from getTimezoneOffset() (minutes, UTC - local; the same sign): an integer within the runtime's range, else null */
+export function biasOfOffsetMin(offsetMin: number): string | null {
+  if (!Number.isFinite(offsetMin)) return null;
+  const v = Math.round(offsetMin);
+  if (v < -TZ_BIAS_LIMIT || v > TZ_BIAS_LIMIT) return null;
+  return String(v === 0 ? 0 : v);
+}
+
+export type WallParam = { mode: 'real' } | { mode: 'off' } | { mode: 'fixed'; unixMs: number };
+
+/** the page's URL parameter fle_wall: `off` = leave the engine's fixed origin; a decimal Unix time in ms = pin the start instant (the bias stays the host's); anything else (or none) = the real clock */
+export function parseWallParam(search: string): WallParam {
+  let v: string | null = null;
+  try { v = new URLSearchParams(search).get('fle_wall'); } catch { v = null; }
+  if (v === null) return { mode: 'real' };
+  if (v === 'off') return { mode: 'off' };
+  if (/^\d{1,15}$/.test(v)) return { mode: 'fixed', unixMs: Number(v) };
+  return { mode: 'real' };
+}
+
+export interface WallHost {
+  /** Date.now() */
+  now(): number;
+  /** new Date().getTimezoneOffset() */
+  tzOffsetMin(): number;
+}
+
+export interface WallApplied {
+  /** the variables this call added (the ones the manifest already carried are not listed) */
+  added: string[];
+  /** lines for the page's log */
+  lines: { level: 'info' | 'warn'; text: string }[];
+}
+
+/** Puts the run values into `env` (the manifest's engine.env). A name that `env` already has is kept. */
+export function applyWallClock(env: Record<string, string>, host: WallHost, param: WallParam = { mode: 'real' }): WallApplied {
+  const added: string[] = [];
+  const lines: WallApplied['lines'] = [];
+  const put = (k: string, v: string): void => {
+    if (env[k] !== undefined) { lines.push({ level: 'info', text: `${k}: the manifest already carries ${env[k]}: kept` }); return; }
+    env[k] = v;
+    added.push(k);
+  };
+  put('FLE_ENV_DEFAULTS', '1');
+  if (param.mode === 'off') {
+    lines.push({ level: 'info', text: 'guest clock: the engine\'s fixed origin (URL fle_wall=off); the environment block has the default variables' });
+    return { added, lines };
+  }
+  const ft = filetimeOfUnixMs(param.mode === 'fixed' ? param.unixMs : host.now());
+  const bias = biasOfOffsetMin(host.tzOffsetMin());
+  if (ft === null) lines.push({ level: 'warn', text: 'guest clock: the host clock gave no usable time: the engine keeps its fixed origin' });
+  else put('FLE_WALL_FILETIME', ft);
+  if (bias === null) lines.push({ level: 'warn', text: 'guest clock: the host time zone offset is not usable: UTC' });
+  else put('FLE_TZ_BIAS_MIN', bias);
+  if (ft !== null) lines.push({ level: 'info', text: `guest clock: FLE_WALL_FILETIME=${env.FLE_WALL_FILETIME ?? ft}${param.mode === 'fixed' ? ' (pinned by URL fle_wall)' : ''}, FLE_TZ_BIAS_MIN=${env.FLE_TZ_BIAS_MIN ?? (bias ?? 'unset')}` });
+  return { added, lines };
+}
