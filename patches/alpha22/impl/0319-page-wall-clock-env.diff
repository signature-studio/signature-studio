+import { describe, expect, it } from 'vitest';
+import { FILETIME_UNIX_EPOCH, TZ_BIAS_LIMIT, applyWallClock, biasOfOffsetMin, filetimeOfUnixMs, parseWallParam } from '../../src/engine/wall-clock.ts';
+
+const host = (now: number, off: number): { now(): number; tzOffsetMin(): number } => ({ now: () => now, tzOffsetMin: () => off });
+
+describe('the guest clock as a run value (decision 0319)', () => {
+  it('converts a Unix time in ms to a decimal FILETIME exactly (beyond 2^53)', () => {
+    expect(filetimeOfUnixMs(0)).toBe('116444736000000000');
+    expect(filetimeOfUnixMs(1)).toBe('116444736000010000');
+    const ms = 1_794_000_000_123;   // 2026-11
+    expect(filetimeOfUnixMs(ms)).toBe((BigInt(ms) * 10000n + FILETIME_UNIX_EPOCH).toString());
+    expect(BigInt(filetimeOfUnixMs(ms) as string) > 2n ** 53n).toBe(true);
+  });
+  it('truncates the fraction of a millisecond and refuses times that are not usable', () => {
+    expect(filetimeOfUnixMs(1000.9)).toBe(filetimeOfUnixMs(1000));
+    expect(filetimeOfUnixMs(Number.NaN)).toBeNull();
+    expect(filetimeOfUnixMs(Infinity)).toBeNull();
+    expect(filetimeOfUnixMs(-1)).toBeNull();
+    expect(filetimeOfUnixMs(253402300800000)).toBeNull();
+  });
+  it('takes the bias from getTimezoneOffset (same sign: UTC - local; Japan is -540) as an integer in the runtime\'s range', () => {
+    expect(biasOfOffsetMin(-540)).toBe('-540');
+    expect(biasOfOffsetMin(0)).toBe('0');
+    expect(biasOfOffsetMin(-0)).toBe('0');
+    expect(biasOfOffsetMin(300)).toBe('300');
+    expect(biasOfOffsetMin(-9.6)).toBe('-10');
+    expect(biasOfOffsetMin(TZ_BIAS_LIMIT)).toBe('1440');
+    expect(biasOfOffsetMin(TZ_BIAS_LIMIT + 1)).toBeNull();
+    expect(biasOfOffsetMin(Number.NaN)).toBeNull();
+  });
+  it('reads the URL parameter fle_wall', () => {
+    expect(parseWallParam('')).toEqual({ mode: 'real' });
+    expect(parseWallParam('?x=1')).toEqual({ mode: 'real' });
+    expect(parseWallParam('?fle_wall=off')).toEqual({ mode: 'off' });
+    expect(parseWallParam('?a=b&fle_wall=1700000000000')).toEqual({ mode: 'fixed', unixMs: 1700000000000 });
+    expect(parseWallParam('?fle_wall=abc')).toEqual({ mode: 'real' });
+    expect(parseWallParam('?fle_wall=-5')).toEqual({ mode: 'real' });
+    expect(parseWallParam('?fle_wall=12345678901234567')).toEqual({ mode: 'real' });
+  });
+  it('puts the three run values into the manifest\'s engine.env', () => {
+    const env: Record<string, string> = { FLE_DWM_HZ: '120' };
+    const r = applyWallClock(env, host(1_794_000_000_000, -540));
+    expect(env.FLE_ENV_DEFAULTS).toBe('1');
+    expect(env.FLE_WALL_FILETIME).toBe(filetimeOfUnixMs(1_794_000_000_000));
+    expect(env.FLE_TZ_BIAS_MIN).toBe('-540');
+    expect(env.FLE_DWM_HZ).toBe('120');   // the others are untouched
+    expect(r.added.sort()).toEqual(['FLE_ENV_DEFAULTS', 'FLE_TZ_BIAS_MIN', 'FLE_WALL_FILETIME']);
+    expect(r.lines.some((l) => l.text.includes('FLE_WALL_FILETIME='))).toBe(true);
+  });
+  it('never overwrites a value that the manifest already carries (a pinned run keeps its time)', () => {
+    const env: Record<string, string> = { FLE_WALL_FILETIME: '132539292000000000', FLE_TZ_BIAS_MIN: '0' };
+    const r = applyWallClock(env, host(1_794_000_000_000, -540));
+    expect(env.FLE_WALL_FILETIME).toBe('132539292000000000');
+    expect(env.FLE_TZ_BIAS_MIN).toBe('0');
+    expect(env.FLE_ENV_DEFAULTS).toBe('1');
+    expect(r.added).toEqual(['FLE_ENV_DEFAULTS']);
+  });
+  it('fle_wall=off leaves the engine\'s fixed origin (no clock value) and still gives the default environment block', () => {
+    const env: Record<string, string> = {};
+    const r = applyWallClock(env, host(1_794_000_000_000, -540), { mode: 'off' });
+    expect(env).toEqual({ FLE_ENV_DEFAULTS: '1' });
+    expect(r.added).toEqual(['FLE_ENV_DEFAULTS']);
+  });
+  it('fle_wall=<ms> pins the start instant and keeps the host\'s bias', () => {
+    const env: Record<string, string> = {};
+    applyWallClock(env, host(5, -540), { mode: 'fixed', unixMs: 1_700_000_000_000 });
+    expect(env.FLE_WALL_FILETIME).toBe(filetimeOfUnixMs(1_700_000_000_000));
+    expect(env.FLE_TZ_BIAS_MIN).toBe('-540');
+  });
+  it('an unusable host clock or offset adds nothing for that value and says so', () => {
+    const env: Record<string, string> = {};
+    const r = applyWallClock(env, host(Number.NaN, 5000));
+    expect(env).toEqual({ FLE_ENV_DEFAULTS: '1' });
+    expect(r.lines.filter((l) => l.level === 'warn').length).toBe(2);
+  });
+});
