+/* Decision 0319 TEST-ONLY slot/mix diagnostic (alpha1; RT-D4 increment, FLE_DIAG_G9F=1).
+ * Observation only: reads guest fields and float buffers, calls fn itself, and writes nothing the guest
+ * sees. FLE_TEST_GETENV is a null constant outside the native tests and in the product, so the on-path
+ * is dead there; the diagnostic build tree turns the read into getenv like the other FLE_DIAG_* reads.
+ *
+ * The hook point is FLEngine f_cf2a90(task rcx, Length edx). It is reached from a vtable slot of the
+ * mixer task object, so the indirect call of the guest goes through fle_dispatch and can be seen here.
+ * The three direct subcalls inside it (f_cf2f90, f_cf2d00, f_cf3020) are NOT reached this way, so
+ * this file calls them out only from the final task state: smartSkip sees task+0x28, the silence counter
+ * sees task+0x38/slot+0xa0 before and after.
+ *
+ * Each line prints, per slot pointer: the cumulative frames of that slot (scum), the Export position
+ * (expos; -1 until the export start), the task block pointers, the slot state (si, silence, smart flag,
+ * insert), the pre/post peak and sum and first 8 floats of in/dry/out. The export start follows the
+ * source-popinter change of this slot (task+0x18 changed from the first call of the slot to the current
+ * call). This rule is based on two observed runs only; the reader prefers an expos field in the log
+ * when the format provides one. Lines in expos 210000..212499 are all printed; outside, every 16th call
+ * of a slot is printed; a line budget keeps the total bounded.
+ */
+#include <inttypes.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "fle_runtime.h"
+#include "fle_test_env.h"
+
+#define G9M_SLOTS 128u
+#define G9M_WIN_LO 210000u
+#define G9M_WIN_HI 212500u
+
+typedef struct { uint32_t peak; double sum; float first[8]; } g9m_stat;
+static float g9m_peakf(g9m_stat s) { float x; memcpy(&x, &s.peak, 4); return x; }
+static g9m_stat g9m_peak(uint64_t p, uint64_t len)
+{
+    g9m_stat s;
+    uint64_t i;
+
+    { float z = 0.0f; memcpy(&s.peak, &z, 4); }
+    s.sum = 0;
+    for (i = 0; i < 8; i++) s.first[i] = 0.0f;
+    if (p == 0 || len == 0) return s;
+    for (i = 0; i < len * 2u; i++) {
+        uint32_t b = (uint32_t)fle_ld(p + 4u * i, 4);
+        float x;
+
+        memcpy(&x, &b, 4);
+        if (x < 0.0f) x = -x;
+        if (x > g9m_peakf(s) || x != x) memcpy(&s.peak, &x, 4);
+        s.sum += (double)x;
+        if (i < 8) s.first[i] = x;
+    }
+    return s;
+}
+
+static uint64_t g9m_slotid[G9M_SLOTS], g9m_scum[G9M_SLOTS], g9m_first_src[G9M_SLOTS], g9m_expos0[G9M_SLOTS], g9m_calln[G9M_SLOTS];
+static unsigned char g9m_have_first[G9M_SLOTS], g9m_have_e0[G9M_SLOTS];
+static unsigned g9m_nslots;
+static uint64_t g9m_lines;
+static int g9m_lockword;
+
+static int g9m_on(void)
+{
+    static int on = -1;
+
+    if (on < 0) { const char *e = FLE_TEST_GETENV("FLE_DIAG_G9F"); on = e != NULL && e[0] == '1'; }
+    return on;
+}
+static void g9m_lock(void) { while (__atomic_exchange_n(&g9m_lockword, 1, __ATOMIC_ACQUIRE)) {} }
+static void g9m_unlock(void) { __atomic_store_n(&g9m_lockword, 0, __ATOMIC_RELEASE); }
+
+static void g9m_print(uint64_t task, uint64_t slot, uint64_t len, uint64_t scum, int64_t expos,
+                      unsigned k, uint64_t in_ptr, uint64_t dry_ptr, uint64_t dst_ptr,
+                      g9m_stat is, g9m_stat ds, g9m_stat os, g9m_stat ip, g9m_stat dp,
+                      unsigned si, uint64_t sil0, uint64_t sil1, unsigned smart, unsigned insert,
+                      int smartskip)
+{
+    unsigned i;
+
+    fprintf(stderr, "g9m: slot %#" PRIx64 " task %#" PRIx64 " k %u len %" PRIu64 " scum %" PRIu64 " expos %" PRId64 "\n",
+            slot, task, k, len, scum, expos);
+    fprintf(stderr, "g9m:   si %u insert %u silence %" PRIu64 "->%" PRIu64 " smart %u skip %d in %#" PRIx64 " dry %#" PRIx64 " out %#" PRIx64 "\n",
+            si, insert, sil0, sil1, smart, smartskip, in_ptr, dry_ptr, dst_ptr);
+    fprintf(stderr, "g9m:   in pre peak %g sum %g | dry pre peak %g sum %g | out pre peak %g sum %g | out post peak %g sum %g\n",
+            (double)g9m_peakf(is), is.sum, (double)g9m_peakf(ds), ds.sum, (double)g9m_peakf(os), os.sum, (double)g9m_peakf(ip), ip.sum);
+    fprintf(stderr, "g9m:   src_first8");
+    for (i = 0; i < 8; i++) fprintf(stderr, " %g", (double)is.first[i]);
+    fprintf(stderr, " dry_first8");
+    for (i = 0; i < 8; i++) fprintf(stderr, " %g", (double)ds.first[i]);
+    fprintf(stderr, " out_before_first8");
+    for (i = 0; i < 8; i++) fprintf(stderr, " %g", (double)os.first[i]);
+    fprintf(stderr, " out_after_first8");
+    for (i = 0; i < 8; i++) fprintf(stderr, " %g", (double)ip.first[i]);
+    fprintf(stderr, " dst_pre_first8");
+    for (i = 0; i < 8; i++) fprintf(stderr, " %g", (double)dp.first[i]);
+    fprintf(stderr, "\n");
+}
+
+void fle_diag_g9mix_hook(uint64_t va, void (*fn)(void))
+{
+    uint64_t task, slot, len;
+    uint64_t in_ptr, dry_ptr, dst_ptr, src_change;
+    g9m_stat is, ds, os, ip, dp;
+    unsigned si, insert, smart;
+    uint64_t sil0, sil1, scum_before;
+    int smartskip;
+    unsigned k;
+
+    if (va != UINT64_C(0xcf2a90) || !g9m_on()) { fn(); return; }
+    task = R[1];
+    if (task == 0) { fn(); return; }
+    len = (uint32_t)R[2];
+    slot = fle_ld(task + UINT64_C(0x38), 8);
+    if (slot == 0) { fn(); return; }
+    si = (unsigned)(uint32_t)fle_ld(slot + UINT64_C(0x64), 4);
+    insert = (unsigned)(uint32_t)fle_ld(slot + UINT64_C(0x130), 4);
+    smart = (unsigned)fle_ld(slot + UINT64_C(0xf7), 1);
+    sil0 = (uint32_t)fle_ld(slot + UINT64_C(0xa0), 4);
+    in_ptr = fle_ld(task + UINT64_C(0x18), 8);
+    if (((uint32_t)fle_ld(slot + UINT64_C(0x13c), 4) | (uint32_t)fle_ld(slot + UINT64_C(0x140), 4)) != 0)
+        dst_ptr = fle_ld(fle_ld(task + UINT64_C(0x2c), 8) + UINT64_C(0x68), 8);
+    else
+        dst_ptr = in_ptr;
+    if ((uint32_t)fle_ld(slot + UINT64_C(0x154), 4) != 0)
+        dry_ptr = fle_ld(fle_ld(task + UINT64_C(0x2c), 8) + UINT64_C(0x60), 8);
+    else
+        dry_ptr = in_ptr;
+    is = g9m_peak(in_ptr, len);
+    ds = g9m_peak(dry_ptr, len);
+    os = g9m_peak(dst_ptr, len);
+    dp = os;
+    g9m_lock();
+    for (k = 0; k < g9m_nslots && g9m_slotid[k] != slot; k++) {}
+    if (k == g9m_nslots) { if (g9m_nslots < G9M_SLOTS) { g9m_slotid[g9m_nslots] = slot; g9m_nslots++; } else k = G9M_SLOTS - 1u; }
+    scum_before = g9m_scum[k];
+    src_change = 0;
+    if (!g9m_have_first[k]) { g9m_have_first[k] = 1; g9m_first_src[k] = in_ptr; }
+    else if (in_ptr != g9m_first_src[k] && !g9m_have_e0[k]) { g9m_have_e0[k] = 1; g9m_expos0[k] = scum_before; src_change = 1; }
+    g9m_calln[k]++;
+    g9m_scum[k] += len;
+    g9m_unlock();
+    (void)src_change;
+    fn();
+    sil1 = (uint32_t)fle_ld(slot + UINT64_C(0xa0), 4);
+    smartskip = (uint32_t)fle_ld(task + UINT64_C(0x28), 4) == 0 && len != 0;
+    ip = g9m_peak(fle_ld(task + UINT64_C(0x54), 8), len);
+    dp = os;
+    if ((g9m_have_e0[k] && scum_before >= g9m_expos0[k] + G9M_WIN_LO && scum_before < g9m_expos0[k] + G9M_WIN_HI) ||
+        (g9m_calln[k] % 16u) == 0) {
+        if (g9m_lines < 19000u) {
+            g9m_lines++;
+            g9m_print(task, slot, len, scum_before, g9m_have_e0[k] ? (int64_t)(scum_before - g9m_expos0[k]) : (int64_t)-1,
+                      k, in_ptr, dry_ptr, dst_ptr, is, ds, os, ip, dp, si, sil0, sil1, smart, insert, smartskip);
+        }
+    }
+}
