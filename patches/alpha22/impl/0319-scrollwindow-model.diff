+        if (s.x0 < sr.x0) s.x0 = sr.x0;
+        if (s.y0 < sr.y0) s.y0 = sr.y0;
+        if (s.x1 > sr.x1) s.x1 = sr.x1;
+        if (s.y1 > sr.y1) s.y1 = sr.y1;
+        if (s.x1 < s.x0) s.x1 = s.x0;
+        if (s.y1 < s.y0) s.y1 = s.y0;
+        sr = s;
+    }
