+            fle_rrect cr;
+            uint64_t sv;
+
+            if (!tab[d].live || tab[d].parent != i) continue;
+            cr.x0 = cl.x0 + tab[d].px; cr.y0 = cl.y0 + tab[d].py; cr.x1 = cr.x0 + tab[d].pcx; cr.y1 = cr.y0 + tab[d].pcy;
+            if (!unc_touch(cr, sr)) continue;
