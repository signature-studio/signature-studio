+    int64_t i = live_index(hwnd), root;
+    int32_t ox, oy, rx, ry, bb[4];
+    fle_rrect cl, sr, kr, pend;
+    fle_visrgn vis, src, dgeo, geo, mv;
+    uint32_t cf;
+    uint64_t d;
+    int has_pending = 0;
+
+    memset(res, 0, sizeof *res);
+    if (i < 0) { res->invalid = 1; return 1; }
