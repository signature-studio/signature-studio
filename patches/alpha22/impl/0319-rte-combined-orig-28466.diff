+    fprintf(stderr, "g9m: slot %#" PRIx64 " task %#" PRIx64 " k %u len %" PRIu64 " scum %" PRIu64 " expos %" PRId64 "\n",
+            slot, task, k, len, scum, expos);
+    fprintf(stderr, "g9m:   si %u insert %u silence %" PRIu64 "->%" PRIu64 " smart %u skip %d in %#" PRIx64 " dry %#" PRIx64 " out %#" PRIx64 "\n",
+            si, insert, sil0, sil1, smart, smartskip, in_ptr, dry_ptr, dst_ptr);
+    fprintf(stderr, "g9m:   in pre peak %g sum %g | dry pre peak %g sum %g | out pre peak %g sum %g | out post peak %g sum %g\n",
+            (double)g9m_peakf(is), is.sum, (double)g9m_peakf(ds), ds.sum, (double)g9m_peakf(os), os.sum, (double)g9m_peakf(ip), ip.sum);
+    fprintf(stderr, "g9m:   src_first8");
+    for (i = 0; i < 8; i++) fprintf(stderr, " %g", (double)is.first[i]);
+    fprintf(stderr, " dry_first8");
+    for (i = 0; i < 8; i++) fprintf(stderr, " %g", (double)ds.first[i]);
+    fprintf(stderr, " out_before_first8");
+    for (i = 0; i < 8; i++) fprintf(stderr, " %g", (double)os.first[i]);
+    fprintf(stderr, " out_after_first8");
+    for (i = 0; i < 8; i++) fprintf(stderr, " %g", (double)ip.first[i]);
+    fprintf(stderr, " dst_pre_first8");
+    for (i = 0; i < 8; i++) fprintf(stderr, " %g", (double)dp.first[i]);
+    fprintf(stderr, "\n");
+}
+
+void fle_diag_g9mix_hook(uint64_t va, void (*fn)(void))
+{
+    uint64_t task, slot, len;
+    uint64_t in_ptr, dry_ptr, dst_ptr, src_change;
+    g9m_stat is, ds, os, ip, dp;
+    unsigned si, insert, smart;
+    uint64_t sil0, sil1, scum_before;
+    int smartskip;
+    unsigned k;
+
+    if (va != UINT64_C(0xcf2a90) || !g9m_on()) { fn(); return; }
+    task = R[1];
+    if (task == 0) { fn(); return; }
+    len = (uint32_t)R[2];
+    slot = fle_ld(task + UINT64_C(0x38), 8);
+    if (slot == 0) { fn(); return; }
+    si = (unsigned)(uint32_t)fle_ld(slot + UINT64_C(0x64), 4);
+    insert = (unsigned)(uint32_t)fle_ld(slot + UINT64_C(0x130), 4);
+    smart = (unsigned)fle_ld(slot + UINT64_C(0xf7), 1);
+    sil0 = (uint32_t)fle_ld(slot + UINT64_C(0xa0), 4);
+    in_ptr = fle_ld(task + UINT64_C(0x18), 8);
+    if (((uint32_t)fle_ld(slot + UINT64_C(0x13c), 4) | (uint32_t)fle_ld(slot + UINT64_C(0x140), 4)) != 0)
+        dst_ptr = fle_ld(fle_ld(task + UINT64_C(0x2c), 8) + UINT64_C(0x68), 8);
+    else
+        dst_ptr = in_ptr;
+    if ((uint32_t)fle_ld(slot + UINT64_C(0x154), 4) != 0)
+        dry_ptr = fle_ld(fle_ld(task + UINT64_C(0x2c), 8) + UINT64_C(0x60), 8);
+    else
+        dry_ptr = in_ptr;
+    is = g9m_peak(in_ptr, len);
+    ds = g9m_peak(dry_ptr, len);
+    os = g9m_peak(dst_ptr, len);
+    dp = os;
+    g9m_lock();
+    for (k = 0; k < g9m_nslots && g9m_slotid[k] != slot; k++) {}
+    if (k == g9m_nslots) { if (g9m_nslots < G9M_SLOTS) { g9m_slotid[g9m_nslots] = slot; g9m_nslots++; } else k = G9M_SLOTS - 1u; }
+    scum_before = g9m_scum[k];
+    src_change = 0;
+    if (!g9m_have_first[k]) { g9m_have_first[k] = 1; g9m_first_src[k] = in_ptr; }
+    else if (in_ptr != g9m_first_src[k] && !g9m_have_e0[k]) { g9m_have_e0[k] = 1; g9m_expos0[k] = scum_before; src_change = 1; }
+    g9m_calln[k]++;
+    g9m_scum[k] += len;
+    g9m_unlock();
+    (void)src_change;
+    fn();
+    sil1 = (uint32_t)fle_ld(slot + UINT64_C(0xa0), 4);
+    smartskip = (uint32_t)fle_ld(task + UINT64_C(0x28), 4) == 0 && len != 0;
+    ip = g9m_peak(fle_ld(task + UINT64_C(0x54), 8), len);
+    dp = os;
+    if ((g9m_have_e0[k] && scum_before >= g9m_expos0[k] + G9M_WIN_LO && scum_before < g9m_expos0[k] + G9M_WIN_HI) ||
+        (g9m_calln[k] % 16u) == 0) {
+        if (g9m_lines < 19000u) {
+            g9m_lines++;
+            g9m_print(task, slot, len, scum_before, g9m_have_e0[k] ? (int64_t)(scum_before - g9m_expos0[k]) : (int64_t)-1,
+                      k, in_ptr, dry_ptr, dst_ptr, is, ds, os, ip, dp, si, sil0, sil1, smart, insert, smartskip);
+        }
+    }
+}
