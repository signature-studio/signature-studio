+#[test]
+fn the_virtual_pointer_equals_the_clamped_host_point_when_the_guest_never_sets_the_cursor() {
+    // Decision 0319 O20: with no SetCursorPos/SetPhysicalCursorPos the guest point is the host's point clamped to the screen, shown or hidden (the old, absolute behaviour). The series includes points outside
+    // the screen, so the clamp of the delta form is compared with the clamp of the absolute form.
+    let l = lines(
+        "fr11-virtual-pointer-same-as-absolute",
+        r#"
+    static const int32_t xs[] = { 0, 5, 1919, 2500, -30, 700, 700, 1, 1919, 0, 1000, -1, 1920 };
+    static const int32_t ys[] = { 0, 5, 1079, -9, 1500, 0, 1079, 1, 1, 1079, 540, -1, 1080 };
+    int32_t pt[2];
+    unsigned i, n = sizeof xs / sizeof xs[0], bad, pass;
+    void fle_win_host_pointer_set(int32_t, int32_t);
+    for (pass = 0; pass < 2; pass++) {
+        if (pass == 1) K(fle_imp_ShowCursor, 0);
+        bad = 0;
+        for (i = 0; i < n; i++) {
+            int32_t ex = xs[i] < 0 ? 0 : xs[i] > 1919 ? 1919 : xs[i], ey = ys[i] < 0 ? 0 : ys[i] > 1079 ? 1079 : ys[i];
+            fle_win_host_pointer_set(xs[i], ys[i]);
+            K(fle_imp_GetCursorPos, A(pt));
+            if (pt[0] != ex || pt[1] != ey) bad++;
+        }
+        printf("%s n %u bad %u\n", pass ? "hidden" : "shown", n, bad);
+    }
+"#,
+    );
+    assert_eq!(l[0], "shown n 13 bad 0");
+    assert_eq!(l[1], "hidden n 13 bad 0");
 }
 
 #[test]
