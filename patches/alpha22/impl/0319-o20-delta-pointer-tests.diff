+#[test]
+fn the_virtual_pointer_is_the_host_point_again_when_the_cursor_is_shown_after_a_set_cursor_pos() {
+    // Decision 0319 O20: FL's drag ends with SetPhysicalCursorPos(start) and ShowCursor(TRUE) while the browser pointer is elsewhere; the next host move must give the host's point (not the host's point plus
+    // an offset: the offset form gave 0 here and a third and fourth drag did not work), and a following drag moves by the delta again.
+    let l = lines(
+        "fr11-virtual-pointer-reshown",
+        r#"
+    int32_t pt[2];
+    void fle_win_host_pointer_set(int32_t, int32_t);
     fle_win_host_pointer_set(450, 1079);
+    K(fle_imp_ShowCursor, 0);
     K(fle_imp_SetPhysicalCursorPos, 450, 17);
-    K(fle_imp_GetCursorPos, A(pt)); printf("wrap set -> %d %d\n", pt[0], pt[1]);
+    K(fle_imp_GetCursorPos, A(pt)); printf("end set -> %d %d\n", pt[0], pt[1]);
+    K(fle_imp_ShowCursor, 1);
+    K(fle_imp_GetCursorPos, A(pt)); printf("shown before a host move -> %d %d\n", pt[0], pt[1]);
     fle_win_host_pointer_set(450, 20);
     K(fle_imp_GetCursorPos, A(pt)); printf("host 450 20 -> %d %d\n", pt[0], pt[1]);
     fle_win_host_pointer_set(450, 21);
     K(fle_imp_GetCursorPos, A(pt)); printf("host 450 21 -> %d %d\n", pt[0], pt[1]);
-    K(fle_imp_SetCursorPos, 1920, 1080);
-    K(fle_imp_GetCursorPos, A(pt)); printf("clamped -> %d %d\n", pt[0], pt[1]);
-    fle_win_host_pointer_set(21, 20);
-    K(fle_imp_GetCursorPos, A(pt)); printf("host 21 20 -> %d %d\n", pt[0], pt[1]);
+    K(fle_imp_ShowCursor, 0);
+    fle_win_host_pointer_set(450, 22);
+    K(fle_imp_GetCursorPos, A(pt)); printf("drag 4 host 450 22 -> %d %d\n", pt[0], pt[1]);
+    fle_win_host_pointer_set(450, 23);
+    K(fle_imp_GetCursorPos, A(pt)); printf("drag 4 host 450 23 -> %d %d\n", pt[0], pt[1]);
+    K(fle_imp_SetPhysicalCursorPos, 450, 1036);
+    fle_win_host_pointer_set(450, 24);
+    K(fle_imp_GetCursorPos, A(pt)); printf("drag 4 wrap then host 450 24 -> %d %d\n", pt[0], pt[1]);
+    K(fle_imp_SetPhysicalCursorPos, 450, 23);
+    K(fle_imp_ShowCursor, 1);
+    fle_win_host_pointer_set(450, 25);
+    K(fle_imp_GetCursorPos, A(pt)); printf("drag 4 end host 450 25 -> %d %d\n", pt[0], pt[1]);
+"#,
+    );
+    assert_eq!(l[0], "end set -> 450 17");
+    assert_eq!(l[1], "shown before a host move -> 450 17");
+    assert_eq!(l[2], "host 450 20 -> 450 20");
+    assert_eq!(l[3], "host 450 21 -> 450 21");
+    assert_eq!(l[4], "drag 4 host 450 22 -> 450 22");
+    assert_eq!(l[5], "drag 4 host 450 23 -> 450 23");
+    assert_eq!(l[6], "drag 4 wrap then host 450 24 -> 450 1037");
+    assert_eq!(l[7], "drag 4 end host 450 25 -> 450 25");
+}
