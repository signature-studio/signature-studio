+/* ---- Processor counts and groups (decision 0319 section 10: all from fle_sys_processors, so that no answer contradicts GetSystemInfo / GetLogicalProcessorInformation / the affinity masks) ----
+ * Learn GetActiveProcessorCount: DWORD f(WORD GroupNumber): "the number of active processors in the specified group"; ALL_PROCESSOR_GROUPS (0xFFFF) "to retrieve the total number of active processors in all groups";
+ * zero on failure. GetMaximumProcessorCount: the same for "the maximum number of logical processors". GetActiveProcessorGroupCount / GetMaximumProcessorGroupCount: WORD, "the number of active /
+ * maximum processor groups". The run has ONE group of n processors (n <= FLE_SYS_MAX_PROCESSORS). A group number other than 0 and 0xFFFF: the page names no error code for it: the run stops by name.
+ * GetCurrentProcessorNumber: DWORD f(void): "the number of the processor on which the calling thread is currently running"; the guest thread index modulo n (a choice: the threads are spread over the
+ * processors in order; with one processor it is 0 as before). */
+static uint32_t fle_group_count(const char *api)
+{
+    uint32_t g = (uint32_t)(R[1] & 0xFFFFu);
+
+    fle_sysinfo_check_thread(api);
+    if (g != 0u && g != 0xFFFFu) fle_stop(api, "a processor group other than 0: this machine has one group and the page names no error for another");
+    return fle_sys_processors();
+}
+
+void fle_imp_GetActiveProcessorCount(void) { R[0] = fle_group_count("GetActiveProcessorCount"); }
+void fle_imp_GetMaximumProcessorCount(void) { R[0] = fle_group_count("GetMaximumProcessorCount"); }
+void fle_imp_GetActiveProcessorGroupCount(void) { fle_sysinfo_check_thread("GetActiveProcessorGroupCount"); R[0] = 1; }
+void fle_imp_GetMaximumProcessorGroupCount(void) { fle_sysinfo_check_thread("GetMaximumProcessorGroupCount"); R[0] = 1; }
+
+uint32_t fle_thread_current(void) __attribute__((weak));
+void fle_imp_GetCurrentProcessorNumber(void)
+{
+    fle_sysinfo_check_thread("GetCurrentProcessorNumber");
+    R[0] = fle_thread_current ? fle_thread_current() % fle_sys_processors() : 0u;
+}
