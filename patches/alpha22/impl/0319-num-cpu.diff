+/* Decision 0319 section 10 (alpha1, PROVISIONAL; PM 08:3x): the number of logical processors is a VALUE OF THE RUN, FLE_NUM_CPU=<n> in the engine's environment (the page passes the number of Workers that can really run in
+ * parallel, like FLE_MONITOR_W and FLE_WALL_FILETIME). Learn GetSystemInfo / SYSTEM_INFO: dwNumberOfProcessors is "the number of logical processors in the current group" and dwActiveProcessorMask "a mask representing the
+ * set of processors configured into the system" - a guest that can run on n Workers must be told n. 0 = unset or not a whole number of decimal digits in 1..FLE_SYS_MAX_PROCESSORS (then the former rule applies: the host's
+ * processors with real threads, 1 otherwise). An Export harness leaves it unset (1: every answer is the former one). */
+#include <stdlib.h>
+static uint32_t fle_num_cpu_env(void)
+{
+    const char *e = getenv("FLE_NUM_CPU");
+    uint32_t v = 0;
+
+    if (e == NULL || *e == '\0') return 0u;
+    for (; *e != '\0'; e++) {
+        if (*e < '0' || *e > '9' || v > 1000u) return 0u;
+        v = v * 10u + (uint32_t)(*e - '0');
+    }
+    return v >= 1u && v <= FLE_SYS_MAX_PROCESSORS ? v : 0u;
+}
+
 #ifdef FLE_GIL
 /* Decision 0312 (mt3, S3a): the number of processors is the host's (D2). hardwareConcurrency exists in the browser's Workers and in node. FLE_PROCESSORS (fle_thread.c fle_cfg_processors, S3a only: the
  * measurement of the Worker count before the variable is removed) takes precedence when it is set. Decided once; the value is the same for every Worker. */
@@ -647,7 +665,8 @@
