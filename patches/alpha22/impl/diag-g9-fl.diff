+/* Decision 0319 TEST-ONLY diagnostic (never pushed; FLE_TEST_GETENV is a null constant in the product, so this is dead code there): FLE_DIAG_WIN=1 prints every window the guest creates and destroys (class, title,
+ * rect, style, parent lid, the guest return address of the creating call, thread) on stderr as "fl-diag: win ...". The window table lists only live windows; this shows the ones that live and die within one operation
+ * (O13: the 8 windows that were created and destroyed by one click on a mixer slot name). Observation only: it changes nothing the guest sees. */
+static void diag_win_log(const char *what, int64_t i, uint64_t ra)
+{
+    static int on = -1;
+    static unsigned n;
+    char title[80], cls[80];
+    uint16_t nm[FLE_CLASS_NAME_MAX_UNITS + 1], nl = 0;
+    int64_t par;
+
+    if (on < 0) { const char *e = FLE_TEST_GETENV("FLE_DIAG_WIN"); on = e != NULL && e[0] == '1'; }
+    if (!on || n >= 4000u) return;
+    n++;
+    u16_ascii(title, sizeof title, tab[i].text, tab[i].text_len < 60 ? tab[i].text_len : 60);
+    cls[0] = 0;
+    if (fle_class_name_of(tab[i].atom, nm, &nl)) u16_ascii(cls, sizeof cls, nm, nl < 79 ? nl : 79);
+    par = tab[i].parent >= 0 ? tab[i].parent : tab[i].owner_win;
+    fprintf(stderr, "fl-diag: win %s lid %u class \"%s\" title \"%s\" rect (%d,%d,%dx%d) style %#x exstyle %#x parent_lid %d%s caller %#llx thread %u\n", what, (unsigned)tab[i].lid, cls, title,
+            (int)tab[i].px, (int)tab[i].py, (int)tab[i].pcx, (int)tab[i].pcy, (unsigned)tab[i].style, (unsigned)tab[i].exstyle, par >= 0 ? (int)tab[par].lid : -1,
+            tab[i].parent >= 0 ? "" : " (owner)", (unsigned long long)ra, fle_thread_current ? fle_thread_current() : 0u);
+}
+
+/* Decision 0319 TEST-ONLY (ci1's request, 0322 audit item (1)): FLE_DIAG_WIN=1 also prints every DefWindowProc answer to WM_ERASEBKGND and WM_PAINT with the window and its ancestor chain (class names, up to 4 levels), so that the
+ * windows of one family (the plug-in editor TPluginForm / TWPControlForm / TVectorSheet ... of Fruity Balance) can be told from the log. DefWindowProc's WM_ERASEBKGND draws nothing and answers 1 here (runtime reading of the
+ * Learn page: it should erase with the class background brush); the log shows how often and for which windows that answer was used. */
+static void diag_def_log(int64_t wi, uint32_t msg)
+{
+    static int on = -1;
+    static unsigned n;
+    char chain[220], cls[60];
+    uint16_t nm[FLE_CLASS_NAME_MAX_UNITS + 1], nl = 0;
+    int64_t a = wi;
+    int depth = 0;
+    size_t at = 0;
+
+    if (on < 0) { const char *e = FLE_TEST_GETENV("FLE_DIAG_WIN"); on = e != NULL && e[0] == '1'; }
+    if (!on || n >= 3000u) return;
+    n++;
+    chain[0] = 0;
+    for (; a >= 0 && depth < 4; depth++) {
+        cls[0] = 0;
+        if (fle_class_name_of(tab[a].atom, nm, &nl)) u16_ascii(cls, sizeof cls, nm, nl < 59 ? nl : 59);
+        at += (size_t)snprintf(chain + at, sizeof chain - at, "%s%s(%u)", depth ? " < " : "", cls, (unsigned)tab[a].lid);
+        if (at >= sizeof chain) break;
+        a = tab[a].parent >= 0 ? tab[a].parent : tab[a].owner_win;
+    }
+    fprintf(stderr, "fl-diag: DefWindowProc %s lid %u rect (%d,%d,%dx%d) visible %d chain %s\n", msg == FLE_WM_ERASEBKGND ? "WM_ERASEBKGND" : "WM_PAINT", (unsigned)tab[wi].lid, (int)tab[wi].px, (int)tab[wi].py,
+            (int)tab[wi].pcx, (int)tab[wi].pcy, is_visible(wi) ? 1 : 0, chain);
+}
