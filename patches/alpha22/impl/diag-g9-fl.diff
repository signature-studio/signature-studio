+/* Decision 0319 TEST-ONLY diagnostic (FLE_DIAG_VFS_MISS=1; dead code in the product): every path that the guest asked for and the virtual volume does not have (status 2 = the last component, 3 = an earlier one), with the API
+ * that asked, on stderr as "fl-diag: vfs-miss ...". The same path asked again by the same API is printed once. It answers 'which files (fonts, Data, Plugins) does FL look for and not find'. */
+static uint32_t lookup(const char *api, const vpath *v, fle_node **node, fle_node **parent)
+{
+    static int on = -1;
+    static unsigned n;
+    static char last[600];
+    uint32_t st = lookup_impl(api, v, node, parent);
+
+    if (on < 0) { const char *e = FLE_TEST_GETENV("FLE_DIAG_VFS_MISS"); on = e != NULL && e[0] == '1'; }
+    if (on && st != 0 && n < 6000u) {
+        char buf[600];
+        size_t i, j, at = 0;
+
+        for (i = 0; i < v->n && at + 2 < sizeof buf; i++) {
+            if (i > 0) buf[at++] = '\\';
+            for (j = 0; j < v->l[i] && at + 2 < sizeof buf; j++) buf[at++] = v->p[i][j] < 128 && v->p[i][j] >= 32 ? (char)v->p[i][j] : '?';
+        }
+        buf[at] = 0;
+        if (strcmp(buf, last) != 0) {
+            n++;
+            snprintf(last, sizeof last, "%s", buf);
+            fprintf(stderr, "fl-diag: vfs-miss %s status %u path %s\n", api, (unsigned)st, buf);
+        }
+    }
+    return st;
+}
