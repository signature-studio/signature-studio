+/* Decision 0319: the run values FLE_WALL_FILETIME and FLE_TZ_BIAS_MIN (fle_time.h), read once at the first use. The virtual clock starts at FLE_CLOCK_START_MS, so the boot instant is the wall instant minus that. */
+static uint64_t wall_boot = FLE_TIME_BOOT_FILETIME;
+static int32_t wall_bias = 0;
+static int wall_read_done;
+
+static int wall_parse_u64(const char *e, uint64_t *out)
+{
+    uint64_t v = 0;
+    if (e == NULL || *e == '\0') return 0;
+    for (; *e != '\0'; e++) {
+        if (*e < '0' || *e > '9' || v > UINT64_C(1844674407370955160)) return 0;
+        v = v * 10u + (uint64_t)(*e - '0');
+    }
+    *out = v;
+    return 1;
+}
+
+static void wall_read(void)
+{
+    uint64_t ft = 0;
+    const char *b = getenv("FLE_TZ_BIAS_MIN");
+
+    wall_read_done = 1;
+    if (wall_parse_u64(getenv("FLE_WALL_FILETIME"), &ft) && ft < FLE_TIME_FILETIME_LIMIT && ft >= FLE_CLOCK_START_MS * FLE_TICKS_PER_MS)
+        wall_boot = ft - FLE_CLOCK_START_MS * FLE_TICKS_PER_MS;
+    if (b != NULL && *b != '\0') {
+        const char *p = b;
+        int neg = 0;
+        long v = 0;
+
+        if (*p == '-') { neg = 1; p++; }
+        for (; *p >= '0' && *p <= '9' && v <= 100000; p++) v = v * 10 + (*p - '0');
+        if (*p == '\0' && p != b + neg && v <= 1440) wall_bias = (int32_t)(neg ? -v : v);
+    }
+}
+
+int32_t fle_tz_bias_minutes(void)
+{
+    if (!wall_read_done) wall_read();
+    return wall_bias;
+}
+
+uint64_t fle_time_now_filetime(void)
+{
+    if (!wall_read_done) wall_read();
+    return wall_boot + fle_clock_read_ticks();
+}
 
