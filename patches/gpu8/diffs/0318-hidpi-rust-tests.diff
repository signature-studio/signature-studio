+//! Tests for the DPI answers of runtime/fle_proc.c (decision 0318): shcore!GetProcessDpiAwareness, user32!IsProcessDPIAware, user32!SetThreadDpiAwarenessContext, user32!SetThreadDpiHostingBehavior.
+//!
+//! Expected values are written here from the rules on the Microsoft pages (GetProcessDpiAwareness, IsProcessDPIAware, SetThreadDpiAwarenessContext, SetThreadDpiHostingBehavior, windef.h /
+//! shellscalingapi.h values), not read back from the C code. The process is per-monitor aware because the manifest of FL64.exe says <dpiAware>True/PM</dpiAware>. The thread state is a choice
+//! without a source (S-gpu8-thread-dpi): stored and returned, no other answer depends on it. The host is Linux: nothing is compared with a real Windows. These tests link no thread file, so
+//! the one thread is thread 0.
+
+mod etxt_common;
+
+use std::os::unix::process::ExitStatusExt;
+use std::path::{Path, PathBuf};
+use std::process::Command;
+use std::sync::OnceLock;
+
+fn manifest() -> PathBuf {
+    PathBuf::from(env!("CARGO_MANIFEST_DIR"))
+}
+fn runtime_dir() -> PathBuf {
+    manifest().join("../../runtime")
+}
+fn work_dir() -> PathBuf {
+    let d = manifest().join("../../out-dpi1-test");
+    std::fs::create_dir_all(d.join("tmp")).unwrap();
+    d
+}
+
+fn clang_c(src: &Path, obj: &Path, strict: bool) {
+    let mut cmd = Command::new("clang");
+    cmd.args(["-O0", "-std=gnu11", "-Wall", "-Wextra", "-fPIE", "-c"]);
+    if strict {
+        cmd.arg("-Werror");
+    }
+    let cc = cmd.arg("-I").arg(runtime_dir()).arg(src).arg("-o").arg(obj).env("TMPDIR", work_dir().join("tmp")).output().expect("clang not found");
+    assert!(cc.status.success(), "clang failed for {}: {}", src.display(), String::from_utf8_lossy(&cc.stderr));
+}
+
+fn objs() -> &'static Vec<PathBuf> {
+    static O: OnceLock<Vec<PathBuf>> = OnceLock::new();
+    O.get_or_init(|| {
+        let dir = work_dir().join(etxt_common::per_process("obj-dpi1"));
+        std::fs::create_dir_all(&dir).unwrap();
+        let mut v = Vec::new();
+        for (name, ours) in [("fle_proc.c", true), ("fle_time.c", true), ("fle_sys.c", false), ("fle_imports.c", false), ("fle_env.c", false)] {
+            let o = dir.join(name.replace(".c", ".o"));
+            clang_c(&runtime_dir().join(name), &o, ours);
+            v.push(o);
+        }
+        v
+    })
+}
+
+const PRELUDE: &str = r#"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdint.h>
+#include <pthread.h>
+#include "fle_runtime.h"
+#include "fle_imports.h"
+#include "fle_env.h"
+#include "fle_sys.h"
+#include "fle_proc.h"
+
+uint64_t R[16];
+static uint64_t stk[32];
+
+static uint64_t callv(void (*f)(void), const uint64_t *a)
+{
+    memset(stk, 0, sizeof stk);
+    stk[0] = 0xdead0000u;
+    R[1] = a[0]; R[2] = a[1]; R[8] = a[2]; R[9] = a[3];
+    R[4] = (uint64_t)(uintptr_t)stk;
+    R[0] = 0xBADBADBADull;
+    f();
+    return R[0];
+}
+#define CALL(f, ...) callv((void (*)(void))(f), (uint64_t[12]){ __VA_ARGS__ })
+#define A(x) ((uint64_t)(uintptr_t)(x))
+#define U(x) ((unsigned long long)(x))
+"#;
+
+fn run(name: &str, env: &[(&str, &str)], body: &str) -> Vec<String> {
+    let dir = work_dir();
+    let uname = etxt_common::uniq(name);
+    let c = dir.join(format!("{uname}.c"));
+    let exe = dir.join(&uname);
+    std::fs::write(&c, format!("{PRELUDE}\nint main(void)\n{{\n{body}\n    return 0;\n}}\n")).unwrap();
+    let mut cmd = Command::new("clang");
+    cmd.args(["-O0", "-std=gnu11", "-w", "-fPIE", "-pthread", "-I"]).arg(runtime_dir());
+    for o in objs() {
+        cmd.arg(o);
+    }
+    let cc = cmd.arg("-o").arg(&exe).arg(&c).env("TMPDIR", dir.join("tmp")).output().expect("clang not found");
+    assert!(cc.status.success(), "clang failed for {name}: {}", String::from_utf8_lossy(&cc.stderr));
+    let mut r = Command::new(&exe);
+    r.env_remove("FLE_SCREEN_DPI").env("TMPDIR", dir.join("tmp"));
+    for (k, v) in env {
+        r.env(k, v);
+    }
+    let o = r.output().expect("run failed");
+    assert!(o.status.success(), "{name} did not exit normally (signal {:?}): {}", o.status.signal(), String::from_utf8_lossy(&o.stderr));
+    String::from_utf8_lossy(&o.stdout).lines().map(|s| s.to_string()).collect()
+}
+
+const E_INVALIDARG: &str = "80070057";
+
+#[test]
+fn the_rows_are_in_the_table_and_declared_in_the_header() {
+    let table = std::fs::read_to_string(manifest().join("src/imports_table.rs")).unwrap();
+    let h = std::fs::read_to_string(runtime_dir().join("fle_proc.h")).unwrap();
+    for n in ["IsProcessDPIAware", "SetThreadDpiAwarenessContext", "SetThreadDpiHostingBehavior"] {
+        let row = format!("(\"user32.dll\", \"{n}\", \"fle_imp_{n}\", \"jmp_imp:{n}\")");
+        assert_eq!(table.matches(&row).count(), 1, "{n}: exactly one row in imports_table.rs");
+        assert!(h.contains(&format!("void fle_imp_{n}(void)")), "{n} is declared in fle_proc.h");
+    }
+}
+
+#[test]
+fn the_process_is_per_monitor_dpi_aware_whatever_the_dpi() {
+    // Learn GetProcessDpiAwareness: hprocess NULL = the current process; S_OK; PROCESS_PER_MONITOR_DPI_AWARE = 2 (shellscalingapi.h); the manifest of FL64.exe: <dpiAware>True/PM</dpiAware>
+    let body = r#"
+    uint32_t v = 0xFFu;
+    uint64_t hr = CALL(fle_imp_GetProcessDpiAwareness, 0, A(&v));
+    printf("%llx %u\n", U(hr), v);
+    v = 0xFFu;
+    hr = CALL(fle_imp_GetProcessDpiAwareness, (uint64_t)-1, A(&v));
+    printf("%llx %u\n", U(hr), v);
+    v = 0xFFu;
+    hr = CALL(fle_imp_GetProcessDpiAwareness, 0x1234, A(&v));
+    printf("%llx %u\n", U(hr), v);
+    hr = CALL(fle_imp_GetProcessDpiAwareness, 0, 0);
+    printf("%llx\n", U(hr));
+    printf("%llu\n", U(CALL(fle_imp_IsProcessDPIAware, 0)));
+"#;
+    let want = ["0 2".to_string(), "0 2".to_string(), format!("{E_INVALIDARG} 255"), E_INVALIDARG.to_string(), "1".to_string()];
+    assert_eq!(run("dpi1-aware-96", &[], body), want);
+    assert_eq!(run("dpi1-aware-192", &[("FLE_SCREEN_DPI", "192")], body), want);
+}
+
+#[test]
+fn the_thread_dpi_awareness_context_is_stored_and_the_old_one_returned() {
+    // Learn SetThreadDpiAwarenessContext: the return value is the old context; an invalid context leaves the thread as it was and returns NULL. Contexts (windef.h): UNAWARE -1, SYSTEM_AWARE -2,
+    // PER_MONITOR_AWARE -3, PER_MONITOR_AWARE_V2 -4, UNAWARE_GDISCALED -5. A thread starts with the awareness of the process: -3 (per-monitor, the manifest).
+    let body = r#"
+    printf("%llx\n", U(CALL(fle_imp_SetThreadDpiAwarenessContext, (uint64_t)-4)));
+    printf("%llx\n", U(CALL(fle_imp_SetThreadDpiAwarenessContext, (uint64_t)-2)));
+    printf("%llx\n", U(CALL(fle_imp_SetThreadDpiAwarenessContext, 0)));
+    printf("%llx\n", U(CALL(fle_imp_SetThreadDpiAwarenessContext, 5)));
+    printf("%llx\n", U(CALL(fle_imp_SetThreadDpiAwarenessContext, (uint64_t)-6)));
+    printf("%llx\n", U(CALL(fle_imp_SetThreadDpiAwarenessContext, 0x1234567890ull)));
+    printf("%llx\n", U(CALL(fle_imp_SetThreadDpiAwarenessContext, (uint64_t)-1)));
+    printf("%llx\n", U(CALL(fle_imp_SetThreadDpiAwarenessContext, (uint64_t)-5)));
+    printf("%llx\n", U(CALL(fle_imp_SetThreadDpiAwarenessContext, (uint64_t)-3)));
+"#;
+    let want = ["fffffffffffffffd", "fffffffffffffffc", "0", "0", "0", "0", "fffffffffffffffe", "ffffffffffffffff", "fffffffffffffffb"];
+    assert_eq!(run("dpi1-ctx", &[], body), want);
+    // the answers of the screen do not depend on the context (S-gpu8-thread-dpi): GetProcessDpiAwareness is the process's
+    let body2 = r#"
+    uint32_t v = 0xFFu;
+    CALL(fle_imp_SetThreadDpiAwarenessContext, (uint64_t)-1);
+    CALL(fle_imp_GetProcessDpiAwareness, 0, A(&v));
+    printf("%u\n", v);
+"#;
+    assert_eq!(run("dpi1-ctx-process", &[], body2), ["2"]);
+}
+
+#[test]
+fn the_thread_dpi_hosting_behavior_is_stored_and_the_old_one_returned() {
+    // Learn SetThreadDpiHostingBehavior: the return value is the previous DPI_HOSTING_BEHAVIOR; an invalid value leaves the thread as it was and returns DPI_HOSTING_BEHAVIOR_INVALID (-1).
+    // Values (windef.h): INVALID -1, DEFAULT 0, MIXED 1. A thread starts with DEFAULT.
+    let body = r#"
+    printf("%x\n", (uint32_t)CALL(fle_imp_SetThreadDpiHostingBehavior, 1));
+    printf("%x\n", (uint32_t)CALL(fle_imp_SetThreadDpiHostingBehavior, 2));
+    printf("%x\n", (uint32_t)CALL(fle_imp_SetThreadDpiHostingBehavior, (uint32_t)-1));
+    printf("%x\n", (uint32_t)CALL(fle_imp_SetThreadDpiHostingBehavior, 0));
+    printf("%x\n", (uint32_t)CALL(fle_imp_SetThreadDpiHostingBehavior, 0));
+"#;
+    assert_eq!(run("dpi1-host", &[], body), ["0", "ffffffff", "ffffffff", "1", "0"]);
+}
