diff -ruN app/src/engine/desk-link.ts app/src/engine/desk-link.ts
--- app/src/engine/desk-link.ts	1970-01-01 09:00:00.000000000 +0900
+++ app/src/engine/desk-link.ts	2026-11-06 20:09:34.953563795 +0900
@@ -0,0 +1,99 @@
+// Decision 0311 (gpu1, PROVISIONAL, measurement tree): the link between the engine Worker and the present Worker `P` (desk-worker.ts). P owns the desktop canvas and the WebGL2 context; the engine Worker stays the only
+// place that calls the engine's exports (fle_desk_scene needs the runtime's tables). Everything that crosses is one SharedArrayBuffer:
+//   - a header of Int32 words (below) and one Float64, the single scene slot (the 6.5 KB description fle_desk_scene writes: windows, surfaces' addresses, written rectangles),
+//   - no pixel: P reads the surfaces from the engine's own (shared) linear memory, as the engine Worker did.
+// The protocol has one scene in flight: the engine publishes only when P has finished the previous one (PUB === DONE), because the rectangles `fle_desk_scene` hands out are consumed by the call (a scene that P never drew
+// would lose them); while P is busy the runtime keeps collecting what is written and the next call returns it all. P waits for PUB with Atomics.waitAsync (its event loop stays free for animation frames); the engine polls DONE,
+// WANT and the requests at the points where it already looks at the page's input ring (scheduler points and idles). Nothing here knows about windows.
+import { SCENE_HEADER_BYTES, SCENE_MAX_UPDATES, SCENE_MAX_WINDOWS, SCENE_UPD_BYTES, SCENE_WIN_BYTES } from './desk-gl.ts';
+
+export const SCENE_BYTES = SCENE_HEADER_BYTES + SCENE_MAX_WINDOWS * SCENE_WIN_BYTES + SCENE_MAX_UPDATES * SCENE_UPD_BYTES;
+
+/** Int32 word indices of the header */
+export const W = {
+  PUB: 0,            // engine: sequence number of the last published scene (the slot holds it)
+  DONE: 1,           // P: sequence number of the last scene P has finished with (drawn or found to show nothing)
+  WANT: 2,           // P: 1 = an animation frame asks for a scene; the engine clears it when it publishes (or finds nothing to publish)
+  ASLEEP: 3,         // P: 1 = the frame loop sleeps (nothing changed for a while): the engine's idle looks for the next change
+  READY: 4,          // P: 0 = starting (has not looked yet), 1 = the GL presenter exists, 2 = this platform cannot (no WebGL2 or no Atomics.waitAsync: the engine Worker keeps the desktop), 3 = it can (checked before the canvas is handed over)
+  MODE_REQ: 5,       // P: 1 = switch the runtime to the scene description (after the GL context exists)
+  MODE_ON: 6,        // engine: 1 = done
+  RESYNC_REQ: 7,     // P: 1 = send the whole picture again (a lost context, a new size)
+  RESULT: 8,         // P: rectangles shown by the scene DONE names (0: nothing changed)
+  PRESENTS: 9,       // P: presents made
+  RING_READS: 10, WAKES: 11, IDLE_TICKS: 12,   // engine counters P puts into its report
+} as const;
+export const HEADER_BYTES = 128;
+const AT_INDEX = 8;                       // Float64 index (byte 64): the instant of the last present of P (performance.timeOrigin + performance.now())
+export const LINK_BYTES = HEADER_BYTES + SCENE_BYTES;
+
+export function newDeskLink(): SharedArrayBuffer { return new SharedArrayBuffer(LINK_BYTES); }
+
+abstract class Base {
+  protected readonly i32: Int32Array;
+  protected readonly f64: Float64Array;
+  readonly buffer: SharedArrayBuffer;
+  constructor(buffer: SharedArrayBuffer) {
+    this.buffer = buffer;
+    this.i32 = new Int32Array(buffer, 0, HEADER_BYTES / 4);
+    this.f64 = new Float64Array(buffer, 0, HEADER_BYTES / 8);
+  }
+  protected get(w: number): number { return Atomics.load(this.i32, w); }
+  protected set(w: number, v: number): void { Atomics.store(this.i32, w, v); }
+  /** byte offset of the scene slot in `buffer` */
+  get slotOffset(): number { return HEADER_BYTES; }
+  get pub(): number { return this.get(W.PUB); }
+  get done(): number { return this.get(W.DONE); }
+  get ready(): number { return this.get(W.READY); }
+  get asleep(): boolean { return this.get(W.ASLEEP) !== 0; }
+  get result(): number { return this.get(W.RESULT); }
+  /** written before DONE (sequentially consistent), so a reader that has seen DONE reads the instant of that present */
+  get presentAt(): number { return this.f64[AT_INDEX] as number; }
+  get presents(): number { return this.get(W.PRESENTS); }
+  get modeOn(): boolean { return this.get(W.MODE_ON) !== 0; }
+  get wantSet(): boolean { return this.get(W.WANT) !== 0; }
+  counter(w: number): number { return this.get(w); }
+}
+
+/** the engine Worker's end */
+export class DeskLinkEngine extends Base {
+  /** P has finished the scene before: a new one may be published */
+  canPublish(): boolean { return this.get(W.PUB) === this.get(W.DONE); }
+  /** copies the description at `ptr` of the engine's memory into the slot and tells P; returns the sequence number */
+  publish(mem: ArrayBufferLike, ptr: number): number {
+    new Uint8Array(this.buffer, HEADER_BYTES, SCENE_BYTES).set(new Uint8Array(mem, ptr, SCENE_BYTES));
+    const seq = this.get(W.PUB) + 1;
+    this.set(W.PUB, seq);
+    Atomics.notify(this.i32, W.PUB);
+    return seq;
+  }
+    clearWant(): void { this.set(W.WANT, 0); }
+  modeRequested(): boolean { return this.get(W.MODE_REQ) !== 0 && this.get(W.MODE_ON) === 0; }
+  setModeOn(): void { this.set(W.MODE_ON, 1); }
+  takeResync(): boolean { return Atomics.compareExchange(this.i32, W.RESYNC_REQ, 1, 0) === 1; }
+  setCounters(ringReads: number, wakes: number, idleTicks: number): void { this.set(W.RING_READS, ringReads); this.set(W.WAKES, wakes); this.set(W.IDLE_TICKS, idleTicks); }
+}
+
+/** P's end */
+export class DeskLinkP extends Base {
+  /** resolves with the sequence number once PUB differs from `seen` */
+  async waitPublished(seen: number): Promise<number> {
+    for (;;) {
+      const p = this.get(W.PUB);
+      if (p !== seen) return p;
+      const r = (Atomics as unknown as { waitAsync(a: Int32Array, i: number, v: number): { async: boolean; value: Promise<string> | string } }).waitAsync(this.i32, W.PUB, seen);
+      if (r.async) await r.value;
+    }
+  }
+  markDone(seq: number, shown: number, at: number): void {
+    this.f64[AT_INDEX] = at;
+    this.set(W.RESULT, shown);
+    this.set(W.PRESENTS, this.get(W.PRESENTS) + (shown > 0 ? 1 : 0));
+    this.set(W.DONE, seq);
+  }
+  requestScene(): void { this.set(W.WANT, 1); }
+  setAsleep(on: boolean): void { this.set(W.ASLEEP, on ? 1 : 0); }
+  setReady(v: number): void { this.set(W.READY, v); }
+  requestMode(on: number): void { this.set(W.MODE_REQ, on); }
+  requestResync(): void { this.set(W.RESYNC_REQ, 1); }
+}
diff -ruN app/src/engine/desk-worker.ts app/src/engine/desk-worker.ts
--- app/src/engine/desk-worker.ts	1970-01-01 09:00:00.000000000 +0900
+++ app/src/engine/desk-worker.ts	2026-11-06 23:21:44.008363693 +0900
@@ -0,0 +1,133 @@
+// Decision 0311 (gpu1, PROVISIONAL, measurement tree): the present Worker `P`. It owns the desktop's OffscreenCanvas and WebGL2 context (the engine Worker hands them over when the engine has a scene description and the platform
+// gives WebGL2: worker.ts), keeps the frame loop (requestAnimationFrame of this Worker, delivered at once because nothing else runs here) and draws what the engine Worker publishes through the link (desk-link.ts) with
+// GlDeskPresenter, the same code that ran in the engine Worker before, reading the surfaces' pixels from the engine's own linear memory (texSubImage2D straight from it; no pixel is posted anywhere).
+// It decides nothing about windows: it draws the description it is given.
+import { GlDeskPresenter, webgl2Usable, type GlSurface, type SceneApi } from './desk-gl.ts';
+import { DeskLinkP } from './desk-link.ts';
+import { QuietClock } from './desk-sleep.ts';
+import { watchContextLoss, type ContextLossTarget } from './ctx-resync.ts';
+import { sha256Hex } from '../bundle/sha256.ts';
+import type { FromWorker } from './protocol.ts';
+
+declare const self: DedicatedWorkerGlobalScope;
+
+const TIME_ORIGIN = performance.timeOrigin;
+const nowAbs = (): number => TIME_ORIGIN + performance.now();
+const post = (m: FromWorker, transfer: Transferable[] = []): void => self.postMessage(m, transfer);
+const log = (level: 'info' | 'warn' | 'error', text: string): void => post({ t: 'log', level, text });
+/** when no present changed a pixel for this long the frame loop sleeps (the engine's idle finds the next change); the same value as the engine Worker had */
+const DESK_SLEEP_AFTER_MS = 100;
+
+let link: DeskLinkP | null = null;
+let port: MessagePort | null = null;
+let pres: GlDeskPresenter | null = null;
+let canvas: OffscreenCanvas | null = null;
+const quiet = new QuietClock(DESK_SLEEP_AFTER_MS, performance.now());
+let nextFrame: (() => void) | null = null;
+let frameTicks = 0;
+const presentedAt: number[] = [];
+let lastReport = 0;
+
+self.onmessage = (ev: MessageEvent<{ cmd: 'init'; link: SharedArrayBuffer; port: MessagePort }>) => {
+  const m = ev.data;
+  if (m.cmd !== 'init') return;
+  link = new DeskLinkP(m.link);
+  port = m.port;
+  // the platform decides, before the canvas is handed over: this Worker can wait on the link (Atomics.waitAsync) and gives a WebGL2 context without a major performance caveat; else the engine Worker keeps the desktop as it did
+  link.setReady(typeof (Atomics as unknown as { waitAsync?: unknown }).waitAsync === 'function' && webgl2Usable(() => new OffscreenCanvas(1, 1) as unknown as GlSurface) ? 3 : 2);
+  port.onmessage = (e: MessageEvent<{ cmd: 'handover'; canvas: OffscreenCanvas; memory: WebAssembly.Memory } | { cmd: 'readback' | 'desk-gl-read' | 'desk-peek'; key?: string; windows?: string }>) => {
+    const d = e.data;
+    if (d.cmd === 'handover') start(d.canvas, d.memory);
+    else if (d.cmd === 'readback') void readback(d.key ?? 'desk');
+    else if (d.cmd === 'desk-gl-read') glRead('desk-gl-pixels', '');
+    else if (d.cmd === 'desk-peek') glRead('desk-dump', d.windows ?? '');
+  };
+};
+
+function start(c: OffscreenCanvas, memory: WebAssembly.Memory): void {
+  const L = link as DeskLinkP;
+  canvas = c;
+  try {
+    const api: SceneApi = {
+      scene: () => L.slotOffset,
+      sceneMode: (on) => L.requestMode(on),
+      resync: () => L.requestResync(),
+      describe: () => '',
+      deferred: true,
+    };
+    pres = new GlDeskPresenter(c as unknown as GlSurface, api, () => memory.buffer, () => performance.now(), () => L.buffer);
+    const target = c as unknown as ContextLossTarget & { addEventListener(type: string, listener: (ev: Event) => void): void };
+    target.addEventListener('webglcontextlost', (ev) => { ev.preventDefault(); pres?.setLost(true); });
+    target.addEventListener('webglcontextrestored', () => { pres?.setLost(false); wake(); });
+    watchContextLoss(target, { lost: () => { pres?.resync(); wake(); }, restored: () => { pres?.resync(); wake(); } });
+  } catch (e) {
+    L.setReady(2);
+    log('error', `present Worker: ${String((e as Error)?.stack ?? e)}`);
+    return;
+  }
+  log('info', 'display method D (present Worker): the engine Worker publishes the description of the desktop (windows, positions, written rectangles); this Worker draws it with WebGL2, one texture per window, from the engine\'s memory');
+  L.setReady(1);
+  startFrameLoop();
+  void present();
+}
+
+function wake(): void { if (quiet.wake(performance.now())) { link?.setAsleep(false); nextFrame?.(); } }
+
+function startFrameLoop(): void {
+  const L = link as DeskLinkP;
+  const g = self as unknown as { requestAnimationFrame?: (cb: (t: number) => void) => number };
+  const next = (): void => { if (g.requestAnimationFrame) g.requestAnimationFrame(tick); else setTimeout(tick, 16); };
+  const tick = (): void => {
+    frameTicks++;
+    const now = performance.now();
+    L.requestScene();
+    if (quiet.sleepAfterFrame(now)) { L.setAsleep(true); return; }
+    next();
+  };
+  nextFrame = next;
+  quiet.wake(performance.now());
+  next();
+}
+
+/** draws each scene the engine Worker publishes, one at a time */
+async function present(): Promise<void> {
+  const L = link as DeskLinkP;
+  let seen = L.done;
+  for (;;) {
+    const seq = await L.waitPublished(seen);
+    seen = seq;
+    let shown = 0;
+    try { shown = pres?.present() ?? 0; } catch (e) { log('error', `desktop present failed: ${String((e as Error)?.stack ?? e)}`); }
+    const at = nowAbs();
+    if (shown > 0) {
+      presentedAt.push(at);
+      if (quiet.changed(performance.now())) { L.setAsleep(false); nextFrame?.(); }
+    }
+    L.markDone(seq, shown, at);
+    report(false);
+  }
+}
+
+function report(force: boolean): void {
+  const L = link as DeskLinkP, now = performance.now();
+  if (!pres) return;
+  if (!force && now - lastReport < 100) return;
+  if (presentedAt.length === 0 && !force && now - lastReport < 1000) return;
+  lastReport = now;
+  post({ t: 'desk', stats: { ...pres.stats, ringReads: L.counter(10), ringFull: 0, wakes: L.counter(11), ticks: frameTicks, idleTicks: L.counter(12), sleeps: quiet.sleeps }, at: presentedAt.splice(0, 64), nWindows: 0 });
+}
+
+function glRead(kind: 'desk-gl-pixels' | 'desk-dump', windows: string): void {
+  const r = pres?.readPixels();
+  if (!r) { post({ t: 'desk-dump-error', message: pres ? 'no scene has been drawn yet' : 'the desktop is not shown with WebGL (the canvas gave no WebGL2 context)' }); return; }
+  const data = r.data.buffer as ArrayBuffer;
+  if (kind === 'desk-gl-pixels') post({ t: 'desk-gl-pixels', width: r.width, height: r.height, data }, [data]);
+  else post({ t: 'desk-dump', width: r.width, height: r.height, data, windows }, [data]);
+}
+
+async function readback(key: string): Promise<void> {
+  if (key !== 'desk' || !canvas) { post({ t: 'readback-error', key, message: `no OffscreenCanvas bound to ${key}` }); return; }
+  const r = pres?.readPixels();
+  if (!r) { post({ t: 'readback-error', key, message: 'no scene has been drawn yet' }); return; }
+  post({ t: 'readback', key, width: r.width, height: r.height, sha256: await sha256Hex(r.data) });
+}
