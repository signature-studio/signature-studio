+/* gpu8 0335 TEST-ONLY diagnostic (FLE_DIAG_WIN=1; FLE_TEST_GETENV is a null constant in the product, so this is dead code there): one line per key message that is sent to a window (its lid and class), the message and the
+ * focus / active / foreground windows of its thread at that time, and one line per SetFocus / SetActiveWindow / SetForegroundWindow / GetFocus / GetActiveWindow call (the window argument and the answer). Observation only. */
+void fle_win_diag_key(const char *what, uint64_t w, uint32_t msg, uint32_t vk, unsigned thread)
+{
+    static int on = -1;
+    static unsigned n;
+    int64_t i = live_index(w);
+    uint16_t nm[FLE_CLASS_NAME_MAX_UNITS + 1], nl = 0;
+    char cls[80];
+    int64_t f, a;
+
+    if (on < 0) { const char *e = FLE_TEST_GETENV("FLE_DIAG_WIN"); on = e != NULL && e[0] == '1'; }
+    if (!on || n >= 3000u) return;
+    n++;
+    inp_ensure();
+    cls[0] = 0;
+    if (i >= 0 && fle_class_name_of(tab[i].atom, nm, &nl)) u16_ascii(cls, sizeof cls, nm, nl < 79 ? nl : 79);
+    f = thread < MAXT ? inp[thread].focus : -1;
+    a = thread < MAXT ? inp[thread].active : -1;
+    fprintf(stderr, "fl-diag: key %s thread %u msg %#x vk %#x -> lid %d class \"%s\" (focus lid %d, active lid %d, foreground lid %d)\n", what, thread, (unsigned)msg, (unsigned)vk,
+            i >= 0 ? (int)tab[i].lid : -1, cls, f >= 0 ? (int)tab[f].lid : -1, a >= 0 ? (int)tab[a].lid : -1, fg_window >= 0 ? (int)tab[fg_window].lid : -1);
+}
+
+void fle_win_diag_focus(const char *api, uint64_t arg, uint64_t answer)
+{
+    static int on = -1;
+    static unsigned n;
+    int64_t i = live_index(arg);
+    uint16_t nm[FLE_CLASS_NAME_MAX_UNITS + 1], nl = 0;
+    char cls[80];
+    unsigned t = cur_thread();
+
+    if (on < 0) { const char *e = FLE_TEST_GETENV("FLE_DIAG_WIN"); on = e != NULL && e[0] == '1'; }
+    if (!on || n >= 3000u) return;
+    n++;
+    inp_ensure();
+    cls[0] = 0;
+    if (i >= 0 && fle_class_name_of(tab[i].atom, nm, &nl)) u16_ascii(cls, sizeof cls, nm, nl < 79 ? nl : 79);
+    fprintf(stderr, "fl-diag: focus %s thread %u arg %#" PRIx64 " lid %d class \"%s\" -> answer %#" PRIx64 " (after the call: focus lid %d, active lid %d, foreground lid %d)\n", api, t, arg, i >= 0 ? (int)tab[i].lid : -1, cls, answer,
+            inp[t].focus >= 0 ? (int)tab[inp[t].focus].lid : -1, inp[t].active >= 0 ? (int)tab[inp[t].active].lid : -1, fg_window >= 0 ? (int)tab[fg_window].lid : -1);
+}
