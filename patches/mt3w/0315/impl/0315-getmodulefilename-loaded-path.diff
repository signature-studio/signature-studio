+/// decision 0315: the cases (label, path as a C string literal body) are put through fle_realmod_set_loaded_path, one module index each (the first request of a module is the only one that counts; RM_MAX is 16, so at most 16 cases per run)
+fn loaded_path_forms(name: &str, cases: &[(&str, &str)]) -> Vec<String> {
+    let mut body = String::new();
