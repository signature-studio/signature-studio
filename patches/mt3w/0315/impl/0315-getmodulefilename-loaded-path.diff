+void fle_realmod_set_loaded_path(int idx, const uint16_t *u, size_t n)
+{
+    char in[520];
+    size_t i;
+
+    if (idx < 0 || (uint64_t)idx >= fle_realmod_count || (uint64_t)idx >= RM_MAX || path_requested[idx] || n == 0 || n >= sizeof in) return;
+    path_requested[idx] = 1;   /* the module stays loaded from the FIRST request: a later request by another string does not change it, also when the first one could not be recorded */
+    for (i = 0; i < n; i++) {
+        if (u[i] == 0 || u[i] > 0x7f) return;
+        in[i] = (char)u[i];
+    }
+    if (!canon_loaded_path(in, n, loaded_path[idx])) loaded_path[idx][0] = 0;
+}
+
+const char *fle_realmod_loaded_path(int idx)
+{
+    return idx >= 0 && (uint64_t)idx < fle_realmod_count && (uint64_t)idx < RM_MAX && loaded_path[idx][0] != 0 ? loaded_path[idx] : NULL;
+}
