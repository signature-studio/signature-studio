+/* The fully qualified form of a path that LoadLibraryW was given (Learn GetModuleFileNameW: "the fully qualified path of the file that contains the specified module"; Wine 10 keeps the NT path that
+ * RtlDosPathNameToNtPathName_U made of the request: '/' is '\', ".", ".." and repeated separators are folded, the case is the one given). Only an absolute path is recorded: with a drive ("X:\...",
+ * "X:/...") or UNC ("\\server\share\..."); a name only, a relative path, a rooted path without a drive ("\x"), a drive-relative one ("X:x") and a device path ("\\.\") give no answer here (0), and
+ * GetModuleFileNameW then answers as before; so does a ".." that would leave the root. A verbatim path ("\\?\X:\..." or "\\?\UNC\...") is returned as it was given (Learn: "the same form as was specified when
+ * the module was loaded", also with the \\?\ prefix). Returns 1 and the path in out (at most in_n + 1 bytes), or 0. */
+static int canon_loaded_path(const char *in, size_t n, char *out)
+{
+    char t[520];
+    size_t starts[130];
+    size_t i, o, depth = 0;
+    int drive, unc;
+
+    if (n >= 4 && in[0] == '\\' && in[1] == '\\' && in[2] == '?' && in[3] == '\\') {
+        const char *r = in + 4;
+        size_t rn = n - 4;
+
+        drive = rn >= 3 && ((r[0] >= 'A' && r[0] <= 'Z') || (r[0] >= 'a' && r[0] <= 'z')) && r[1] == ':' && r[2] == '\\';
+        unc = rn >= 4 && (r[0] == 'U' || r[0] == 'u') && (r[1] == 'N' || r[1] == 'n') && (r[2] == 'C' || r[2] == 'c') && r[3] == '\\';
+        if (!drive && !unc) return 0;
+        memcpy(out, in, n);
+        out[n] = 0;
+        return 1;
+    }
+    for (i = 0; i < n; i++) t[i] = in[i] == '/' ? '\\' : in[i];
+    t[n] = 0;
+    if (n >= 3 && ((t[0] >= 'A' && t[0] <= 'Z') || (t[0] >= 'a' && t[0] <= 'z')) && t[1] == ':' && t[2] == '\\') {
+        memcpy(out, t, 2);   /* "X:"; every component below is added as "\name" */
+        o = 2;
+        i = 2;
+    } else if (n >= 5 && t[0] == '\\' && t[1] == '\\' && t[2] != '\\' && t[2] != '.' && t[2] != '?') {
+        size_t k = 2, m;
+
+        while (k < n && t[k] != '\\') k++;
+        if (k >= n) return 0;
+        m = k + 1;
+        while (m < n && t[m] != '\\') m++;
+        if (m == k + 1) return 0;
+        memcpy(out, t, m);   /* "\\server\share" */
+        o = m;
+        i = m;
+    } else {
+        return 0;
+    }
+    while (i < n) {
+        size_t c0, cl;
+
+        while (i < n && t[i] == '\\') i++;
+        if (i >= n) break;
+        c0 = i;
+        while (i < n && t[i] != '\\') i++;
+        cl = i - c0;
+        if (cl == 1 && t[c0] == '.') continue;
+        if (cl == 2 && t[c0] == '.' && t[c0 + 1] == '.') {
