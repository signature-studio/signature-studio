+    free(w);
+    p = fle_realmod_loaded_path(idx);
+    printf("%s %s\n", label, p ? p : "(none)");
+}}
+int main(void) {{
+{body}    return 0;
+}}"#
+        ),
+    );
+    assert_eq!(rc, 0, "{out:?}");
