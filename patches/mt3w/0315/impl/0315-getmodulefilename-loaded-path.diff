+#[test]
+fn an_absolute_path_is_folded_and_a_name_a_relative_or_a_rooted_path_is_not_recorded() {
+    // alpha1's section 19.3 table: drive + backslash or slash, UNC (also with slashes); relative, name only, rooted, drive-relative, ".." above the root, UNC without a share: not recorded
+    let out = loaded_path_forms(
+        "loaded_path_abs",
+        &[
+            ("abs", "C:\\\\a\\\\b.dll"),
+            ("fwd", "C:/a/b.dll"),
+            ("dotdot", "C:\\\\a\\\\..\\\\b\\\\.\\\\c.dll"),
+            ("dup", "C:\\\\\\\\a\\\\\\\\\\\\b.dll"),
+            ("name", "b.dll"),
+            ("rel", "a\\\\b.dll"),
+            ("dotrel", ".\\\\a\\\\b.dll"),
+            ("rooted", "\\\\a\\\\b.dll"),
+            ("driverel", "C:a\\\\b.dll"),
+            ("above-root", "C:\\\\..\\\\a.dll"),
+            ("root-only", "C:\\\\"),
+            ("unc", "\\\\\\\\server\\\\share\\\\dir\\\\..\\\\b.dll"),
+            ("unc-fwd", "//server/share/b.dll"),
+            ("unc-noshare", "\\\\\\\\server\\\\b.dll"),
+        ],
+    );
+    assert_eq!(
+        out,
+        [
+            "abs C:\\a\\b.dll",
+            "fwd C:\\a\\b.dll",
+            "dotdot C:\\b\\c.dll",
+            "dup C:\\a\\b.dll",
+            "name (none)",
+            "rel (none)",
+            "dotrel (none)",
+            "rooted (none)",
+            "driverel (none)",
+            "above-root (none)",
+            "root-only (none)",
+            "unc \\\\server\\share\\b.dll",
+            "unc-fwd \\\\server\\share\\b.dll",   // "/" is "\\" before the root is read, so "//server/share" is a UNC path as in Windows and Wine
+            "unc-noshare (none)"
+        ]
+    );
+}
