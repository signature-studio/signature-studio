index 0000000..bc3b646
--- /dev/null
+++ b/app/src/engine/chunk-io-worker.ts
@@ -0,0 +1,17 @@
+// Decision 0314 (PROVISIONAL): the I/O Worker of the lazy install tree. The engine Worker starts it (`new Worker(new URL('./chunk-io-worker.ts', import.meta.url), { type: 'module' })` as ONE expression, decision 0189) and
+// posts one message: the shared buffers of chunk-io.ts, the streams of the index and where the chunks are. The loop then serves the engine thread's requests until the engine closes the channel.
+
+import { FetchChunkStore } from './chunk-store.ts';
+import { serveChunkIo, type ChunkIoShared } from './chunk-io.ts';
+import type { VfsStream } from './vfs-index.ts';
+
+export interface ChunkIoStart { type: 'start'; shared: ChunkIoShared; streams: VfsStream[]; base: string }
+export type ChunkIoReply = { type: 'ready' } | { type: 'done'; served: number } | { type: 'error'; message: string };
+
+const scope = self as unknown as { onmessage: ((e: MessageEvent<ChunkIoStart>) => void) | null; postMessage(m: ChunkIoReply): void };
+scope.onmessage = (e) => {
+  const m = e.data;
+  if (m.type !== 'start') return;
+  scope.postMessage({ type: 'ready' });
+  serveChunkIo(m.shared, m.streams, new FetchChunkStore(m.base)).then((served) => scope.postMessage({ type: 'done', served }), (err: unknown) => scope.postMessage({ type: 'error', message: String((err as Error)?.stack ?? err) }));
+};
diff --git a/app/src/engine/chunk-io.ts b/app/src/engine/chunk-io.ts
new file mode 100644
index 0000000..24d1f2e
--- /dev/null
+++ b/app/src/engine/chunk-io.ts
@@ -0,0 +1,144 @@
+// Decision 0314 (PROVISIONAL): how the engine thread gets a chunk of the lazy install tree while a guest ReadFile is waiting for it.
+//
+// The engine is one Worker that answers libc calls SYNCHRONOUSLY (hostfiles.ts: ByteSource.readInto), and a fetch is asynchronous. So the fetch is done by a second Worker (the I/O Worker) and the engine thread
+// waits for it with Atomics.wait: no JSPI, no change of the engine wasm. The two threads share one small control block and one data buffer (SharedArrayBuffers); there is ONE request in flight at a time
+// (the engine thread is blocked while it waits, and it is the only one that asks), so a single slot is the whole protocol:
+//
+//   ctrl[STATE]  IDLE -> REQUEST (engine writes stream and chunk, notifies) -> REPLY or ERROR (I/O Worker writes length or code, notifies) -> IDLE (engine has copied the bytes out)
+//   ctrl[STREAM] ctrl[CHUNK]  the request            ctrl[LENGTH]  bytes in `data` (REPLY)            ctrl[CODE]  an error number (ERROR)
+//   CLOSE        the engine side sets it when the engine goes away; the I/O Worker's loop returns.
+//
+// The I/O Worker's loop blocks in Atomics.wait while it is idle (nothing else runs in that Worker) and is free for the promises of the fetch while it works. Atomics.waitAsync is not used: Firefox did not have it.
+
+import type { ChunkStore } from './chunk-store.ts';
+import type { VfsStream } from './vfs-index.ts';
+
+export const STATE = 0, STREAM = 1, CHUNK = 2, LENGTH = 3, CODE = 4;
+export const IDLE = 0, REQUEST = 1, REPLY = 2, ERROR = 3, CLOSE = 4;
+export const CTRL_WORDS = 8;
+
+export const ERR_STORE = 1, ERR_LENGTH = 2, ERR_REQUEST = 3;
+
+export class ChunkIoError extends Error {
+  readonly code: number;
+  constructor(code: number, what: string) { super(`The lazy install tree could not fetch a chunk: ${what}.`); this.name = 'ChunkIoError'; this.code = code; }
+}
+
+export interface ChunkIoShared { ctrl: SharedArrayBuffer; data: SharedArrayBuffer }
+
+export function makeChunkIoShared(maxChunk: number): ChunkIoShared {
+  return { ctrl: new SharedArrayBuffer(CTRL_WORDS * 4), data: new SharedArrayBuffer(maxChunk) };
+}
+
+/** what the engine thread holds: ask for a chunk and get its decoded bytes (a copy: the caller may keep it) */
+export interface ChunkClient {
+  fetchChunk(stream: number, chunk: number): Uint8Array;
+}
+
+export interface ChunkClientOptions {
+  /** how long one chunk may take before the engine gives up (the I/O Worker is gone or the network is) */
+  timeoutMs?: number;
+  /** counts, for the performance panel */
+  onFetch?: (stream: number, chunk: number, bytes: number, ms: number) => void;
+}
+
+export class SabChunkClient implements ChunkClient {
+  private readonly ctrl: Int32Array;
+  private readonly data: Uint8Array;
+  private readonly timeoutMs: number;
+  private readonly onFetch: ChunkClientOptions['onFetch'];
+  fetches = 0;
+  waitedMs = 0;
+
+  constructor(shared: ChunkIoShared, opts: ChunkClientOptions = {}) {
+    this.ctrl = new Int32Array(shared.ctrl);
+    this.data = new Uint8Array(shared.data);
+    this.timeoutMs = opts.timeoutMs ?? 60000;
+    this.onFetch = opts.onFetch;
+  }
+
+  fetchChunk(stream: number, chunk: number): Uint8Array {
+    const c = this.ctrl;
+    const t0 = performance.now();
+    if (Atomics.load(c, STATE) !== IDLE) throw new ChunkIoError(ERR_REQUEST, 'the I/O channel is not idle (a request is already in flight or the channel is closed)');
+    Atomics.store(c, STREAM, stream);
+    Atomics.store(c, CHUNK, chunk);
+    Atomics.store(c, STATE, REQUEST);
+    Atomics.notify(c, STATE);
+    const deadline = t0 + this.timeoutMs;
+    for (;;) {
+      const s = Atomics.load(c, STATE);
+      if (s !== REQUEST) break;
+      const left = deadline - performance.now();
+      if (left <= 0) {
+        Atomics.compareExchange(c, STATE, REQUEST, CLOSE);   // the channel is dead from now on: a late reply of the I/O Worker is not taken for the next request's
+        throw new ChunkIoError(ERR_STORE, `no reply for stream ${stream} chunk ${chunk} in ${this.timeoutMs} ms`);
+      }
+      Atomics.wait(c, STATE, REQUEST, Math.min(left, 1000));
+    }
+    const state = Atomics.load(c, STATE);
+    if (state === ERROR) {
+      const code = Atomics.load(c, CODE);
+      Atomics.store(c, STATE, IDLE);
+      throw new ChunkIoError(code, `the store answered an error (code ${code}) for stream ${stream} chunk ${chunk}`);
+    }
+    if (state !== REPLY) throw new ChunkIoError(ERR_REQUEST, `the I/O channel was closed (state ${state})`);
+    const n = Atomics.load(c, LENGTH);
+    const out = new Uint8Array(n);
+    out.set(this.data.subarray(0, n));
+    Atomics.store(c, STATE, IDLE);
+    const ms = performance.now() - t0;
+    this.fetches++;
+    this.waitedMs += ms;
+    this.onFetch?.(stream, chunk, n, ms);
+    return out;
+  }
+
+  /** the engine goes away: the I/O Worker's loop returns */
+  close(): void {
+    Atomics.store(this.ctrl, STATE, CLOSE);
+    Atomics.notify(this.ctrl, STATE);
+  }
+}
+
+/** the length the chunk `chunk` of the stream must have */
+export function chunkLength(s: VfsStream, chunk: number): number {
+  return Math.min(s.chunkSize, s.logical - chunk * s.chunkSize);
+}
+
+/**
+ * The I/O Worker's loop. Serves requests until the engine side closes the channel. `store` gives the decoded bytes of a chunk; their length is checked here against the index (a chunk of the wrong size is an error, not a short read).
+ * Returns the number of requests it served.
+ */
+export async function serveChunkIo(shared: ChunkIoShared, streams: readonly VfsStream[], store: ChunkStore): Promise<number> {
+  const c = new Int32Array(shared.ctrl);
+  const data = new Uint8Array(shared.data);
+  let served = 0;
+  for (;;) {
+    let s = Atomics.load(c, STATE);
+    while (s !== REQUEST) {
+      if (s === CLOSE) return served;
+      Atomics.wait(c, STATE, s);
+      s = Atomics.load(c, STATE);
+    }
+    const si = Atomics.load(c, STREAM), ci = Atomics.load(c, CHUNK);
+    let code = 0, len = 0;
+    const st = streams[si];
+    if (!st || ci < 0 || ci >= st.chunks.length) code = ERR_REQUEST;
+    else {
+      try {
+        const want = chunkLength(st, ci);
+        const bytes = await store.get(st.chunks[ci] as string, st.coding, want);
+        if (bytes.length !== want || bytes.length > data.length) code = ERR_LENGTH;
+        else { data.set(bytes); len = bytes.length; }
+      } catch {
+        code = ERR_STORE;
+      }
+    }
+    if (Atomics.load(c, STATE) !== REQUEST) continue;   // the engine gave up (timeout) or closed while the fetch ran: nobody waits for this reply
+    if (code) { Atomics.store(c, CODE, code); Atomics.store(c, STATE, ERROR); }
+    else { Atomics.store(c, LENGTH, len); Atomics.store(c, STATE, REPLY); }
+    Atomics.notify(c, STATE);
+    served++;
+  }
+}
diff --git a/app/src/engine/chunk-store.ts b/app/src/engine/chunk-store.ts
new file mode 100644
index 0000000..f54e8ac
--- /dev/null
+++ b/app/src/engine/chunk-store.ts
@@ -0,0 +1,61 @@
+// Decision 0314 (PROVISIONAL): where the chunks of the lazy install tree come from. A chunk is an immutable object `vfs/<SHA-256 of its decoded bytes>.chk`; a brotli stream's objects are stored encoded and served with
+// Content-Encoding: br, so fetch() hands the page the DECODED bytes, whose SHA-256 is the name (docs/decisions/0314-lazy-install-tree.md 'Format'). Every chunk is checked against its name before anyone sees it.
+
+export interface ChunkStore {
+  /** the decoded bytes of the chunk named `sha` (lower-case hex of the SHA-256 of those bytes); `coding` 0 identity, 1 brotli; `length` is what the index says they must be */
+  get(sha: string, coding: 0 | 1, length: number): Promise<Uint8Array>;
+}
+
+export class ChunkStoreError extends Error {
+  constructor(what: string) { super(what); this.name = 'ChunkStoreError'; }
+}
+
+export async function sha256Hex(bytes: Uint8Array): Promise<string> {
+  const d = new Uint8Array(await crypto.subtle.digest('SHA-256', bytes as Uint8Array<ArrayBuffer>));
+  let s = '';
+  for (const x of d) s += x.toString(16).padStart(2, '0');
+  return s;
+}
+
+export interface FetchChunkStoreOptions {
+  /** how many times a chunk is asked for when the network fails or the bytes do not hash to their name (the later tries bypass the HTTP cache) */
+  attempts?: number;
+  fetchFn?: typeof fetch;
+}
+
+/** the chunks as objects of a URL prefix: `${base}vfs/${sha}.chk` (the base ends with a slash) */
+export class FetchChunkStore implements ChunkStore {
+  private readonly base: string;
+  private readonly attempts: number;
+  private readonly fetchFn: typeof fetch;
+  fetched = 0;
+  bytes = 0;
+  retries = 0;
+
+  constructor(base: string, opts: FetchChunkStoreOptions = {}) {
+    this.base = base.endsWith('/') ? base : `${base}/`;
+    this.attempts = opts.attempts ?? 3;
+    this.fetchFn = opts.fetchFn ?? ((...a) => fetch(...a));
+  }
+
+  async get(sha: string, _coding: 0 | 1, length: number): Promise<Uint8Array> {
+    if (!/^[0-9a-f]{64}$/.test(sha)) throw new ChunkStoreError(`${sha} is not a SHA-256`);
+    let last = 'no try';
+    for (let k = 0; k < this.attempts; k++) {
+      if (k > 0) this.retries++;
+      try {
+        const r = await this.fetchFn(`${this.base}vfs/${sha}.chk`, k === 0 ? {} : { cache: 'reload' });
+        if (!r.ok) { last = `HTTP ${r.status}`; continue; }
+        const b = new Uint8Array(await r.arrayBuffer());
+        if (b.length !== length) { last = `${b.length} bytes, the index says ${length}`; continue; }
+        if ((await sha256Hex(b)) !== sha) { last = 'the bytes do not hash to the name of the object'; continue; }
+        this.fetched++;
+        this.bytes += b.length;
+        return b;
+      } catch (e) {
+        last = String((e as Error)?.message ?? e);
+      }
+    }
+    throw new ChunkStoreError(`chunk ${sha}: ${last} (after ${this.attempts} tries)`);
+  }
+}
diff --git a/app/src/engine/chunked-source.ts b/app/src/engine/chunked-source.ts
new file mode 100644
index 0000000..2caea8a
--- /dev/null
+++ b/app/src/engine/chunked-source.ts
@@ -0,0 +1,86 @@
+// Decision 0314 (PROVISIONAL): a stream of the lazy install tree as a ByteSource (hostfiles.ts): the logical bytes of the stream, read synchronously. A read that needs a chunk the page does not hold asks the ChunkClient
+// (chunk-io.ts: the engine thread waits for the I/O Worker); the decoded chunks are kept in a small LRU shared by all the streams, so a file read in pieces is one fetch.
+
+import type { ByteSource } from './hostfiles.ts';
+import type { ChunkClient } from './chunk-io.ts';
+import type { VfsStream } from './vfs-index.ts';
+
+export interface ChunkCacheStats { hits: number; misses: number; evictions: number; heldBytes: number; fetchedBytes: number }
+
+/** decoded chunks by (stream, chunk), least recently used out first when the held bytes pass the budget */
+export class ChunkCache {
+  private readonly map = new Map<number, Uint8Array>();   // insertion order = recency
+  readonly stats: ChunkCacheStats = { hits: 0, misses: 0, evictions: 0, heldBytes: 0, fetchedBytes: 0 };
+  readonly budget: number;
+
+  constructor(budgetBytes: number) { this.budget = budgetBytes; }
+
+  static key(stream: number, chunk: number): number { return stream * 0x1000000 + chunk; }   // 16 streams x 16 M chunks (a stream is at most 16 M x 8 MiB)
+
+  get(key: number): Uint8Array | undefined {
+    const v = this.map.get(key);
+    if (v === undefined) return undefined;
+    this.map.delete(key);
+    this.map.set(key, v);
+    this.stats.hits++;
+    return v;
+  }
+
+  put(key: number, bytes: Uint8Array): void {
+    this.stats.misses++;
+    this.stats.fetchedBytes += bytes.length;
+    const old = this.map.get(key);
+    if (old) { this.stats.heldBytes -= old.length; this.map.delete(key); }
+    this.map.set(key, bytes);
+    this.stats.heldBytes += bytes.length;
+    while (this.stats.heldBytes > this.budget && this.map.size > 1) {   // the chunk just put always stays
+      const first = this.map.keys().next().value as number;
+      const v = this.map.get(first) as Uint8Array;
+      this.map.delete(first);
+      this.stats.heldBytes -= v.length;
+      this.stats.evictions++;
+    }
+  }
+}
+
+export class ChunkedSource implements ByteSource {
+  private readonly stream: VfsStream;
+  private readonly index: number;
+  private readonly client: ChunkClient;
+  private readonly cache: ChunkCache;
+
+  constructor(stream: VfsStream, index: number, client: ChunkClient, cache: ChunkCache) {
+    this.stream = stream;
+    this.index = index;
+    this.client = client;
+    this.cache = cache;
+  }
+
+  get size(): number { return this.stream.logical; }
+
+  private chunk(c: number): Uint8Array {
+    const key = ChunkCache.key(this.index, c);
+    const hit = this.cache.get(key);
+    if (hit) return hit;
+    const b = this.client.fetchChunk(this.index, c);
+    this.cache.put(key, b);
+    return b;
+  }
+
+  readInto(dst: Uint8Array, at: number): number {
+    const s = this.stream;
+    if (at >= s.logical || dst.length === 0) return 0;
+    const n = Math.min(dst.length, s.logical - at);
+    let done = 0;
+    while (done < n) {
+      const pos = at + done;
+      const c = Math.floor(pos / s.chunkSize), inChunk = pos - c * s.chunkSize;
+      const b = this.chunk(c);
+      const take = Math.min(n - done, b.length - inChunk);
+      if (take <= 0) throw new Error(`stream ${s.name} chunk ${c} is ${b.length} bytes, the read needs byte ${inChunk}`);
+      dst.set(b.subarray(inChunk, inChunk + take), done);
+      done += take;
+    }
+    return n;
+  }
+}
