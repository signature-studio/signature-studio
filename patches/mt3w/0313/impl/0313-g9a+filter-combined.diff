diff -ruN tree-g9-base/lift/harness/b2d2/realmod_tables.awk tree-g9f/lift/harness/b2d2/realmod_tables.awk
--- tree-g9-base/lift/harness/b2d2/realmod_tables.awk	1970-01-01 09:00:00.000000000 +0900
+++ tree-g9f/lift/harness/b2d2/realmod_tables.awk	2026-11-07 01:11:19.323540121 +0900
@@ -0,0 +1,23 @@
+# Decision 0313 (G9-a): the realmod tables of lift/harness/b2d2/gen-direct.sh (it was an inline awk program; a file so that ci/test-hybrid.sh can run it on a synthetic modules.txt).
+# usage: awk -F'|' -v rm="m1=<name>;m2=<name>..." -v pm="m8=<path suffix with / for the separator>;..." -f realmod_tables.awk modules.txt
+#   modules.txt: lines "mK|<file>|<base>|<arguments>||<per part>" (gen_two.sh). Output: C for the runtime: fle_realmod_table / fle_realmod_count (name, base), and when pm has rows, fle_realmod_path_table / fle_realmod_path_count
+#   (decision 0183: a plugin is opened by LoadLibraryW of its full path; fle_realmod_find_path matches the lower-case suffix). Without rows no path table is written: the weak (empty) one of fle_realmod.c stays.
+#   The suffix has "/" in pm and a backslash in the C string (two characters "\\"); no gsub: the awks (mawk, gawk) differ on the escapes of its replacement.
+BEGIN {
+  print "/* generated by lift/harness/b2d2/gen-direct.sh from modules.txt as lift/harness/two/build_two_native.sh does */";
+  print "#include \"fle_realmod.h\"";
+  print "const fle_realmod_entry fle_realmod_table[] = {";
+  np = split(rm, pairs, ";"); for (i = 1; i <= np; i++) { split(pairs[i], kv, "="); nm[kv[1]] = kv[2] }
+  bs = sprintf("%c", 92)
+}
+$1 != "" { printf "    { \"%s\", UINT64_C(%s) },\n", nm[$1], $3; n++ }
+END {
+  print "};"; print "const uint64_t fle_realmod_count = " n ";";
+  np2 = split(pm, pp, ";"); m = 0; rows = "";
+  for (i = 1; i <= np2; i++) {
+    if (pp[i] == "") continue;
+    split(pp[i], kv, "="); ns = split(kv[2], parts, "/"); s = parts[1]; for (j = 2; j <= ns; j++) s = s bs bs parts[j];
+    rows = rows sprintf("    { \"%s\", \"%s\" },\n", s, nm[kv[1]]); m++
+  }
+  if (m > 0) { print "const fle_realmod_path_entry fle_realmod_path_table[] = {"; printf "%s", rows; print "};"; print "const uint64_t fle_realmod_path_count = " m ";" }
+}
