diff -ruN a/lift/runtime/fle_callback.c b/lift/runtime/fle_callback.c
--- a/lift/runtime/fle_callback.c
+++ b/lift/runtime/fle_callback.c
@@ -74,3 +74,92 @@
     result = R[0];
     return result;
 }
+
+/* 0313 TEST-ONLY diagnostic (diag-g9-gui.diff; never pushed; supersedes diag-g9-count.diff). Observation only: it changes nothing the guest sees (no register, no memory, no return value is written; the real function runs
+ * as before). Everything is printed to stderr as "g9-diag: ..." lines.
+ *  (1) fle_dispatch_hook (the census hook of decision 0097, it only observes and calls fn itself): the indirect calls that the guest makes INTO the image slot of the real modules Fruity Balance / Fruity Filter
+ *      (0x6800000..0x7400000): the first 64 calls with the target and rcx/rdx/r8/r9 (for the plug-in's Dispatcher(Self, ID, Index, Value) that is the ID in rdx and the parent window in r9: ID 0 = FPD_ShowEditor), the first 16
+ *      distinct targets, and the count at every power of two.
+ *  (2) the Win32 calls of the GUI that the guest code of those images makes (the return address on the guest stack is inside the image slot): name, arguments, result, and the number of drawing calls the raster layer
+ *      discarded so far (S-draw-hidden, fle_raster_discarded_count). The wrappers are installed by the linker (--wrap=fle_imp_NAME in lift/harness/web/fruity/link-web.sh): the other callers are not seen at all.
+ * At most G9_API_MAX lines of (2). */
+#include "fle_raster.h"
+#define G9_LO UINT64_C(0x6800000)
+#define G9_HI UINT64_C(0x7400000)
+#define G9_API_MAX 600u
+static uint64_t g9_n, g9_seen[16], g9_api_lines;
+static unsigned g9_nd;
+static int g9_from_image(void) { uint64_t ra = fle_ld(R[4], 8); return ra >= G9_LO && ra < G9_HI; }
+static void g9_hook(uint64_t va, void (*fn)(void))
+{
+    if (va >= G9_LO && va < G9_HI) {
+        uint64_t n = __atomic_add_fetch(&g9_n, 1, __ATOMIC_RELAXED);
+        unsigned i;
+        for (i = 0; i < g9_nd && i < 16 && g9_seen[i] != va; i++) {}
+        if (i == g9_nd && g9_nd < 16) {
+            g9_seen[g9_nd++] = va;
+            fprintf(stderr, "g9-diag: first call into the plug-in image at %#llx (call #%llu)\n", (unsigned long long)va, (unsigned long long)n);
+        }
+        if (n <= 64) fprintf(stderr, "g9-diag: call #%llu into the image: target %#llx rcx %#llx rdx %#llx r8 %#llx r9 %#llx\n", (unsigned long long)n, (unsigned long long)va,
+                             (unsigned long long)R[1], (unsigned long long)R[2], (unsigned long long)R[8], (unsigned long long)R[9]);
+        if ((n & (n - 1)) == 0) fprintf(stderr, "g9-diag: %llu indirect calls into the plug-in image so far (distinct targets seen, up to 16: %u)\n", (unsigned long long)n, g9_nd);
+    }
+    fn();
+}
+__attribute__((constructor)) static void g9_gui_init(void) { fle_dispatch_hook = g9_hook; }
+
+#define G9_API(NAME, EXTRA) \
+    void __real_fle_imp_##NAME(void); \
+    void __wrap_fle_imp_##NAME(void) \
+    { \
+        int on = g9_from_image() && g9_api_lines < G9_API_MAX; \
+        if (on) { \
+            g9_api_lines++; \
+            fprintf(stderr, "g9-diag: API " #NAME " rcx %#llx rdx %#llx r8 %#llx r9 %#llx" EXTRA "\n", (unsigned long long)R[1], (unsigned long long)R[2], (unsigned long long)R[8], (unsigned long long)R[9]); \
+        } \
+        __real_fle_imp_##NAME(); \
+        if (on) fprintf(stderr, "g9-diag: API " #NAME " -> %#llx (discarded drawing calls so far %llu)\n", (unsigned long long)R[0], (unsigned long long)fle_raster_discarded_count()); \
+    }
+/* The four functions the hybrid's direct code imports by name (hyb/exports.rsp: SetWindowPos, BeginPaint, EndPaint, BitBlt) cannot be wrapped by the linker: --wrap moves the EXPORT to the name __wrap_fle_imp_NAME and the direct code
+ * then imports a name nobody exports (build #1: 'the merged module still imports functions of the module c'). Their wrapper is therefore a function of the same name here, and the real function is renamed in its own file
+ * (fle_win.c, fle_gdi.c: fle_imp_NAME_g9orig). The direct code's calls are seen as well. */
+#define G9_API_INSRC(NAME, EXTRA) \
+    void fle_imp_##NAME##_g9orig(void); \
+    void fle_imp_##NAME(void) \
+    { \
+        int on = g9_from_image() && g9_api_lines < G9_API_MAX; \
+        if (on) { \
+            g9_api_lines++; \
+            fprintf(stderr, "g9-diag: API " #NAME " rcx %#llx rdx %#llx r8 %#llx r9 %#llx" EXTRA "\n", (unsigned long long)R[1], (unsigned long long)R[2], (unsigned long long)R[8], (unsigned long long)R[9]); \
+        } \
+        fle_imp_##NAME##_g9orig(); \
+        if (on) fprintf(stderr, "g9-diag: API " #NAME " -> %#llx (discarded drawing calls so far %llu)\n", (unsigned long long)R[0], (unsigned long long)fle_raster_discarded_count()); \
+    }
+void __real_fle_imp_CreateWindowExW(void);
+void __wrap_fle_imp_CreateWindowExW(void)
+{
+    int on = g9_from_image() && g9_api_lines < G9_API_MAX;
+    if (on) {
+        g9_api_lines++;
+        fprintf(stderr, "g9-diag: API CreateWindowExW exstyle %#llx class %#llx name %#llx style %#llx x %d y %d w %d h %d parent %#llx\n", (unsigned long long)R[1], (unsigned long long)R[2], (unsigned long long)R[8],
+                (unsigned long long)R[9], (int)(uint32_t)fle_arg(5), (int)(uint32_t)fle_arg(6), (int)(uint32_t)fle_arg(7), (int)(uint32_t)fle_arg(8), (unsigned long long)fle_arg(9));
+    }
+    __real_fle_imp_CreateWindowExW();
+    if (on) fprintf(stderr, "g9-diag: API CreateWindowExW -> %#llx\n", (unsigned long long)R[0]);
+}
+G9_API(DestroyWindow, "")
+G9_API(SetParent, "")
+G9_API(ShowWindow, "")
+G9_API_INSRC(SetWindowPos, "")
+G9_API(MoveWindow, "")
+G9_API(RegisterClassW, "")
+G9_API(SetWindowLongPtrW, "")
+G9_API(InvalidateRect, "")
+G9_API(UpdateWindow, "")
+G9_API_INSRC(BeginPaint, "")
+G9_API_INSRC(EndPaint, "")
+G9_API_INSRC(BitBlt, "")
+G9_API(StretchBlt, "")
+G9_API(RaiseException, "")
+G9_API(FindResourceW, "")
+G9_API(LoadResource, "")
