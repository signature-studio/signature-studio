index 0000000..0ade862
--- /dev/null
+++ b/lift/harness/mt2/node-bundle-run-rt.mjs
@@ -0,0 +1,126 @@
+// mt3 (decision 0234, stage 2 spike): lift/harness/mt2/node-bundle-run-sh.mjs for a GIL build (FLE_WORKERS=2): the engine's second Worker is an emscripten pthread, which the glue starts with `new Worker(...)`; node has no such class, so
+// `globalThis.Worker` here is a thin class over worker_threads that runs rt-worker-shim.mjs (the glue copy again, in pthread mode). Differences to node-bundle-run-sh.mjs: the Worker class, the exit (the pthread keeps node alive, so the
+// driver ends the process when the engine ends or when FLE_RT_MAX_S seconds have passed), and a progress line to stderr every 10 s. usage as node-bundle-run-sh.mjs; env FLE_WORKERS=2 is passed to the guest environment by the caller (K=V).
+import fs from 'node:fs';
+import path from 'node:path';
+import { pathToFileURL } from 'node:url';
+import { Worker as NodeWorker } from 'node:worker_threads';
+
+const [bundle, seedPackFile, scriptFile, outDir, ...kv] = process.argv.slice(2);
+if (!outDir) { console.error('usage: node --experimental-wasm-jspi node-bundle-run-rt.mjs BUNDLE_DIR SEED_PACK SCRIPT OUT_DIR [KEY=VALUE ...]'); process.exit(2); }
+fs.mkdirSync(outDir, { recursive: true });
+const man = JSON.parse(fs.readFileSync(path.join(bundle, 'manifest.json'), 'utf8'));
+const asset = (ref) => path.join(bundle, path.basename(ref.url));
+const glueFile = asset(man.engine.options.glue);
+const wasmFile = asset(man.engine.wasm);
+const dllPackFile = asset(man.dllPack);
+const glueCopy = path.join(outDir, 'engine-glue.mjs');
+// This driver's bundle has a filesystem (MEMFS for the seed files); the glue then sends a pthread's write(2) to the first Worker and WAITS for it (proxyToMainThread, sync). The second Worker holds the giant lock while it prints, and the first Worker
+// serves the call only when it waits for the lock: the call is made local here (the bytes go to the print handlers, which are forwarded without a wait). The shipped bundle has no filesystem and prints that way already.
+const FDW_OLD = 'if (ENVIRONMENT_IS_PTHREAD) return proxyToMainThread(16, 0, 1, fd, iov, iovcnt, pnum);';
+const FDW_NEW = 'if (ENVIRONMENT_IS_PTHREAD) { var total = 0, text = ""; for (var i = 0; i < iovcnt; i++, iov += 8) { var ptr = (growMemViews(), HEAPU32)[((iov) >> 2)]; var len = (growMemViews(), HEAPU32)[(((iov) + (4)) >> 2)]; text += new TextDecoder().decode((growMemViews(), HEAPU8).slice(ptr, ptr + len)); total += len; } if (fd === 1 || fd === 2) (fd === 2 ? err : out)(text.replace(/\\n$/, "")); (growMemViews(), HEAPU32)[((pnum) >> 2)] = total; return 0; }';
+fs.writeFileSync(glueCopy, fs.readFileSync(glueFile, 'utf8').replace(FDW_OLD, FDW_NEW).replace("if (typeof process !== 'undefined' && !process.versions?.bun && typeof Deno == \"undefined\") {", 'if (false) {').replace('if (typeof process !== "undefined" && !process.versions?.bun && typeof Deno == "undefined") {', 'if (false) {').replace('globalThis.process?.versions?.node && globalThis.process?.type != "renderer"', 'false').replace("globalThis.process?.versions?.node && globalThis.process?.type != 'renderer'", 'false'));
+const root = man.engine.options.root || '/data';
+const shimFile = new URL('./rt-worker-shim.mjs', import.meta.url);
+
+class WebWorker {
+  constructor(url, opts) {
+    this._w = new NodeWorker(shimFile, { workerData: { dbg: path.join(outDir, 'dbg.log'), log: path.join(outDir, 'shim.log'), glue: pathToFileURL(glueCopy).href, name: (opts && opts.name) || '' }, stdout: false, stderr: false });
+    this.onmessage = null; this.onerror = null;
+    this._w.on('message', (d) => { if (d && d.fleShimError) { err.write('[shim] ' + d.fleShimError + '\n'); return; } if (this.onmessage) this.onmessage({ data: d }); });
+    this._w.on('error', (e) => { err.write('[worker error] ' + String((e && e.stack) || e) + '\n'); if (this.onerror) this.onerror(e); });
+    this._w.on('exit', (c) => { err.write('[worker exit] ' + c + '\n'); setTimeout(() => finish('worker exit ' + c), 2000); });
+  }
+  postMessage(m, t) { try { fs.appendFileSync(path.join(outDir, 'shim.log'), '[main] postMessage cmd=' + (m && m.cmd) + '\n'); } catch {} this._w.postMessage(m, t || []); }
+  terminate() { return this._w.terminate(); }
+}
+globalThis.Worker = WebWorker;
+globalThis.__fleDbg = (m) => { try { fs.appendFileSync(path.join(outDir, 'dbg.log'), '[' + new Date().toISOString().slice(14, 23) + '] ' + m + '\n'); } catch {} };
+
+function parseFlpack1(b) {
+  const dv = new DataView(b.buffer, b.byteOffset, b.byteLength);
+  if (String.fromCharCode(...b.subarray(0, 4)) !== 'FLPK') throw new Error('dll pack: bad magic');
+  const il = dv.getUint32(8, true);
+  const idx = JSON.parse(new TextDecoder().decode(b.subarray(12, 12 + il)));
+  return idx.files.map((f) => ({ path: f.path, data: b.subarray(12 + il + f.offset, 12 + il + f.offset + f.size) }));
+}
+function parseSeed(b) {
+  const dv = new DataView(b.buffer, b.byteOffset, b.byteLength);
+  if (String.fromCharCode(...b.subarray(0, 8)) !== 'FLSEEDP1') throw new Error('seed pack: bad magic');
+  const hl = dv.getUint32(8, true);
+  const h = JSON.parse(new TextDecoder().decode(b.subarray(12, 12 + hl)));
+  return h.files.map((f) => ({ path: f.path, data: b.subarray(12 + hl + f.offset, 12 + hl + f.offset + f.size) }));
+}
+const dllFiles = parseFlpack1(new Uint8Array(fs.readFileSync(dllPackFile)));
+const seedFiles = parseSeed(new Uint8Array(fs.readFileSync(seedPackFile)));
+const script = fs.readFileSync(scriptFile);
+const wasmBytes = fs.readFileSync(wasmFile);
+
+const env = Object.assign({}, man.engine.env);
+env.FLE_VFS_SEED = root + '/seed/vfs-seed-base.tsv';
+env.FLE_G3_SCRIPT = root + '/script.g3';
+env.FLE_G3_PROGRESS = '1';
+env.FLE_FRUITY_SECONDS = '36000';
+env.FLE_FRUITY_MAX_CALLS = '400000000000';
+for (const a of kv) { const i = a.indexOf('='); env[a.slice(0, i)] = a.slice(i + 1); }
+const maxS = Number(process.env.FLE_RT_MAX_S || 0);
+
+// synchronous writes: the first Worker can block in the engine (the lock, a futex) without returning to node's event loop, and a stream would then lose what was printed before
+const mkSink = (f) => { const fd = fs.openSync(f, 'w'); return { write: (t) => { try { fs.writeSync(fd, t); } catch {} }, end: (cb) => { try { fs.closeSync(fd); } catch {} if (cb) cb(); } }; };
+const out = mkSink(path.join(outDir, 'stdout.txt'));
+const err = mkSink(path.join(outDir, 'stderr.txt'));
+// a watchdog in its own thread: the process is killed when the run has not ended maxS + 20 s after its start (a blocked first Worker has no event loop to notice)
+if (maxS > 0) new NodeWorker('const cp = require("child_process"), fs = require("fs"); const top = (n) => { try { fs.writeFileSync(' + JSON.stringify(path.join(outDir, 'top-')) + ' + n + ".txt", cp.spawnSync("top", ["-b", "-n", "2", "-d", "2", "-H", "-p", String(process.pid)], { encoding: "utf8" }).stdout); } catch (e) {} }; setTimeout(() => top(1), ' + (Math.max(6, maxS / 2) * 1000) + '); setTimeout(() => { if (process.env.FLE_RT_REPORT) process.kill(process.pid, "SIGUSR2"); }, 15000); setTimeout(() => { if (process.env.FLE_RT_REPORT) process.kill(process.pid, "SIGUSR2"); }, 25000); setTimeout(() => { if (process.env.FLE_RT_GDB) process.kill(process.pid, "SIGINT"); }, ' + (Math.max(8, maxS - 5) * 1000) + '); setTimeout(() => process.kill(process.pid, "SIGKILL"), ' + ((maxS + 30) * 1000) + ');', { eval: true }).unref();   // FLE_RT_GDB=1: the run is under gdb (nrun-rt.sh) and this SIGINT stops it for the backtraces of all threads
+let memory = null, exitCode = null, prunedLines = 0, stopLines = [], lastOut = Date.now(), nOut = 0, ended = false;
+const t0 = Date.now();
+const opts = {
+  arguments: man.engine.args,
+  print: (l) => { lastOut = Date.now(); nOut++; out.write(l + '\n'); if (/pruned function/.test(l)) prunedLines++; if (/^fruity: == stop/.test(l)) stopLines.push(l); },
+  printErr: (l) => { err.write(l + '\n'); if (/pruned function/.test(l)) prunedLines++; },
+  onExit: (c) => { exitCode = c; finish('onExit ' + c); },
+  onAbort: (w) => { err.write('onAbort: ' + w + '\n'); finish('abort'); },
+  fleProgress: () => {},
+  fleIdle: () => {},
+  fleSurfaceEvent: () => {},
+  fleThreadFailed: (i, e, m) => err.write('[js] ' + m + '\n'),
+  preRun: [() => {
+    const FS = opts.FS;
+    const put = (g, d) => { FS.mkdirTree(g.slice(0, g.lastIndexOf('/'))); FS.writeFile(g, d, { canOwn: false }); };
+    for (const f of dllFiles) put(root + '/' + f.path, f.data);
+    for (const f of seedFiles) put(root + '/' + f.path, f.data);
+    put(root + '/script.g3', script);
+    if (process.env.PARITY_SEED_TSV) {
+      const repo = process.env.PARITY_REPO;
+      put(root + '/seed/parity-seed.tsv', fs.readFileSync(process.env.PARITY_SEED_TSV));
+      for (const ln of fs.readFileSync(process.env.PARITY_SEED_TSV, 'utf8').split('\n')) {
+        if (!ln || ln.startsWith('#')) continue;
+        const f = ln.split('\t'); if (f.length < 2 || f[1] === '-') continue;
+        const g = root + '/seed/' + f[1];
+        try { FS.stat(g); } catch { try { put(g, fs.readFileSync(path.join(repo, f[1]))); } catch (e) { err.write('parity1: cannot add ' + f[1] + ': ' + e.message + '\n'); } }
+      }
+      env.FLE_VFS_SEED = root + '/seed/parity-seed.tsv';
+    }
+    for (const k of Object.keys(env)) opts.ENV[k] = env[k];
+  }],
+  instantiateWasm(imports, done) {
+    WebAssembly.compile(wasmBytes).then((m) => WebAssembly.instantiate(m, imports).then((inst) => { memory = inst.exports.memory || imports.env.memory; done(inst, m); }))
+      .catch((e) => { err.write('wasm compile/instantiate failed: ' + (e && e.stack || e) + '\n'); process.exitCode = 99; });
+    return {};
+  },
+};
+let error = null;
+const mkSummary = (why) => ({ bundle: path.basename(bundle), wasm: path.basename(wasmFile), script: path.basename(scriptFile), exitCode, why, error, prunedLines, stopLines, wallSeconds: (Date.now() - t0) / 1000, stdoutLines: nOut, extraEnv: kv });
+function finish(why) {
+  if (ended) return;
+  ended = true;
+  try { fs.writeFileSync(path.join(outDir, 'summary.json'), JSON.stringify(mkSummary(why), null, 1)); } catch {}
+  let n = 2;
+  const done = () => { if (--n === 0) process.exit(exitCode ?? 0); };
+  out.end(done); err.end(done);
+}
+if (maxS > 0) setInterval(() => { err.write('[rt] t=' + ((Date.now() - t0) / 1000).toFixed(0) + ' s, stdout lines ' + nOut + ', last stdout ' + ((Date.now() - lastOut) / 1000).toFixed(0) + ' s ago\n'); if ((Date.now() - t0) / 1000 > maxS) finish('time limit ' + maxS + ' s'); }, 10000);
+globalThis.WorkerGlobalScope = globalThis.WorkerGlobalScope || class WorkerGlobalScope {};
+try {
+  const { default: Module } = await import(pathToFileURL(glueCopy).href);
+  await Module(opts);
+} catch (e) { error = String((e && e.stack) || e); err.write('driver caught: ' + error + '\n'); }
diff --git a/lift/harness/mt2/rt-worker-shim.mjs b/lift/harness/mt2/rt-worker-shim.mjs
