+#!/bin/bash
+# decision 0312: builds the engine's audio transport for node and runs tp_test.mjs. usage: run.sh [OUTDIR]
+set -eu
+export PATH=$PATH:/opt/emsdk/upstream/emscripten:/opt/emsdk/node/24.19.0_64bit/bin
+H=$(cd "$(dirname "$0")" && pwd); RT=$H/../../../runtime; O=${1:-/tmp/opencode/tp_wasm}; mkdir -p "$O"
+emcc -O1 -Wall -Wextra -Wno-unused-parameter -I "$RT" "$H/tp_test.c" "$RT/fle_audio_transport.c" -o "$O/tp_test.mjs" \
+  -sMODULARIZE=1 -sEXPORT_ES6=1 -sENVIRONMENT=node -sASYNCIFY=1 -sALLOW_MEMORY_GROWTH=0 -sINITIAL_MEMORY=64MB -sEXPORTED_RUNTIME_METHODS=HEAPU8 \
+  -sEXPORTED_FUNCTIONS=_t_external,_t_publish,_t_rewrite,_t_consumed,_t_state,_t_unlock,_t_switch,_t_alloc,_malloc
+node "$H/tp_test.mjs" "$O/tp_test.mjs"
+# the two-pthread test: a second build with pthreads and JSPI (the product's form)
+emcc -O1 -pthread -I "$RT" "$H/tp_test.c" "$RT/fle_audio_transport.c" -o "$O/tp_threads.mjs" \
+  -sMODULARIZE=1 -sEXPORT_ES6=1 -sENVIRONMENT=node,worker -sJSPI=1 -sPTHREAD_POOL_SIZE=3 -sINITIAL_MEMORY=64MB -sMAXIMUM_MEMORY=64MB -sSHARED_MEMORY=1 -sEXPORTED_RUNTIME_METHODS=HEAPU8 \
+  -sEXPORTED_FUNCTIONS=_t_external,_t_two_threads,_malloc 2>&1 | grep -v "^$" | head -5 || true
+node --experimental-wasm-jspi "$H/tp_threads.mjs" "$O/tp_threads.mjs"
