index 0000000..55a3ee6
--- /dev/null
+++ b/lift/harness/audio/tp_wasm/tp_test.c
@@ -0,0 +1,59 @@
+/* decision 0312 (stage C): the engine's own audio transport (runtime/fle_audio_transport.c, the wasm branch) built for node, with the few symbols of the rest of the runtime that it calls replaced by the stubs below.
+ * run.sh builds it and runs tp_test.mjs, which plays the page: it takes the ring from the { type: 'audio-ring' } message exactly as app/src/audio/page-audio.ts does and checks the published frames, the gap, the late
+ * skip, the rewrite, the unwrapped read position, the unlock log and the telemetry of the first Worker. */
+#include <stdint.h>
+#include <stdlib.h>
+#include <emscripten.h>
+
+#include "fle_audio_ring.h"
+#include "fle_audio_transport.h"
+#include "fle_sys.h"
+
+static fle_audio_ring_t g_ring;
+fle_audio_ring_t *fle_audio_ring_get(void) { return &g_ring; }
+uint64_t fle_audio_consumed(void) { return (uint64_t)fle_tp_consumed(); }
+uint64_t fle_sys_clock_ticks(void) { return 0; }
+
+EMSCRIPTEN_KEEPALIVE int t_external(void) { return fle_audio_external(); }
+EMSCRIPTEN_KEEPALIVE void t_publish(const float *lr, unsigned n, double first) { fle_tp_publish(lr, n, first, 44100); }
+EMSCRIPTEN_KEEPALIVE void t_rewrite(const float *lr, unsigned n, double first, unsigned guard) { fle_tp_rewrite(lr, n, first, guard); }
+EMSCRIPTEN_KEEPALIVE double t_consumed(void) { return fle_tp_consumed(); }
+EMSCRIPTEN_KEEPALIVE void t_state(unsigned st, unsigned rate) { fle_tp_state(st, rate); }
+EMSCRIPTEN_KEEPALIVE void t_unlock(double first, unsigned n) { fle_audio_unlock_note(first, n); }
+EMSCRIPTEN_KEEPALIVE void t_switch(unsigned from, unsigned to) { fle_audio_switch_note(from, to); }
+EMSCRIPTEN_KEEPALIVE float *t_alloc(unsigned frames) { return (float *)malloc((size_t)frames * 2u * sizeof(float)); }
+
+/* two real pthreads (the two Workers of the real-thread version) hand frames over in turn under a lock that stands for the giant lock: the ring must hold every block, with no silence between them (decision 0305c: with the earlier per-Worker state each Worker's hand-over filled "the gap since its own last hand-over" with zeros over the other's frames) */
+#include <pthread.h>
+static volatile int tp_lock;
+static uint64_t tp_next;
+static void tp_L(void) { while (__atomic_exchange_n(&tp_lock, 1, __ATOMIC_ACQUIRE)) { } }
+static void tp_U(void) { __atomic_store_n(&tp_lock, 0, __ATOMIC_RELEASE); }
+#define TP_BLOCKS_PER_THREAD 400
+static void *tp_thread(void *arg)
+{
+    float buf[2 * 100];
+    int i, k;
+
+    (void)arg;
+    for (i = 0; i < TP_BLOCKS_PER_THREAD; i++) {
+        tp_L();
+        for (k = 0; k < 100; k++) {
+            buf[2 * k] = (float)(tp_next + (uint64_t)k + 1u);
+            buf[2 * k + 1] = -(float)(tp_next + (uint64_t)k + 1u);
+        }
+        fle_tp_publish(buf, 100, (double)tp_next, 44100);
+        tp_next += 100;
+        tp_U();
+    }
+    return 0;
+}
+EMSCRIPTEN_KEEPALIVE int t_two_threads(void)
+{
+    pthread_t a, b;
+
+    if (pthread_create(&a, 0, tp_thread, 0) || pthread_create(&b, 0, tp_thread, 0)) return -1;
+    pthread_join(a, 0);
+    pthread_join(b, 0);
+    return (int)(tp_next / 100);
+}
