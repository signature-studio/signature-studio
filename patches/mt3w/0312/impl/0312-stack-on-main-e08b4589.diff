@@ -0,0 +1,329 @@
+//! Tests for CreateSemaphoreW and ReleaseSemaphore of runtime/fle_event.c (decision 0234, mt3; the semaphores share the table, the handle region, WaitForSingleObject and the CloseHandle hook of the events).
+//!
+//! Expected values are written here from the rules on the Microsoft pages (CreateSemaphoreW, ReleaseSemaphore, WaitForSingleObject, CloseHandle, System Error Codes), not read back from the C code. A value the pages do not give
+//! is marked "assumption" or "inference" and is the only thing such a test pins down. The host is Linux: no host clock, thread or process is read.
+
+mod etxt_common;
+
+use std::os::unix::process::ExitStatusExt;
+use std::path::{Path, PathBuf};
+use std::process::Command;
+use std::sync::OnceLock;
+
+fn manifest() -> PathBuf {
+    PathBuf::from(env!("CARGO_MANIFEST_DIR"))
+}
+fn runtime_dir() -> PathBuf {
+    manifest().join("../../runtime")
+}
+fn src_dir() -> PathBuf {
+    if let Ok(d) = std::env::var("FLE_EVENT_SRC_DIR") {
+        return PathBuf::from(d);
+    }
+    if runtime_dir().join("fle_event.c").exists() {
+        runtime_dir()
+    } else {
+        manifest().join("../../out-event/work")
+    }
+}
+fn work_dir() -> PathBuf {
+    let d = manifest().join("../../out-event/test");
+    std::fs::create_dir_all(d.join("tmp")).unwrap();
+    d
+}
+
+fn clang_c(src: &Path, obj: &Path, strict: bool) {
+    let mut cmd = Command::new("clang");
+    cmd.args(["-O0", "-std=gnu11", "-Wall", "-Wextra", "-fPIE", "-c"]);
+    if strict {
+        cmd.arg("-Werror");
+    }
+    let cc = cmd
+        .arg("-I")
+        .arg(src_dir())
+        .arg("-I")
+        .arg(runtime_dir())
+        .arg(src)
+        .arg("-o")
+        .arg(obj)
+        .env("TMPDIR", work_dir().join("tmp"))
+        .output()
+        .expect("clang not found");
+    assert!(cc.status.success(), "clang failed for {}: {}", src.display(), String::from_utf8_lossy(&cc.stderr));
+}
+
+/// fle_event.c (warnings are errors) and the existing files it links with (the CloseHandle of fle_vfs.c; fle_vol.c and
+/// fle_vmap.c are the two other users of the close hooks).
+fn objs() -> &'static Vec<PathBuf> {
+    static O: OnceLock<Vec<PathBuf>> = OnceLock::new();
+    O.get_or_init(|| {
+        let dir = work_dir().join(etxt_common::per_process("obj-sem"));
+        std::fs::create_dir_all(&dir).unwrap();
+        let mut v = Vec::new();
+        for (name, ours) in [
+            ("fle_event.c", true),
+            ("fle_vol.c", false),
+            ("fle_vmap.c", false),
+            ("fle_vfs.c", false),
+            ("fle_sys.c", false),
+            ("fle_proc.c", false),
+            ("fle_imports.c", false),
+            ("fle_env.c", false),
+        ] {
+            let base = if ours { src_dir() } else { runtime_dir() };
+            let o = dir.join(name.replace(".c", ".o"));
+            clang_c(&base.join(name), &o, ours);
+            v.push(o);
+        }
+        v
+    })
+}
+
+pub struct Out {
+    stdout: String,
+    stderr: String,
+    signal: Option<i32>,
+    ok: bool,
+}
+
+const PRELUDE: &str = r#"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdint.h>
+#include <pthread.h>
+#include "fle_runtime.h"
+#include "fle_imports.h"
+#include "fle_env.h"
+#include "fle_sys.h"
+#include "fle_vfs.h"
+#include "fle_proc.h"
+#include "fle_vol.h"
+#include "fle_vmap.h"
+#include "fle_event.h"
+
+uint64_t R[16];
+static uint64_t stk[32];
+
+/* a[0..3] go to rcx, rdx, r8, r9; a[4..11] are arguments 5..12 at [rsp + 0x28 + 8 * k]. */
+static uint64_t callv(void (*f)(void), const uint64_t *a)
+{
+    int i;
+    memset(stk, 0, sizeof stk);
+    stk[0] = 0xdead0000u;
+    R[1] = a[0]; R[2] = a[1]; R[8] = a[2]; R[9] = a[3];
+    for (i = 4; i < 12; i++) stk[i + 1] = a[i];
+    R[4] = (uint64_t)(uintptr_t)stk;
+    R[0] = 0xBADBADBADull;
+    f();
+    return R[0];
+}
+#define CALL(f, ...) callv((void (*)(void))(f), (uint64_t[12]){ __VA_ARGS__ })
+#define A(x) ((uint64_t)(uintptr_t)(x))
+#define U(x) ((unsigned long long)(x))
+static uint32_t LE(void) { fle_imp_GetLastError(); return (uint32_t)R[0]; }
+static void SETLE(uint32_t v) { fle_set_last_error(v); }
+#define INVH 0xFFFFFFFFFFFFFFFFull
+#define CREATE(manual, initial) CALL(fle_imp_CreateEventW, 0, (manual), (initial), 0)
+#define SET(h) CALL(fle_imp_SetEvent, (h))
+#define RESET(h) CALL(fle_imp_ResetEvent, (h))
+#define WAIT(h, ms) ((uint32_t)CALL(fle_imp_WaitForSingleObject, (h), (ms)))
+"#;
+
+fn run_src(name: &str, top: &str, body: &str) -> Out {
+    let dir = work_dir();
+    let uname = etxt_common::uniq(name);
+    let c = dir.join(format!("{uname}.c"));
+    let exe = dir.join(&uname);
+    let src = format!("{PRELUDE}\n{top}\nint main(void)\n{{\n{body}\n    return 0;\n}}\n");
+    std::fs::write(&c, src).unwrap();
+    let mut cmd = Command::new("clang");
+    cmd.args(["-O0", "-std=gnu11", "-w", "-fPIE", "-pthread", "-I"]).arg(src_dir()).arg("-I").arg(runtime_dir());
+    for o in objs() {
+        cmd.arg(o);
+    }
+    let cc = cmd.arg("-o").arg(&exe).arg(&c).env("TMPDIR", dir.join("tmp")).output().expect("clang not found");
+    assert!(cc.status.success(), "clang failed for {name}: {}", String::from_utf8_lossy(&cc.stderr));
+    let r = Command::new(&exe).env("TMPDIR", dir.join("tmp")).output().expect("run failed");
+    Out {
+        stdout: String::from_utf8_lossy(&r.stdout).to_string(),
+        stderr: String::from_utf8_lossy(&r.stderr).to_string(),
+        signal: r.status.signal(),
+        ok: r.status.success(),
+    }
+}
+
+fn run(name: &str, body: &str) -> Out {
+    run_src(name, "", body)
+}
+
+fn lines(name: &str, body: &str) -> Vec<String> {
+    let o = run(name, body);
+    assert!(o.ok, "{name} did not exit normally (signal {:?}): {}\n{}", o.signal, o.stderr, o.stdout);
+    o.stdout.lines().map(|s| s.to_string()).collect()
+}
+
+/// Each (label, C statements) must stop the run with SIGABRT, a "fle: <api>" message and no output after it. `setup` runs first.
+fn assert_aborts(prefix: &str, setup: &str, api: &str, cases: &[(&str, &str)]) {
+    for (label, stmts) in cases {
+        let body = format!("{setup}\n    {stmts}\n    printf(\"returned %llu\\n\", U(R[0]));");
+        let o = run(&format!("{prefix}-{label}"), &body);
+        assert!(!o.ok, "{label}: expected an abort, got stdout {}", o.stdout);
+        assert!(!o.stdout.contains("returned"), "{label}: returned instead of stopping");
+        assert!(o.stderr.contains(&format!("fle: {api}")), "{label}: no 'fle: {api}' message: {}", o.stderr);
+        assert_eq!(o.signal, Some(6), "{label}: not SIGABRT");
+    }
+}
+
+fn header_const(file: &str, name: &str) -> u64 {
+    let t = std::fs::read_to_string(src_dir().join(file)).or_else(|_| std::fs::read_to_string(runtime_dir().join(file))).unwrap();
+    let line = t.lines().find(|l| l.contains(&format!("#define {name} "))).unwrap_or_else(|| panic!("{name} not in {file}"));
+    let tok = line.split("UINT64_C(").nth(1).unwrap().split(')').next().unwrap();
+    u64::from_str_radix(tok.trim_start_matches("0x"), 16).unwrap()
+}
+
+/// C text without comments (strings are kept).
+fn strip_comments(s: &str) -> String {
+    let b: Vec<char> = s.chars().collect();
+    let mut o = String::new();
+    let mut i = 0;
+    while i < b.len() {
+        if b[i] == '/' && i + 1 < b.len() && b[i + 1] == '*' {
+            i += 2;
+            while i + 1 < b.len() && !(b[i] == '*' && b[i + 1] == '/') {
+                i += 1;
+            }
+            i += 2;
+        } else if b[i] == '/' && i + 1 < b.len() && b[i + 1] == '/' {
+            while i < b.len() && b[i] != '\n' {
+                i += 1;
+            }
+        } else {
+            o.push(b[i]);
+            i += 1;
+        }
+    }
+    o
+}
+
+
+// ---- 1. Table and header ----
+
+const API: [&str; 2] = ["CreateSemaphoreW", "ReleaseSemaphore"];
+
+#[test]
+fn rows_are_in_the_table_and_declared_in_the_header() {
+    let table = std::fs::read_to_string(manifest().join("src/imports_table.rs")).unwrap();
+    let h = std::fs::read_to_string(src_dir().join("fle_event.h")).unwrap();
+    for n in API {
+        let row = format!("(\"kernel32.dll\", \"{n}\", \"fle_imp_{n}\", \"jmp_imp:{n}\")");
+        assert_eq!(table.matches(&row).count(), 1, "{n}: exactly one row in imports_table.rs");
+        assert!(h.contains(&format!("void fle_imp_{n}(void)")), "{n} is declared in fle_event.h");
+    }
+}
+
+// ---- 2. The rules of the pages ----
+
+#[test]
+fn a_semaphore_is_signaled_while_its_count_is_above_zero_and_each_wait_takes_one() {
+    let l = lines(
+        "sem-count",
+        r#"
+    uint64_t h = CALL(fle_imp_CreateSemaphoreW, 0, 2, 3, 0);
+    printf("created %d\n", h != 0);
+    printf("w1 %x\n", WAIT(h, 0));      /* count 2 -> 1 */
+    printf("w2 %x\n", WAIT(h, 0));      /* 1 -> 0 */
+    printf("w3 %x\n", WAIT(h, 0));      /* nonsignaled, time-out 0: WAIT_TIMEOUT */
+    printf("fe %d\n", fle_event_state(h));
+    printf("rel %llu\n", U(CALL(fle_imp_ReleaseSemaphore, h, 3, 0)));   /* 0 -> 3: the maximum */
+    printf("fe %d\n", fle_event_state(h));
+    printf("w4 %x\n", WAIT(h, 0));      /* 3 -> 2 */
+    printf("w5 %x\n", WAIT(h, 5000));   /* signaled: returns at once whatever the time-out; 2 -> 1 */
+    printf("w6 %x\n", WAIT(h, 0));      /* 1 -> 0 */
+    printf("w7 %x\n", WAIT(h, 0));
+"#,
+    );
+    assert_eq!(l, ["created 1", "w1 0", "w2 0", "w3 102", "fe 0", "rel 1", "fe 1", "w4 0", "w5 0", "w6 0", "w7 102"]);
+}
+
+#[test]
+fn release_reports_the_previous_count_and_refuses_to_pass_the_maximum() {
+    let l = lines(
+        "sem-release",
+        r#"
+    uint32_t prev = 0xAAAAAAAAu;
+    uint64_t h = CALL(fle_imp_CreateSemaphoreW, 0, 1, 4, 0);
+    SETLE(0);
+    printf("r1 %llu prev %u\n", U(CALL(fle_imp_ReleaseSemaphore, h, 2, A(&prev))), prev);          /* 1 -> 3, previous 1 */
+    printf("r2 %llu prev %u\n", U(CALL(fle_imp_ReleaseSemaphore, h, 1, A(&prev))), prev);          /* 3 -> 4, previous 3 */
+    prev = 0xBBBBBBBBu;
+    SETLE(0);
+    printf("r3 %llu prev %x le %u\n", U(CALL(fle_imp_ReleaseSemaphore, h, 1, A(&prev))), prev, LE());   /* over the maximum: FALSE, count unchanged, previous not written, ERROR_TOO_MANY_POSTS (inference) */
+    printf("r4 %llu le %u\n", U(CALL(fle_imp_ReleaseSemaphore, h, 0, 0)), LE());                       /* release count not above zero: FALSE, ERROR_INVALID_PARAMETER (assumption) */
+    printf("r5 %llu\n", U(CALL(fle_imp_ReleaseSemaphore, h, 0xFFFFFFFFull, 0)));                      /* -1 as a LONG */
+    printf("w x4:");
+    for (int k = 0; k < 4; k++) printf(" %x", WAIT(h, 0));   /* the count is 4: four waits are satisfied, the fifth is not */
+    printf(" %x\n", WAIT(h, 0));
+    printf("r6 %llu\n", U(CALL(fle_imp_ReleaseSemaphore, h, 4, 0)));   /* back to the maximum from 0 */
+"#,
+    );
+    assert_eq!(
+        l,
+        ["r1 1 prev 1", "r2 1 prev 3", "r3 0 prev bbbbbbbb le 298", "r4 0 le 87", "r5 0", "w x4: 0 0 0 0 102", "r6 1"]
+    );
+}
+
+#[test]
+fn bounds_of_the_counts_on_creation() {
+    let l = lines(
+        "sem-bounds",
+        r#"
+    SETLE(0);
+    printf("max0 %llu le %u\n", U(CALL(fle_imp_CreateSemaphoreW, 0, 0, 0, 0)), LE());               /* lMaximumCount must be greater than zero */
+    printf("maxneg %llu\n", U(CALL(fle_imp_CreateSemaphoreW, 0, 0, 0xFFFFFFFFull, 0)));           /* -1 */
+    printf("initneg %llu\n", U(CALL(fle_imp_CreateSemaphoreW, 0, 0xFFFFFFFFull, 5, 0)));          /* lInitialCount must be >= 0 */
+    printf("initbig %llu\n", U(CALL(fle_imp_CreateSemaphoreW, 0, 6, 5, 0)));                       /* ... and <= lMaximumCount */
+    printf("ok-eq %d\n", CALL(fle_imp_CreateSemaphoreW, 0, 5, 5, 0) != 0);
+    printf("ok-0 %d\n", CALL(fle_imp_CreateSemaphoreW, 0, 0, 1, 0) != 0);
+    /* only the low DWORD of rdx / r8 counts (LONG): garbage in the high halves does not matter */
+    printf("hi %d\n", CALL(fle_imp_CreateSemaphoreW, 0, 0xDEAD000000000001ull, 0xBEEF000000000002ull, 0) != 0);
+    printf("live %llu\n", U(fle_event_handle_count()));
+"#,
