+#[test]
+fn a_semaphore_releases_one_waiting_thread_per_count_and_wait_for_all_takes_one_from_each() {
+    // decision 0234 (mt3): Learn ReleaseSemaphore: the count goes up by the release count; "each time a waiting thread is released because of the semaphore's signaled state, the count of the semaphore is decreased by one" (CreateSemaphoreW).
+    // Two threads wait for the semaphore (count 0, maximum 5): a release of 1 lets the first waiter go (10) and leaves the count at 0; a release of 3 lets the second go (20) and leaves 2. WaitForMultipleObjects(all) over two semaphores takes one from each, or none.
+    let top = format!(
+        "{VA}static uint64_t sem;\nstatic void th_a(void) {{ note(10 + (int)W1(sem, INF)); R[0] = 0; }}\n\
+         static void th_b(void) {{ note(20 + (int)W1(sem, INF)); R[0] = 0; }}\n\
+         const fle_fn_entry fle_dispatch_table[] = {{ {{ VA_A, th_a }}, {{ VA_B, th_b }} }};\nconst uint64_t fle_dispatch_count = 2;"
+    );
+    let l = lines(
+        "t-sem-threads",
+        &top,
+        r#"
+    uint64_t h1, h2, s1, s2, arr[2];
+    uint32_t prev = 99;
+    CALL4(fle_imp_CreateSemaphoreW, 0, 0, 5, 0); sem = R[0];
+    h1 = H_CREATE(VA_A, 0, 0, 0); h2 = H_CREATE(VA_B, 0, 0, 0);
+    SLEEP(0);
+    CALL4(fle_imp_ReleaseSemaphore, sem, 1, A(&prev), 0);
+    SLEEP(0);
+    printf("after-first-release %d count-state %d prev %u\n", on_, fle_event_state(sem), prev);
+    CALL4(fle_imp_ReleaseSemaphore, sem, 3, A(&prev), 0);
+    W1(h1, INF); W1(h2, INF);
+    printf("after-second-release %d state %d prev %u\n", on_, fle_event_state(sem), prev);
+    print_order();
+    /* wait-all: s1 has 1, s2 has 0 -> not satisfied, nothing taken; after s2 gets 1 both are taken */
+    CALL4(fle_imp_CreateSemaphoreW, 0, 1, 3, 0); s1 = R[0];
+    CALL4(fle_imp_CreateSemaphoreW, 0, 0, 3, 0); s2 = R[0];
+    arr[0] = s1; arr[1] = s2;
