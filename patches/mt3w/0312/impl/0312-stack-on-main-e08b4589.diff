@@ -0,0 +1,24 @@
+// decision 0312: the two-pthread hand-over test (see tp_test.c). usage: node --experimental-wasm-jspi tp_threads.mjs <module.mjs>
+import assert from 'node:assert/strict';
+globalThis.__posted = [];
+globalThis.self = globalThis;
+globalThis.postMessage = (m) => globalThis.__posted.push(m);
+globalThis.fleAudioHost = { cap: 32768, rate: 44100 };
+const M = await (await import(process.argv[2])).default();
+assert.equal(M._t_external(), 1, 'external');
+const r = globalThis.__posted.find((m) => m.type === 'audio-ring');
+assert.ok(r, 'audio-ring posted');
+const h = new Int32Array(r.sab, r.hdr, 32);
+const d = new Float32Array(r.sab, r.data, 32768 * 2);
+const blocks = M._t_two_threads();
+assert.equal(blocks, 800, 'two threads hand over 800 blocks');
+// the ring holds the last 32768 frames: frames (total - 32768) .. total-1 hold their own index + 1, none is silence
+const total = blocks * 100;
+let bad = 0;
+for (let f = total - 32768; f < total; f++) { const q = (f & 32767) * 2; if (d[q] !== f + 1 || d[q + 1] !== -(f + 1)) bad++; }
+assert.equal(bad, 0, 'every frame of the ring is the frame that was handed over (' + bad + ' wrong)');
+assert.equal(Atomics.load(h, 1) >>> 0, total >>> 0, 'WR = total frames');
+assert.equal(Atomics.load(h, 14), 800, 'publishes');
+const st = globalThis.fleAudioWorkerState();
+assert.equal(st.gapFrames, 0, 'no gap was filled: the write position is shared');
+console.log('tp_threads: ok (' + total + ' frames from 2 pthreads, 0 gap frames, 0 wrong)');
