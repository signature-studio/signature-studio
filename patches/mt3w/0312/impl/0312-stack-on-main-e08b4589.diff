+++ b/lift/harness/gil/gen_wrap.py
@@ -0,0 +1,24 @@
+#!/usr/bin/env python3
+"""Decision 0234 (mt3, B-prime stage 2 spike, opt-in GIL=1): the giant lock around every runtime function that the guest calls. usage: gen_wrap.py NAMES.txt OUT.c OUT.rsp
+NAMES.txt: the defined `fle_imp_*` symbols of the runtime (one per line, from llvm-nm). OUT.c: `__wrap_fle_imp_<n>` for each: takes the lock when the calling Worker does not hold it (a call from the guest), calls `__real_fle_imp_<n>`, releases; a call that
+the runtime makes itself from another file (the Worker holds the lock) is passed through. OUT.rsp: the linker's `-Wl,--wrap=fle_imp_<n>` for each. No name of FL is in the list: it is the list of the runtime's own entry points."""
+import sys
+names = sorted({l.strip() for l in open(sys.argv[1]) if l.strip().startswith('fle_imp_')})
+lockfree = set()
+if len(sys.argv) > 4:   # runtime/fle_gil_lockfree.inc: the imports that read and write no state another Worker can write (docs 0234q): no lock
+    import re
+    lockfree = {m.group(1) for l in open(sys.argv[4]) for m in [re.match(r'X\((\w+)\)', l)] if m}
+with open(sys.argv[2], 'w') as c:
+    c.write('/* generated by lift/harness/gil/gen_wrap.py: %d entry points */\n#include "fle_gil.h"\n#ifdef FLE_GIL\n' % len(names))
+    c.write('void fle_dbg(const char *fmt, ...);\nstatic volatile unsigned dbgn;\n#define D(n) do { } while (0)\n')
+    c.write('#define WL(n) extern void __real_fle_imp_##n(void); void __wrap_fle_imp_##n(void) { __real_fle_imp_##n(); }\n')
+    c.write('#define W(n) extern void __real_fle_imp_##n(void); void __wrap_fle_imp_##n(void) { if (fle_gil_owner == fle_worker_id + 1u) { __real_fle_imp_##n(); return; } D(n); fle_dbg_note("> " #n); fle_gil_acquire(); __real_fle_imp_##n(); fle_gil_release(); fle_dbg_note("< " #n); }\n')
+    for n in names:
+        c.write('%s(%s)\n' % ('WL' if n[len('fle_imp_'):] in lockfree else 'W', n[len('fle_imp_'):]))
+    c.write('extern int __real_emscripten_futex_wait(volatile void *addr, unsigned val, double ms);\nvoid fle_dbg_notes(const char *why);\nvoid fle_dbg_stack(void);\nint __wrap_emscripten_futex_wait(volatile void *addr, unsigned val, double ms) { static volatile unsigned n; if (n < 60) { n++; fle_dbg("W%u futex_wait addr=%#x val=%u ms=%g", (unsigned)fle_worker_id, (unsigned)(unsigned long)addr, val, ms); if (ms > 1.0e9) { const volatile unsigned *w = (const volatile unsigned *)(((unsigned long)addr & ~63ul) - 64); unsigned k; fle_dbg_notes("futex_wait"); fle_dbg_stack(); for (k = 0; k < 48; k += 8) fle_dbg("   mem %#x: %08x %08x %08x %08x %08x %08x %08x %08x", (unsigned)(unsigned long)(w + k), w[k], w[k+1], w[k+2], w[k+3], w[k+4], w[k+5], w[k+6], w[k+7]); } } return __real_emscripten_futex_wait(addr, val, ms); }\n')
+    c.write('#endif\n')
+with open(sys.argv[3], 'w') as r:
+    for n in names:
+        r.write('-Wl,--wrap=%s\n' % n)
+    r.write('-Wl,--wrap=emscripten_futex_wait\n')
+print('%d wrappers' % len(names))
