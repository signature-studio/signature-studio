index 0000000..c304036
--- /dev/null
+++ b/lift/runtime/fle_gil.c
@@ -0,0 +1,110 @@
+/* Decision 0234 (mt3, B-prime stage 2 spike): the slow paths of the giant lock (runtime/fle_gil.h). Empty without -DFLE_GIL. */
+#ifdef FLE_GIL
+#include <stdint.h>
+#include <stdio.h>
+#include "fle_gil.h"
+#include "fle_env.h"
+#include <emscripten.h>
+
+_Thread_local unsigned fle_export_depth;
+_Thread_local volatile uint32_t *fle_idle_wake_word;
+_Thread_local uint32_t fle_idle_wake_seq;
+
+volatile uint32_t fle_gil_word __attribute__((aligned(64)));
+volatile uint32_t fle_gil_owner;
+volatile uint32_t fle_gil_nwait;
+volatile uint32_t fle_gil_nsleep;
+static volatile uint32_t gil_gen;   /* bumped (and notified) when the lock is let go while somebody waits: the waiters look again */
+static volatile uint32_t gil_ticket;
+static volatile uint64_t gil_key[32];   /* the queue key of each waiting Worker (0 = not waiting): priority + 32 in the high word, then the arrival order reversed, so that the largest key goes first */
+int32_t fle_thread_gil_prio(void) __attribute__((weak));
+_Thread_local uint32_t fle_worker_id;
+const char *volatile fle_dbg_ring[64];
+const char *volatile fle_where[32];
+volatile unsigned fle_dbg_ri;
+volatile uint32_t fle_gil_contended;
+volatile uint32_t fle_gil_spins;
+void fle_dbg_notes(const char *why)
+{
+    void fle_dbg(const char *fmt, ...);
+    unsigned k, ri = fle_dbg_ri;
+
+    fle_dbg("last notes of W1 (%u) at %s:", ri, why);
+    for (k = ri > 14 ? ri - 14 : 0; k < ri; k++) fle_dbg("   note %u: %s", k, fle_dbg_ring[k & 63u] ? fle_dbg_ring[k & 63u] : "?");
+}
+void fle_worker_id_set(uint32_t id) { fle_worker_id = id; }
+void fle_gil_assert_fail(const char *where)
+{
+    char why[200];
+
+    snprintf(why, sizeof why, "%s runs on Worker %u without the lock (holder: %u): an entry of the runtime that takes no lock (decision 0234 mt3)", where, (unsigned)fle_worker_id, (unsigned)fle_gil_owner);
+    fle_stop("fle_gil", why);
+}
+
+
+void fle_gil_wake(void)
+{
+    __atomic_add_fetch(&gil_gen, 1u, __ATOMIC_SEQ_CST);
+    __builtin_wasm_memory_atomic_notify((int32_t *)&gil_gen, 64);
+}
+
+void fle_gil_acquire_slow(void)
+{
+    uint32_t spin, me = fle_worker_id & 31u, ticket;
+    uint64_t key;
+    int32_t prio = fle_thread_gil_prio ? fle_thread_gil_prio() : 0;
+
+    if (fle_gil_owner == fle_worker_id + 1u) fle_stop("fle_gil", "this Worker takes the lock while it holds it: a point where the runtime hands over to the guest or parks is missing its release (decision 0234 mt3)");
+    __atomic_fetch_add(&fle_gil_contended, 1u, __ATOMIC_RELAXED);
+    if (prio < -31) prio = -31;
+    if (prio > 31) prio = 31;
+    ticket = __atomic_fetch_add(&gil_ticket, 1u, __ATOMIC_SEQ_CST);
+    key = ((uint64_t)(uint32_t)(prio + 32) << 32) | (uint64_t)(0xFFFFFFFFu - ticket);
+    __atomic_add_fetch(&fle_gil_nwait, 1u, __ATOMIC_SEQ_CST);
+    for (;;) {
+        uint32_t g = __atomic_load_n(&gil_gen, __ATOMIC_SEQ_CST), w;
+        int best = 1;
+
+        __atomic_store_n(&gil_key[me], key, __ATOMIC_SEQ_CST);   /* awake: counts in the order of the Workers that run */
+        for (w = 0; w < 32u; w++)
+            if (w != me && __atomic_load_n(&gil_key[w], __ATOMIC_SEQ_CST) > key) { best = 0; break; }
+        for (spin = 0; spin < 2000u; spin++) {
+            uint32_t z = 0;
+
+            if (best && __atomic_load_n(&fle_gil_word, __ATOMIC_RELAXED) == 0u && __atomic_compare_exchange_n(&fle_gil_word, &z, 1u, 0, __ATOMIC_ACQUIRE, __ATOMIC_RELAXED)) {
+                __atomic_fetch_add(&fle_gil_spins, spin, __ATOMIC_RELAXED);
+                goto got;
+            }
+            if (!best && (spin & 63u) == 63u) {   /* a Worker of higher priority is awake and about to take it: look again */
+                best = 1;
+                for (w = 0; w < 32u; w++)
+                    if (w != me && __atomic_load_n(&gil_key[w], __ATOMIC_SEQ_CST) > key) { best = 0; break; }
+            }
+        }
+        __atomic_store_n(&gil_key[me], 0u, __ATOMIC_SEQ_CST);   /* asleep: holds nobody back */
+        __atomic_add_fetch(&fle_gil_nsleep, 1u, __ATOMIC_SEQ_CST);
+        if (__atomic_load_n(&fle_gil_word, __ATOMIC_SEQ_CST) == 0u) {   /* let go between the last look and the registration: nobody would wake us */
+            __atomic_sub_fetch(&fle_gil_nsleep, 1u, __ATOMIC_SEQ_CST);
+            continue;
+        }
+        if (__builtin_wasm_memory_atomic_wait32((int32_t *)&gil_gen, (int32_t)g, 3000000000LL) == 2) {   /* every Worker waits synchronously: a Worker that holds the lock never waits for another Worker's event loop (I1, harness/gil/check_i1.py), so the holder lets go in microseconds. The first Worker used to suspend its JSPI stack here (Atomics.waitAsync): it was resumed by its event loop, which a task of the page (a present of the desktop) could keep busy for 10-100 ms: the Worker waited for the lock 190 times in 10 s for that long (measured, docs 0234q) */   /* timed out: the holder has not let go in 3 s */
+            void fle_dbg(const char *fmt, ...);
+            fle_dbg("W%u has waited 3 s for the lock: owner=%u word=%u nwait=%u", (unsigned)fle_worker_id, (unsigned)fle_gil_owner, (unsigned)fle_gil_word, (unsigned)fle_gil_nwait);
+            fle_dbg_notes("gil wait");
+        }
+        __atomic_sub_fetch(&fle_gil_nsleep, 1u, __ATOMIC_SEQ_CST);
+    }
+got:
+    fle_gil_owner = fle_worker_id + 1u;
+    __atomic_store_n(&gil_key[me], 0u, __ATOMIC_SEQ_CST);
+    __atomic_sub_fetch(&fle_gil_nwait, 1u, __ATOMIC_SEQ_CST);
+}
+
+void fle_gil_release_slow(void)
+{
+    char why[160];
+
+    snprintf(why, sizeof why, "this Worker (%u) releases a lock it does not hold (holder: %u): a release without its acquire (decision 0234 mt3)", (unsigned)fle_worker_id + 1u, (unsigned)fle_gil_owner);
+    fle_stop("fle_gil", why);
+}
+#endif
diff --git a/lift/runtime/fle_gil.h b/lift/runtime/fle_gil.h
new file mode 100644
index 0000000..db21f5e
--- /dev/null
+++ b/lift/runtime/fle_gil.h
@@ -0,0 +1,86 @@
+/* Decision 0234 (mt3, B-prime stage 2 spike, PROVISIONAL, opt-in -DFLE_GIL): the giant lock that protects the runtime's shared state once guest threads run on more than one WebAssembly instance (Worker) over one shared memory.
+ *
+ * Invariant: the lock is held exactly while a guest thread executes RUNTIME code; it is released while the thread executes GUEST code, while it is parked (a cooperative switch, a wait, the idle wait of the Worker) and while a
+ * callback of the runtime runs in the guest (fle_call_guest). Taken: at the entry of every runtime function the guest calls (fle_gil_wrap.c, generated for the fle_imp_* functions; the dispatch-miss path fle_win_try_thunk, which
+ * reaches the COM slots; fle_progress_slice; the exports that JavaScript calls). Released: before the guest runs again. The cooperative scheduler could already switch threads at the places where the lock is released, so every
+ * runtime function already tolerates another thread running there (decisions 0122, 0147): the lock generalises the cooperative mutual exclusion across Workers; nothing finer is needed for the spike.
+ *
+ * Diagnostic (the audit by assertion): the lock records the Worker that holds it. A Worker that takes it while it already holds it, or releases a lock it does not hold, stops by name: with one Worker the whole engine runs
+ * with the lock on, and any release point that was missed shows up as a named stop (fle_gil.c). Without -DFLE_GIL everything here is empty. */
+#ifndef FLE_GIL_H
+#define FLE_GIL_H
+#include <stdint.h>
+#ifdef FLE_GIL
+extern volatile uint32_t fle_gil_word;    /* 0 free, 1 held, 2 held and somebody waits */
+extern volatile uint32_t fle_gil_owner;   /* the holder's worker id + 1 (diagnostic) */
+extern _Thread_local uint32_t fle_worker_id;   /* 0 = the first Worker (the UI's); the second Worker sets 1 when it starts */
+void fle_worker_id_set(uint32_t id);
+void fle_gil_assert_fail(const char *where);
+/* the spike's flight recorder: the last 64 notes of Worker 1 (static strings), which the first Worker prints when it has waited 3 s for the lock */
+extern const char *volatile fle_dbg_ring[64];
+extern volatile unsigned fle_dbg_ri;
+extern const char *volatile fle_where[32];   /* the last note of each Worker (the thread-table report prints them) */
+static inline void fle_dbg_note(const char *s) { fle_where[fle_worker_id & 31u] = s; if (fle_worker_id == 1) fle_dbg_ring[__atomic_fetch_add(&fle_dbg_ri, 1u, __ATOMIC_RELAXED) & 63u] = s; }
+/* The first Worker's wait for the page (fle_idle_wait) also has to end when another Worker makes one of this Worker's threads ready: the scheduler gives the idle hook the wake word of the Worker and the value it read before it looked at the threads. */
+extern _Thread_local volatile uint32_t *fle_idle_wake_word;
+extern _Thread_local uint32_t fle_idle_wake_seq;
+extern volatile uint32_t fle_gil_contended;   /* diagnostics: acquisitions that had to wait, and the spins they used */
+extern volatile uint32_t fle_gil_spins;
+/* The audit by assertion: a runtime function that changes the shared tables states where it needs the lock. */
+static inline void fle_gil_assert(const char *where)
+{
+    if (__builtin_expect(fle_gil_owner != fle_worker_id + 1u, 0)) fle_gil_assert_fail(where);
+}
+void fle_gil_acquire_slow(void);
+void fle_gil_release_slow(void);
+/* Who gets the lock next. A Worker that finds the lock free takes it with one compare-and-swap, whoever waits (measured with the direct wasm of the hybrid, where the guest runs faster and calls the runtime densely: the lock was held 13% of the time and the two
+ * Workers waited for it 30-60% of the time, because a strict queue let no running Worker take a free lock while the first waiter, which had gone to sleep, had not woken up: a convoy). A Worker that finds it taken spins for a short while and then sleeps; only the
+ * Workers that are awake and spinning are ordered: by the priority of the guest thread they run (SetThreadPriority / GetThreadPriority, runtime/fle_thread.c fle_thread_gil_prio) and then by the order of their arrival (the order in which Windows runs ready threads: a
+ * higher priority first, the same priority in turn). A Worker that sleeps holds nobody back; the Worker that lets go of the lock wakes the sleepers (and only if there are any). No Worker is favoured by its number. */
+#define FLE_STAT_ACQ() ((void)0)
+#define FLE_STAT_REL() ((void)0)
+extern volatile uint32_t fle_gil_nwait;   /* Workers in the slow path of fle_gil_acquire */
+extern volatile uint32_t fle_gil_nsleep;   /* ... of which are asleep (waiting on the futex) */
+void fle_gil_wake(void);
+static inline void fle_gil_acquire(void)
+{
+    uint32_t z = 0;
+
+    if (__builtin_expect(__atomic_compare_exchange_n(&fle_gil_word, &z, 1u, 0, __ATOMIC_ACQUIRE, __ATOMIC_RELAXED), 1)) {
+        fle_gil_owner = fle_worker_id + 1u;
+        FLE_STAT_ACQ();
+        return;
+    }
+    fle_gil_acquire_slow();
+}
+static inline void fle_gil_release(void)
+{
+    if (__builtin_expect(fle_gil_owner != fle_worker_id + 1u, 0)) fle_gil_release_slow();   /* a stop by name */
+    FLE_STAT_REL();
+    fle_gil_owner = 0;
+    __atomic_exchange_n(&fle_gil_word, 0u, __ATOMIC_SEQ_CST);
+    if (__builtin_expect(__atomic_load_n(&fle_gil_nsleep, __ATOMIC_SEQ_CST) != 0u, 0)) fle_gil_wake();
+}
+/* The entry of an export that JavaScript calls (the page's events, the host's queries): takes the lock unless this Worker holds it already (an export called from inside the runtime); fle_gil_leave(took) hands it back. */
+extern _Thread_local unsigned fle_export_depth;   /* > 0 while this Worker runs an export that JavaScript called: no JSPI stack to suspend there, so a wait for the lock blocks */
+static inline int fle_gil_enter(void)
+{
+    fle_export_depth++;
+    if (fle_gil_owner == fle_worker_id + 1u) return 0;
+    fle_gil_acquire();
+    return 1;
+}
+static inline void fle_gil_leave(int took)
+{
+    if (took) fle_gil_release();
+    fle_export_depth--;
+}
+#else
+static inline void fle_gil_acquire(void) {}
+static inline void fle_gil_release(void) {}
+static inline int fle_gil_enter(void) { return 0; }
+static inline void fle_gil_assert(const char *where) { (void)where; }
+static inline void fle_dbg_note(const char *s) { (void)s; }
+static inline void fle_gil_leave(int took) { (void)took; }
+#endif
+#endif
