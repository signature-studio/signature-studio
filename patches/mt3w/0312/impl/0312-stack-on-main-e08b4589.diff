+++ b/lift/harness/mt2/rt-worker-shim.mjs
@@ -0,0 +1,24 @@
+// mt3 (decision 0234, stage 2 spike): the body of a node worker_threads Worker that plays the browser's `new Worker(url, {type:'module', name:'em-pthread'})` for the emscripten glue of the engine
+// (built for web+worker): the globals the glue reads in a pthread (self, name, postMessage, onmessage, WorkerGlobalScope), then the glue itself, which starts the pthread on its own (`isPthread && Module()`).
+// Nothing of the engine's behaviour is changed here.
+import { parentPort, workerData } from 'node:worker_threads';
+import fs from 'node:fs';
+const t0 = Date.now();
+const log = (m) => { try { fs.appendFileSync(workerData.log, '[shim +' + (Date.now() - t0) + ' ms] ' + m + '\n'); } catch {} };
+log('start');
+globalThis.__fleDbg = (m) => { try { fs.appendFileSync(workerData.dbg, '[' + new Date().toISOString().slice(14, 23) + '] ' + m + '\n'); } catch {} };
+process.on('uncaughtException', (e) => { log('UNCAUGHT ' + String((e && e.stack) || e).slice(0, 1500)); });
+process.on('unhandledRejection', (e) => { log('UNHANDLED REJECTION ' + String((e && e.stack) || e).slice(0, 1500)); });
+globalThis.self = globalThis;
+globalThis.name = workerData.name;
+globalThis.WorkerGlobalScope = globalThis.WorkerGlobalScope || class WorkerGlobalScope {};
+globalThis.postMessage = (m, t) => parentPort.postMessage(m, t || []);
+globalThis.addEventListener = globalThis.addEventListener || (() => {});
+parentPort.on('message', (d) => { log('message cmd=' + (d && d.cmd) + ' keys=' + (d && typeof d === 'object' ? Object.keys(d).join(',') : typeof d)); if (typeof globalThis.onmessage === 'function') globalThis.onmessage({ data: d }); });
+try {
+  await import(workerData.glue);
+  log('glue imported');
+} catch (e) {
+  parentPort.postMessage({ fleShimError: String((e && e.stack) || e) });
+  throw e;
+}
