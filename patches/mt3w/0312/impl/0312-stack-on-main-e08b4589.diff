diff --git a/lift/harness/gil/check_i1.py b/lift/harness/gil/check_i1.py
new file mode 100644
index 0000000..2d257ed
--- /dev/null
+++ b/lift/harness/gil/check_i1.py
@@ -0,0 +1,94 @@
+#!/usr/bin/env python3
+"""Invariant I1 of lift/runtime/fle_gil.h, checked on a built engine: a Worker that holds the runtime's lock never waits for another Worker's JavaScript event loop.
+
+emscripten's glue makes some imports of the wasm module wait SYNCHRONOUSLY for the first Worker when a pthread calls them (proxyToMainThread with a sync mode). The runtime runs guest code on pthreads and calls such an import
+while holding the lock only if the C code reaches it, so every import of the module that the glue proxies is listed here with the reason it cannot be reached (or is not harmful). A proxied import that is not in the list fails the check:
+somebody added a call that can make a Worker wait, with the lock held, for the first Worker's event loop.
+
+usage: check_i1.py GLUE.js ENGINE.wasm      exit 0 = the proxied imports are exactly the allowed ones; 1 = a new one (or a listed one that is no longer proxied: the list is stale)."""
+import re, sys
+
+ALLOWED = {
+    # name in the wasm import section -> why it is not a problem
+    'proc_exit': 'the end of the process (ExitProcess of a guest thread): nothing runs afterwards',
+    'exit': 'the end of the process (exit of the C runtime)',
+    '__syscall_openat': 'the NO_FS glue stub; the runtime has its own file layer (fle_vfs) and never calls the C library file functions on a host path',
+    '__syscall_fcntl64': 'the NO_FS glue stub (musl stdio on stdout/stderr only)',
+    '__syscall_ioctl': 'the NO_FS glue stub (musl stdio on stdout/stderr only)',
+    '__syscall_stat64': 'the NO_FS glue stub',
+    '__syscall_fstat64': 'the NO_FS glue stub',
+    '__syscall_lstat64': 'the NO_FS glue stub',
+    '__syscall_newfstatat': 'the NO_FS glue stub',
+    '__pthread_create_js': 'only the first Worker calls pthread_create: fle_thread.c wk_start calls it there and queues the call to the first Worker (emscripten_proxy_async) from any other Worker',
+    'fd_close': 'the NO_FS glue stub',
+    'fd_read': 'the NO_FS glue stub',
+    'fd_seek': 'the NO_FS glue stub (musl stdio asks for the position of stdout)',
+    'fd_pread': 'the NO_FS glue stub',
+    'environ_sizes_get': 'a pthread reads the environment of the first Worker once at its start (musl getenv in the runtime reads it from the first Worker: C code that runs at start-up, before any lock is taken by this Worker)',
+    'environ_get': 'same as environ_sizes_get',
+}
+MUST_BE_LOCAL = ['fd_write']   # the runtime's messages come from any thread, under the lock: fd_write has to run on the calling Worker (fd_write__proxy: none in fle_thread_lib.js)
+
+
+def wasm_imports(path):
+    b = open(path, 'rb').read(4 << 20)
+
+    def leb(i):
+        r = s = 0
+        while True:
+            x = b[i]; i += 1; r |= (x & 127) << s; s += 7
+            if not x & 128: return r, i
+    i = 8
+    while i < len(b):
+        sid = b[i]; i += 1
+        sz, i = leb(i)
+        if sid == 2:
+            n, j = leb(i); out = []
+            for _ in range(n):
+                l, j = leb(j); m = b[j:j + l].decode(); j += l
+                l, j = leb(j); nm = b[j:j + l].decode(); j += l
+                k = b[j]; j += 1
+                if k == 0: _, j = leb(j)
+                elif k == 1: j += 1; f, j = leb(j); _, j = leb(j)
+                elif k == 2:
+                    f, j = leb(j); _, j = leb(j)
+                    if f & 1: _, j = leb(j)
+                elif k == 3: j += 2
+                out.append(nm)
+            return out
+        i += sz
+    return []
+
+
+def glue_functions(text):
+    """name -> source of each top-level `function NAME(...) {...}` / `var NAME = ...;` of the glue, cut at the next top-level definition"""
+    starts = [(m.start(), m.group(2)) for m in re.finditer(r'^(function|var|let|const|async function)\s+([A-Za-z0-9_$]+)', text, re.M)]
+    return {name: text[a:(starts[k + 1][0] if k + 1 < len(starts) else len(text))] for k, (a, name) in enumerate(starts)}
+
+
+def main():
+    glue = open(sys.argv[1]).read()
+    imps = wasm_imports(sys.argv[2])
+    fn = glue_functions(glue)
+    proxied = {}
+    for name in imps:
+        for cand in ('_' + name, name, '_' + name.lstrip('_'), '__' + name):
+            body = fn.get(cand)
+            if body is not None:
+                if name == '_emscripten_receive_on_main_thread_js': break   # the receiving end, run by the first Worker for the others
+                direct = lambda b: re.search(r'proxyToMainThread\w*\(', b) or '__emscripten_run_js_on_main_thread(' in b
+                callees = [fn[c] for c in set(re.findall(r'[A-Za-z0-9_$]+', body)) if c in fn and c != cand]   # one level of callees (the pthread_create import calls pthreadCreateProxied)
+                if direct(body) or any(direct(c) for c in callees): proxied[name] = cand
+                break
+    bad = [n for n in proxied if n not in ALLOWED]
+    local_bad = [n for n in MUST_BE_LOCAL if n in proxied]
+    stale = [n for n in ALLOWED if n in imps and n not in proxied]
+    print('imports: %d; proxied to the first Worker by the glue: %d' % (len(imps), len(proxied)))
+    for n in sorted(proxied): print('  %-22s %s' % (n, ALLOWED.get(n, 'NOT ALLOWED')))
+    for n in local_bad: print('FAIL: %s is proxied synchronously (it has to run on the calling Worker)' % n)
+    for n in bad: print('FAIL: %s is proxied to the first Worker and is not in the list' % n)
+    for n in stale: print('note: %s is listed but the glue does not proxy it (the list can shrink)' % n)
+    sys.exit(1 if (bad or local_bad) else 0)
+
+
+main()
