+//!
+//! The review that says why each import qualifies (docs 0234q section 2) is made executable here: the body of each listed `fle_imp_*` function, and of every function of the same file that it calls, may call only the leaf operations below, which were read one by one:
+//! they touch the registers of the calling Worker, guest memory that the call names, the thread-local state of the calling Worker, atomics, the page's clock, or end the run. A call to anything else (a table of the runtime, the scheduler, the allocator, a
+//! function of another file) fails the test: the function no longer qualifies, or has to be reviewed again and the list below extended with the reason. Expected values are not read back from the code under test.
+
+use std::collections::{BTreeSet, HashMap};
+use std::path::PathBuf;
+
+fn runtime_dir() -> PathBuf {
+    PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("../../runtime")
+}
+
+/// (leaf call, why it is safe without the lock)
+const LEAVES: &[(&str, &str)] = &[
+    ("fle_ld", "reads guest memory at the given address (inline, fle_runtime.h)"),
+    ("fle_st", "writes guest memory at the given address (inline, fle_runtime.h)"),
+    ("fle_arg", "a stack argument of the call: guest memory at R[4] + 8 * n (inline, fle_env.h)"),
+    ("__builtin_add_overflow", "arithmetic"),
+    ("__builtin_sub_overflow", "arithmetic"),
+    ("__builtin_mul_overflow", "arithmetic"),
+    ("__builtin_expect", "a branch hint"),
+    ("fle_stop", "ends the run"),
+    ("fprintf", "the stop message"),
+    ("abort", "ends the run"),
+    ("fle_host_tid", "a constant on wasm, the Linux tid natively (inline, fle_host.h)"),
+    ("fle_thread_current", "the calling Worker's own `cur` (thread-local) and `nthr` (only ever grows)"),
+    ("fle_clock_real_now", "performance.timeOrigin + performance.now(), made monotonic by an atomic maximum"),
+    ("fle_real_epoch_ms", "the page's clock (EM_JS)"),
+    ("__atomic_load_n", "atomic"),
+    ("__atomic_compare_exchange_n", "atomic"),
+];
+
+const KEYWORDS: &[&str] = &["if", "while", "for", "switch", "return", "sizeof", "defined"];
+
+fn strip_comments_and_strings(s: &str) -> String {
+    let b: Vec<char> = s.chars().collect();
+    let mut o = String::new();
+    let mut i = 0;
+    while i < b.len() {
+        if b[i] == '/' && i + 1 < b.len() && b[i + 1] == '*' {
+            i += 2;
+            while i + 1 < b.len() && !(b[i] == '*' && b[i + 1] == '/') {
+                i += 1;
+            }
+            i += 2;
+        } else if b[i] == '/' && i + 1 < b.len() && b[i + 1] == '/' {
+            while i < b.len() && b[i] != '\n' {
+                i += 1;
+            }
+        } else if b[i] == '"' {
+            i += 1;
+            while i < b.len() && b[i] != '"' {
+                if b[i] == '\\' {
+                    i += 1;
+                }
+                i += 1;
+            }
+            i += 1;
+            o.push_str("\"\"");
+        } else {
+            o.push(b[i]);
+            i += 1;
+        }
+    }
+    o
+}
+
+/// The text of the function `name` defined in `src` (a line that starts with a type, then `name(` ... `)` then `{`), up to its closing brace.
+fn body_of(src: &str, name: &str) -> Option<String> {
+    let pat = format!("{name}(");
+    let mut from = 0;
+    while let Some(p) = src[from..].find(&pat) {
+        let at = from + p;
+        from = at + pat.len();
+        let line_start = src[..at].rfind('\n').map_or(0, |x| x + 1);
+        let before = &src[line_start..at];
+        // a definition: the name is preceded only by a return type (no '=' , ';' , '(' , ',' or an indentation of a statement)
+        if before.is_empty() || before.starts_with(' ') || before.contains(|c| "=;(,".contains(c)) || before.trim_end() != before.trim_end_matches(|c: char| c == '*') && false {
+            continue;
+        }
+        // find the closing parenthesis of the parameter list, then require '{'
+        let rest = &src[at..];
+        let close = rest.find(')')?;
+        let after = rest[close + 1..].trim_start();
+        if !after.starts_with('{') {
+            continue;
+        }
+        let open = at + close + 1 + (rest[close + 1..].len() - after.len());
+        let mut depth = 0;
+        for (k, c) in src[open..].char_indices() {
+            match c {
+                '{' => depth += 1,
+                '}' => {
+                    depth -= 1;
+                    if depth == 0 {
+                        return Some(src[open..open + k + 1].to_string());
+                    }
+                }
+                _ => {}
+            }
+        }
+    }
+    None
+}
+
+fn callees(body: &str) -> BTreeSet<String> {
+    let b: Vec<char> = body.chars().collect();
+    let mut out = BTreeSet::new();
+    let mut i = 0;
+    while i < b.len() {
+        if b[i].is_alphabetic() || b[i] == '_' {
+            let s = i;
+            while i < b.len() && (b[i].is_alphanumeric() || b[i] == '_') {
+                i += 1;
+            }
+            let id: String = b[s..i].iter().collect();
+            let mut j = i;
+            while j < b.len() && b[j] == ' ' {
+                j += 1;
+            }
+            let prev = if s > 0 { b[s - 1] } else { ' ' };
+            if j < b.len() && b[j] == '(' && prev != '.' && prev != '>' && !KEYWORDS.contains(&id.as_str()) {
+                out.insert(id);
+            }
+        } else {
+            i += 1;
+        }
+    }
+    out
+}
+
+fn sources() -> HashMap<String, String> {
+    let mut m = HashMap::new();
+    for e in std::fs::read_dir(runtime_dir()).unwrap() {
+        let p = e.unwrap().path();
+        if p.extension().map_or(false, |x| x == "c" || x == "h") {
+            m.insert(p.file_name().unwrap().to_string_lossy().to_string(), strip_comments_and_strings(&std::fs::read_to_string(&p).unwrap()));
+        }
+    }
+    m
+}
+
+fn listed() -> Vec<String> {
+    let t = std::fs::read_to_string(runtime_dir().join("fle_gil_lockfree.inc")).unwrap();
+    t.lines().filter_map(|l| l.strip_prefix("X(").and_then(|r| r.split(')').next()).map(|s| s.to_string())).collect()
+}
+
+#[test]
+fn every_listed_import_is_a_row_of_the_table_and_defined_once() {
+    let table = std::fs::read_to_string(PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("src/imports_table.rs")).unwrap();
+    let src = sources();
+    let names = listed();
+    assert!(names.len() >= 10, "the list is read");
+    for n in &names {
+        assert!(table.contains(&format!("\"fle_imp_{n}\"")), "{n}: not a row of imports_table.rs");
+        let defs: Vec<&String> = src.iter().filter(|(f, s)| f.ends_with(".c") && body_of(s, &format!("fle_imp_{n}")).is_some()).map(|(f, _)| f).collect();
+        assert_eq!(defs.len(), 1, "{n}: defined in exactly one file of runtime/, found {defs:?}");
+    }
+}
+
+#[test]
+fn the_body_of_every_listed_import_calls_only_what_was_read() {
+    let src = sources();
+    let leaves: BTreeSet<&str> = LEAVES.iter().map(|l| l.0).collect();
+    let mut bad: Vec<String> = Vec::new();
+    for n in listed() {
+        let (file, body) = src.iter().filter(|(f, _)| f.ends_with(".c")).find_map(|(f, s)| body_of(s, &format!("fle_imp_{n}")).map(|b| (f.clone(), b))).unwrap();
+        let mut todo: Vec<(String, String)> = vec![(format!("fle_imp_{n}"), body)];
+        let mut seen: BTreeSet<String> = BTreeSet::new();
+        while let Some((fname, b)) = todo.pop() {
+            if !seen.insert(fname.clone()) {
+                continue;
+            }
+            for c in callees(&b) {
+                if leaves.contains(c.as_str()) || c.starts_with("STOP") {
+                    continue;
+                }
+                match body_of(&src[&file], &c) {
+                    Some(cb) => todo.push((c, cb)),
+                    None => bad.push(format!("{n} ({file}): {fname} calls `{c}`, which is neither a function of the same file nor a leaf that was read (see LEAVES): review it and extend the list with the reason, or take {n} off runtime/fle_gil_lockfree.inc")),
+                }
+            }
+        }
+    }
+    assert!(bad.is_empty(), "\n{}", bad.join("\n"));
+}
