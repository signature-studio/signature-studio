diff --git a/lift/crates/fe-lift/tests/x87_threads.rs b/lift/crates/fe-lift/tests/x87_threads.rs
new file mode 100644
index 0000000..dda8258
--- /dev/null
+++ b/lift/crates/fe-lift/tests/x87_threads.rs
@@ -0,0 +1,105 @@
+//! Decision 0234 (mt3, stage B): the x87 emulation (runtime/fle_x87.c) on two threads at the same time. In the wasm build with real threads every Worker that runs guest code calls these functions without the giant lock; the registers and the control word are in the
+//! thread-local block fle_ctx (FLE_TLS_MORE), but the scratch state of one instruction (`X`, the exception bits it raised, and `keep_snan`) was a plain static, so a second thread's instruction could write it in the middle of the first one's rounding window (`X = 0`,
+//! round twice, compare the two results including their exception bits): FSINCOS stopped with 'rounding is not decided at 256 bits' on an operand that the same code rounds on one thread (found with FL at 4 processors; docs 0234q section 7).
+//! The test runs FSINCOS and F2XM1 (the instructions of fle_x87.c that have a rounding window) on two threads over the same operands and compares every result with the single-thread result. The second test puts the two variables back to plain statics in a copy of the file and expects the failure.
+use std::path::PathBuf;
+use std::process::Command;
+
+fn runtime_dir() -> PathBuf {
+    PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("../../runtime")
+}
+
+const PROG: &str = r#"
+#include <pthread.h>
+#include "@X87C@"
+typedef struct { uint64_t m; uint16_t se; } op_t;
+static const op_t OPS[] = {
+    { 0xc90fdaa22168c000ull, 0x3ffe }, { 0xc90fdaa22168c235ull, 0x3ffe }, { 0x8000000000000000ull, 0x3ffe }, { 0x8000000000000000ull, 0x3fff }, { 0xc000000000000000ull, 0x3fff }, { 0x9a209a84fbcff799ull, 0x3ffd },
+    { 0xa000000000000000ull, 0x3ffc }, { 0xfa3dc5a3a2b1c3d4ull, 0x3ffe }, { 0x8d3a1e5b7c9f0a21ull, 0x3ffb }, { 0xb17217f7d1cf79acull, 0x3ffe },
+};
+#define NOPS ((int)(sizeof OPS / sizeof OPS[0]))
+typedef struct { fle_f80 r[4]; } res_t;
+static res_t REF[NOPS][2];
+static void one(int which, const op_t *o, res_t *out) {
+    fle_f80 v; v.m = o->m; v.se = o->se;
+    fle_x87_init();
+    push(v);
+    if (which == 0) { fle_x87_fsincos(); out->r[0] = fle_x87_r[phys(0)]; out->r[1] = fle_x87_r[phys(1)]; }
+    else if (o->se < 0x3fff) { fle_x87_f2xm1(); out->r[0] = fle_x87_r[phys(0)]; out->r[1] = v; }   /* F2XM1 is defined for |x| <= 1 */
+    else { fle_x87_fsincos(); out->r[0] = fle_x87_r[phys(0)]; out->r[1] = fle_x87_r[phys(1)]; }
+}
+static void *worker(void *arg) {
+    long id = (long)arg; int i, w, k;
+    for (i = 0; i < @ITER@; i++) {
+        for (w = 0; w < 2; w++) for (k = 0; k < NOPS; k++) {
+            res_t r; memset(&r, 0, sizeof r);
+            one(w, &OPS[(k + id) % NOPS], &r);
+            if (memcmp(&r.r[0], &REF[(k + id) % NOPS][w].r[0], sizeof r.r[0]) != 0) { fprintf(stderr, "thread %ld: op %d kind %d differs\n", id, (k + id) % NOPS, w); _exit(3); }
+        }
+    }
+    return NULL;
+}
+int main(void) {
+    pthread_t t[2];
+    int w, k;
+    for (w = 0; w < 2; w++) for (k = 0; k < NOPS; k++) one(w, &OPS[k], &REF[k][w]);
+    pthread_create(&t[0], NULL, worker, (void *)0L);
+    pthread_create(&t[1], NULL, worker, (void *)1L);
+    pthread_join(t[0], NULL); pthread_join(t[1], NULL);
+    printf("ok\n");
+    return 0;
+}
+"#;
+
+/// `mutate`: put the two scratch variables back to plain statics (what the code was before the fix): the test must then fail.
+fn run_with(mutate: bool, iters: u32) -> (bool, String) {
+    let dir = PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("../../out-x87thr");
+    std::fs::create_dir_all(&dir).unwrap();
+    let uname = format!("x87thr-{}-{}-{}", std::process::id(), iters, mutate as u8);
+    let work = dir.join(&uname);
+    std::fs::create_dir_all(&work).unwrap();
+    let rt = runtime_dir();
+    // Copies of the four files in which the registers and the control state are thread-local, as they are in the thread-local block fle_ctx of the wasm build (this test does not depend on that block): the quoted includes then come from the copies.
+    for f in ["fle_x87.c", "fle_x87.h", "fle_x87ctl.c", "fle_x87ctl.h"] {
+        let t = std::fs::read_to_string(rt.join(f)).unwrap();
+        let mut t = t.replace("fle_f80 fle_x87_r[8]", "_Thread_local fle_f80 fle_x87_r[8]").replace("fle_x87_state fle_x87", "_Thread_local fle_x87_state fle_x87");
+        if mutate && f == "fle_x87.c" {
+            let n = t.matches("_Thread_local unsigned X;").count() + t.matches("_Thread_local int keep_snan;").count();
+            assert_eq!(n, 2, "X and keep_snan are _Thread_local in fle_x87.c");
+            t = t.replace("_Thread_local unsigned X;", "unsigned X;").replace("_Thread_local int keep_snan;", "int keep_snan;");
+        }
+        std::fs::write(work.join(f), t).unwrap();
+    }
+    let c = work.join("prog.c");
+    let exe = work.join("prog");
+    std::fs::write(&c, PROG.replace("@X87C@", &work.join("fle_x87.c").display().to_string()).replace("@ITER@", &iters.to_string())).unwrap();
+    let cc = Command::new("clang")
+        .args(["-O1", "-std=gnu11", "-w", "-pthread", "-ffp-contract=off", "-include", "unistd.h", "-I"])
+        .arg(&work)
+        .arg("-I")
+        .arg(&rt)
+        .arg("-o")
+        .arg(&exe)
+        .arg(&c)
+        .arg(work.join("fle_x87ctl.c"))
+        .output()
+        .expect("run clang");
+    assert!(cc.status.success(), "clang failed: {}", String::from_utf8_lossy(&cc.stderr));
+    let r = Command::new(&exe).output().expect("run");
+    let _ = std::fs::remove_dir_all(&work);
+    (r.status.success() && String::from_utf8_lossy(&r.stdout).contains("ok"), String::from_utf8_lossy(&r.stderr).to_string())
+}
+
+#[test]
+fn two_threads_get_the_single_thread_result_from_the_instructions_with_a_rounding_window() {
+    let (ok, err) = run_with(false, 4000);
+    assert!(ok, "{err}");
+}
+
+#[test]
+fn the_same_test_fails_when_the_scratch_state_is_a_plain_static_again() {
+    // the mutation: X and keep_snan as they were. The stop is the one that FL showed at 4 processors.
+    let (ok, err) = run_with(true, 4000);
+    assert!(!ok, "two threads over a shared X did not fail: the test cannot see the race");
+    assert!(err.contains("rounding is not decided at 256 bits") || err.contains("differs"), "{err}");
+}
