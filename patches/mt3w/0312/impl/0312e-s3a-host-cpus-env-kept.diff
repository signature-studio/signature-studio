 /* ---- GetSystemInfo ----
  * SYSTEM_INFO (MSDN: SYSTEM_INFO) on x64 is 48 bytes: wProcessorArchitecture at 0, wReserved 2,
  * dwPageSize 4, lpMinimumApplicationAddress 8, lpMaximumApplicationAddress 16, dwActiveProcessorMask
  * 24, dwNumberOfProcessors 32, dwProcessorType 36, dwAllocationGranularity 40, wProcessorLevel 44,
  * wProcessorRevision 46 (the offsets follow from the member types and natural alignment).
  * Values: architecture AMD64 (9, MSDN table); page size FLE_PAGE_SIZE, the page VirtualAlloc uses
- * (MSDN: dwPageSize); one processor with mask 1, because the run is a single guest thread (a choice;
- * a host core count would make the output differ between machines); processor type 8664
+ * (MSDN: dwPageSize); the processors: fle_sys_processors (fle_sysinfo.h; the host's logical processors with real
+ * threads, 1 where one guest thread runs at a time), the mask with one bit each; processor type 8664
  * (PROCESSOR_AMD_X8664, listed in MSDN, obsolete member); level and revision 0 as the CPUID answer
  * claims no model (decision 0009; MSDN: level is for display only). The MSDN pages read do not
  * give numbers for the allocation granularity or the application address range. Granularity
@@ -642,6 +636,31 @@
     memcpy((void *)fle_addr(out, (unsigned)sizeof si, 1), si, sizeof si);
 }
 
+#ifdef FLE_GIL
+/* Decision 0312 (mt3, S3a): the number of processors is the host's (D2). hardwareConcurrency exists in the browser's Workers and in node. FLE_PROCESSORS (fle_thread.c fle_cfg_processors, S3a only: the
+ * measurement of the Worker count before the variable is removed) takes precedence when it is set. Decided once; the value is the same for every Worker. */
+EM_JS(int, fle_js_hardware_concurrency, (void), { const n = (typeof navigator !== 'undefined' && navigator.hardwareConcurrency) | 0; return n > 0 ? n : 1; });
+uint32_t fle_cfg_processors(void) __attribute__((weak));
+uint32_t fle_sys_processors(void)
+{
+    static uint32_t n;
+    uint32_t v = __atomic_load_n(&n, __ATOMIC_RELAXED);
+
+    if (v == 0) {
+        v = fle_cfg_processors ? fle_cfg_processors() : 0u;
+        if (v == 0) v = (uint32_t)fle_js_hardware_concurrency();
+        v = v < 1u ? 1u : v > FLE_SYS_MAX_PROCESSORS ? FLE_SYS_MAX_PROCESSORS : v;
+        __atomic_store_n(&n, v, __ATOMIC_RELAXED);
+    }
+    return v;
+}
+#else
+uint32_t fle_sys_processors(void)
+{
+    return 1u;
+}
+#endif
