+// decision 0312: see tp_test.c. usage: node tp_test.mjs <module.mjs>   (run.sh builds it)
+import assert from 'node:assert/strict';
+const mod = process.argv[2];
+const W = { RD: 0, WR: 1, STATE: 2, RATE: 3, CAP: 4, MAGIC: 5, VERSION: 6, FILL_MIN: 12, PUBLISHES: 14, PUBLISHED: 15, SKIPPED: 16 };
+let n = 0;
+const ok = (c, m) => { n++; assert.ok(c, m); };
+const eq = (a, b, m) => { n++; assert.equal(a, b, m); };
+
+// ---- 1. a page without audio: no host object -> no external consumer, nothing is posted
+{
+  globalThis.__posted = [];
+  globalThis.self = { postMessage: (m) => globalThis.__posted.push(m) };
+  delete globalThis.fleAudioHost;
+  const M = await (await import(mod + '?noaudio')).default();
+  eq(M._t_external(), 0, 'no fleAudioHost: no external consumer');
+  eq(globalThis.__posted.length, 0, 'nothing posted');
+}
+// ---- 2. a page with audio
+globalThis.__posted = [];
+globalThis.self = { postMessage: (m) => globalThis.__posted.push(m) };
+globalThis.fleAudioHost = { cap: 32768, rate: 44100 };
+const M = await (await import(mod + '?audio')).default();
+eq(M._t_external(), 1, 'fleAudioHost: external consumer');
+eq(M._t_external(), 1, 'asked again: the same answer, announced once');
+const ring = globalThis.__posted.filter((m) => m.type === 'audio-ring');
+eq(ring.length, 1, 'one audio-ring message');
+const r = ring[0];
+eq(r.cap, 32768, 'capacity');
+ok(r.hdr % 4 === 0 && r.data % 4 === 0 && r.hdr > 0 && r.data > 0, 'offsets are 4-aligned');
+const mem = r.sab;
+const h = new Int32Array(mem, r.hdr, 32);
+const d = new Float32Array(mem, r.data, 32768 * 2);
+eq(h[W.MAGIC], 0x52414c46, 'magic'); eq(h[W.CAP], 32768, 'cap word'); eq(h[W.RATE], 44100, 'rate word'); eq(h[W.VERSION], 1, 'version'); eq(h[W.FILL_MIN], 0x7fffffff, 'fill min');
+const frames = (k, v0) => { const p = M._t_alloc(k); const f = new Float32Array(M.HEAPU8.buffer, p, k * 2); for (let i = 0; i < k; i++) { f[2 * i] = v0 + i; f[2 * i + 1] = -(v0 + i); } return p; };
+const slot = (i) => [d[(i & 32767) * 2], d[(i & 32767) * 2 + 1]];
+
+// ---- 3. contiguous hand-over: frames land at first.., WR follows, the counters count, no gap
+M._t_publish(frames(1000, 1), 1000, 0);
+eq(Atomics.load(h, W.WR), 1000, 'WR after the first publish'); eq(slot(0)[0], 1, 'frame 0'); eq(slot(999)[1], -1000, 'frame 999');
+M._t_publish(frames(1000, 2001), 1000, 1000);
+eq(Atomics.load(h, W.WR), 2000, 'WR after the second'); eq(slot(1000)[0], 2001, 'frame 1000'); eq(slot(500)[0], 501, 'the first block is intact (no zero fill over it)');
+eq(Atomics.load(h, W.PUBLISHES), 2, 'publishes'); eq(Atomics.load(h, W.PUBLISHED), 2000, 'published frames'); eq(Atomics.load(h, W.SKIPPED), 0, 'skipped');
+// ---- 4. the read position: unwrapped, monotonic, across the 32-bit wrap
+Atomics.store(h, W.RD, 600);
+eq(M._t_consumed(), 600, 'consumed 600');
+Atomics.store(h, W.RD, 0xfffffff0 | 0);
+eq(M._t_consumed(), 4294967280, 'consumed 2^32-16');
+Atomics.store(h, W.RD, 16);
+eq(M._t_consumed(), 4294967296 + 16, 'consumed past the wrap');
+Atomics.store(h, W.RD, 8);   // a stale smaller read must not move it back
+eq(M._t_consumed(), 4294967296 + 16, 'monotonic');
+// restart the position for the next checks: a new instance would be needed; use frames relative to the large base instead
+const base = 4294967296 + 16;
+// ---- 5. a late hand-over (the output has already passed part of it): the passed frames are skipped, WR moves
+const pre = Atomics.load(h, W.SKIPPED);
+M._t_publish(frames(100, 7000), 100, base - 40);   // 40 frames behind the read position, 60 ahead
+eq(Atomics.load(h, W.SKIPPED), pre + 40, '40 late frames are skipped');
+eq(slot(base)[0], 7040, 'the first frame that is still in time is written');
+// ---- 6. a gap since the last hand-over: silence for it (up to the capacity), the earlier data is untouched
+const wr = base + 60;   // the end of the last hand-over
+M._t_publish(frames(100, 9000), 100, wr + 300);   // 300 frames of gap
+eq(slot(wr + 100)[0], 0, 'gap is silence'); eq(slot(wr + 299)[1], 0, 'gap is silence (right channel)'); eq(slot(wr + 300)[0], 9000, 'frame after the gap');
+eq(slot(base + 10)[0], 7050, 'the data before the gap is intact');
+// ---- 7. rewrite: only frames at least `guard` ahead of the read position and before WR
+const rdp = M._t_consumed();
+const first = rdp + 100;
+M._t_rewrite(frames(500, 50000), 500, first, 256);
+eq(slot(rdp + 100)[0], slot(rdp + 100)[0], 'self-check');
+ok(slot(rdp + 255)[0] !== 50000 + 155 || rdp + 255 >= wr + 300 + 100, 'frames nearer than the guard are not rewritten');
+ok(slot(rdp + 256 + 5)[0] === 50000 + 161 || rdp + 261 >= wr + 300 + 100, 'a frame beyond the guard is rewritten');
+eq(Atomics.load(h, W.WR) >>> 0, (wr + 400) >>> 0, 'a rewrite does not move WR');
+// ---- 8. the state words
+M._t_state(2, 48000);
+eq(Atomics.load(h, W.STATE), 2, 'state'); eq(Atomics.load(h, W.RATE), 48000, 'rate');
+// ---- 9. the report of the first Worker: the unlock log, the counters
+M._t_unlock(123456, 4096); M._t_unlock(123456 + 4096, 4096);
+const st = globalThis.fleAudioWorkerState();
+eq(st.unlocks.length, 2, 'two unlocks logged'); eq(st.unlocks[0].first, 123456, 'first of unlock 0'); eq(st.unlocks[1].n, 4096, 'n of unlock 1'); ok(st.unlocks[0].t > 1e12, 'epoch time');
+eq(st.publishes, 4, 'publishes (stat)'); ok(st.gapFrames >= 300, 'gap frames counted'); ok(st.skipped >= 40, 'skipped counted');
+ok(typeof globalThis.fleAudioPace === 'function' && typeof globalThis.fleAudioRewrite === 'function', 'the page hook functions exist');
+// ---- 10. the 2 Hz pulse is posted by the first Worker's thread switch
+M._t_switch(0, 1); M._t_switch(1, 0);
+await new Promise((res) => setTimeout(res, 600));
+M._t_switch(0, 1); M._t_switch(1, 0);
+ok(globalThis.__posted.some((m) => m.type === 'audio-pulse'), 'a pulse reaches the page from the first Worker');
+console.log('tp_test: ' + n + ' checks ok');
