[
 {
  "name": "tp-play",
  "what": "ci1 0343: the reference project played, then 12 File-menu open/Escape cycles during playback with a Chrome trace (toplevel + devtools.timeline + v8.cpu_profiler: all threads incl. pthread workers), sync clock events before/after, latDump of the page's own records + saveLog (engine log after the trace, for the FLE_DIAG_GIL lines; the measured part is identical to scn-tp.json)",
  "ops": [
   {
    "op": "closeWizard"
   },
   {
    "op": "wait",
    "ms": 2500
   },
   {
    "op": "openZipProject"
   },
   {
    "op": "wait",
    "ms": 10000
   },
   {
    "op": "describe",
    "name": "before-play"
   },
   {
    "op": "wait",
    "ms": 2000
   },
   {
    "op": "key",
    "code": "Space"
   },
   {
    "op": "wait",
    "ms": 10000
   },
   {
    "op": "audioMark",
    "name": "bp"
   },
   {
    "op": "traceStart",
    "categories": [
     "toplevel",
     "devtools.timeline",
     "disabled-by-default-devtools.timeline",
     "disabled-by-default-v8.cpu_profiler"
    ]
   },
   {
    "op": "wait",
    "ms": 800
   },
   {
    "op": "syncClock",
    "name": "a"
   },
   {
    "op": "menuCycles",
    "n": 12
   },
   {
    "op": "syncClock",
    "name": "b"
   },
   {
    "op": "wait",
    "ms": 500
   },
   {
    "op": "traceStop",
    "name": "tp"
   },
   {
    "op": "latDump",
    "name": "tp-play"
   },
   {
    "op": "audioDump",
    "name": "audio-tp"
   },
   {
    "op": "saveLog",
    "name": "engine-log",
    "all": true
   },
   {
    "op": "key",
    "code": "Space"
   },
   {
    "op": "wait",
    "ms": 1500
   },
   {
    "op": "expectRunning"
   }
  ]
 }
]