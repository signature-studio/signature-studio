-O0
--profiling-funcs
-sALLOW_MEMORY_GROWTH=1
-sSTACK_SIZE=8MB
-sGLOBAL_BASE=268435456
-sENVIRONMENT=web,worker
-sMODULARIZE=1
-sEXIT_RUNTIME=1
-sEXPORT_ES6=1
-sFILESYSTEM=0
-sSUPPORT_LONGJMP=wasm
-sJSPI
--js-library
lift/harness/web/threads/fle_thread_lib.js
--js-library
lift/harness/web/fruity/fle_idle_lib.js
--js-library
lift/harness/web/filedlg/fle_filedlg_lib.js
-sEXPORTED_FUNCTIONS=_main,_fle_wasm_thread_entry,_fle_host_post_input
-sEXPORTED_RUNTIME_METHODS=ENV,wasmExports,stackRestore
-pthread
-sPTHREAD_POOL_SIZE=0
-sINITIAL_MEMORY=671088640
-sMAXIMUM_MEMORY=2147483648
-Wl,--export-memory
-Wl,--export=__tls_base
-Wl,--allow-undefined
-sERROR_ON_UNDEFINED_SYMBOLS=0
-sWARN_ON_UNDEFINED_SYMBOLS=0
-Wl,--wrap=__cyg_profile_func_enter
-Wl,--wrap=fle_raster_wrote
-Wl,--wrap=fprintf
-Wl,--wrap=fputs
-Wl,--wrap=abort
-Wl,--wrap=fle_imp_LockResource
-Wl,--wrap=fle_imp_FormatMessageW
-Wl,--wrap=fle_imp_RtlPcToFileHeader
-Wl,--wrap=fle_imp_AcquireSRWLockExclusive
-Wl,--wrap=fle_imp_ReleaseSRWLockExclusive
-Wl,--wrap=fle_imp_AcquireSRWLockShared
-Wl,--wrap=fle_imp_ReleaseSRWLockShared
-Wl,--wrap=fle_imp_GetModuleHandleExW
-Wl,-Map,lift/out-app/variants/O2/web/link.map
lift/out-app/obj/b2d/b2d_swap.o
lift/out-app/b2d/build/libblend2d.a
-lm
-o
lift/out-app/variants/O2/web/flengine6.js
-msimd128
-matomics
-mbulk-memory
