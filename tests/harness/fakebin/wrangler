#!/usr/bin/env bash
# Tripwire, not a double: scripts/preflight.sh must never call wrangler (the Cloudflare checks are retired, 依頼者の決定 2026-11-10).
# Any call is recorded in $FAKE_WRANGLER_LOG (when set) and fails with 97. t07 checks that the log stays empty.
[ -n "${FAKE_WRANGLER_LOG:-}" ] && echo "wrangler called: $*" >> "$FAKE_WRANGLER_LOG"
echo "fake wrangler: called (this must not happen): $*" >&2
exit 97
