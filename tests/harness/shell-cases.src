# agent<TAB>expect<TAB>command          (expect: allow | deny | LIMIT-allow)
# LIMIT-allow = a form the rules do NOT stop (a known limit, see README.md "Limits"). The test fails if such a form starts being denied or the list changes silently,
# so that the README stays true. Lines starting with # are ignored. The commands are data; nothing here is executed.

# ---- build (main): allowed
build	allow	git status --short
build	allow	git diff HEAD~1
build	allow	git log --oneline -5
build	allow	git show HEAD --stat
build	allow	git -C /home/ubuntu/work/x status --short
build	allow	git -C /home/ubuntu/work/x diff --stat
build	allow	ls -la src
build	allow	wc -l README.md
build	allow	stat README.md
build	allow	opencode api session.active
build	allow	opencode api session.get --param sessionID=ses_abc
build	allow	opencode api session.message.list --param sessionID=ses_abc --param limit=3
build	allow	opencode api session.synthetic --param sessionID=ses_abc --data '{"text":"hello","resume":true}'
build	allow	opencode api POST /api/rpc/opencode.goal/get --data '{"input":{"sessionID":"ses_abc"}}'
build	allow	opencode api session.command --param sessionID=ses_abc --data '{"name":"goal","text":"resume"}'
build	allow	scripts/preflight.sh
build	allow	./scripts/preflight.sh
build	allow	scripts/audit-session.sh
build	allow	scripts/audit-session.sh ses_abc
build	allow	~/.agents/skills/opencode-send-message/scripts/oc-msg.sh send ses_abc "go on"
build	allow	/home/ubuntu/.agents/skills/opencode-send-message/scripts/oc-msg.sh state ses_abc
build	allow	$HOME/.agents/skills/opencode-send-message/scripts/oc-msg.sh last ses_abc
# ---- build: denied (everything that writes or runs something else)
build	deny	echo hi
build	deny	cat README.md
build	deny	head -3 .env
build	deny	jq . a.json
build	deny	cargo build
build	deny	rm -rf target
build	deny	git add -A
build	deny	git commit -m x
build	deny	git push origin main
build	deny	git -C /home/ubuntu/work/x commit -m x
build	deny	git -C /home/ubuntu/work/x push origin main
build	deny	git -C /home/ubuntu/work/x reset --hard HEAD
build	deny	git -C /home/ubuntu/work/x checkout -- .
build	deny	git diff --no-index /dev/null /etc/passwd
build	deny	git -C /home/ubuntu/work/x diff --no-index /dev/null /etc/passwd
build	deny	git diff --output=p.patch
build	deny	git status 2>/dev/null
build	deny	ls > out.txt
build	deny	ls -la src > /tmp/opencode/list.txt
build	deny	scripts/preflight.sh > /tmp/opencode/pf.txt
build	deny	scripts/preflight.sh --anything
build	deny	./scripts/preflight.sh x
build	deny	scripts/audit-session.sh ses_abc > /tmp/opencode/a.txt
build	deny	scripts/preflight.sh; cat /etc/passwd
build	deny	scripts/preflight.sh && rm -rf x
build	deny	FOO=1 scripts/preflight.sh
build	deny	bash scripts/preflight.sh
build	deny	sh -c "scripts/preflight.sh"
build	deny	scripts/launch.sh
build	deny	scripts/set-model-profile.sh haiku
build	deny	scripts/setup-repo.sh
build	deny	opencode api session.switchModel --param sessionID=ses_abc --data '{"model":{"providerID":"p","id":"m"}}'
build	deny	opencode api post /api/session/ses_abc/model --data '{}'
build	deny	opencode api session.update --param sessionID=ses_abc --data '{}'
build	deny	opencode api session.prompt --param sessionID=ses_abc --data '{"text":"x"}'
build	deny	opencode api session.create --data '{}'
build	deny	opencode api session.interrupt --param sessionID=ses_abc
build	deny	opencode api session.command --param sessionID=ses_abc --data '{"name":"goal","text":"clear"}'
build	deny	opencode api session.command --param sessionID=ses_abc --data '{"name":"models","text":""}'
build	deny	opencode api session.command --param sessionID=ses_abc --data '{"name":"models","text":""}' --data '{"name":"goal","text":"resume"}'
build	deny	opencode api session.command --param sessionID=ses_abc -d '{"name":"models","text":""}' --data '{"name":"goal","text":"resume"}'
build	deny	opencode api session.command --param sessionID=ses_abc --data '{"name":"goal","text":"resume"}' -d '{"name":"models","text":""}'
build	deny	opencode service stop
build	deny	opencode run "x"
build	deny	opencode auth export
build	deny	opencode api session.get --param sessionID=ses_abc | jq .data.model
build	deny	~/.agents/skills/opencode-send-message/scripts/oc-msg.sh send ses_abc "a > b"
build	deny	~/.agents/skills/opencode-send-message/scripts/oc-msg.sh send ses_abc "x" > /tmp/opencode/receipt.txt
build	deny	bash -c "~/.agents/skills/opencode-send-message/scripts/oc-msg.sh send ses_abc x"
build	deny	sleep 0
build	deny	timeout 5 ls
build	deny	nohup foo
build	deny	disown
build	deny	systemd-run --user x
build	deny	sleep 1 && echo x
build	deny	git status; sleep 2
build	deny	echo $(sleep 1)
build	deny	env sleep 1
build	deny	FOO=1 sleep 1
build	deny	bash -c "sleep 1"
build	deny	python3 -c "import time; time.sleep(1)"

# ---- worker: allowed (it must be able to work)
worker	allow	cargo build --release
worker	allow	cargo test -p fe-pe
worker	allow	cargo test
worker	allow	npm run test:worker
worker	allow	grep -rn wrangler app/package.json
worker	deny	npx wrangler whoami
worker	deny	wrangler whoami
worker	deny	wrangler deployments list --name fl-studio-web
worker	deny	wrangler r2 bucket list
