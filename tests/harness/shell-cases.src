worker	deny	gh api repos/o/r/git/refs/heads/main -f sha=0
worker	deny	gh api repos/o/r/contents/x --input body.json
worker	deny	gh auth token
worker	deny	gh auth switch
worker	deny	gh auth login
worker	deny	opencode auth export
worker	deny	opencode auth export opencode
worker	deny	opencode auth list
worker	deny	opencode api session.switchModel --param sessionID=ses_abc --data '{}'
worker	deny	opencode api session.create --data '{}'
worker	deny	opencode api session.prompt --param sessionID=ses_abc --data '{"text":"x"}'
worker	deny	opencode api session.update --param sessionID=ses_abc --data '{}'
