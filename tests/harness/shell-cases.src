worker	deny	wrangler deploy
worker	allow	rm -rf target
worker	allow	rm -rf lift/out-m1
worker	allow	rm -rf /tmp/opencode/scratch
worker	allow	rm -rf ~/.cache/signature-studio/tmp/x
worker	allow	rm -f a b
worker	allow	rm -rf $HOME/.cache/x
worker	allow	git status
worker	allow	git add -A
worker	allow	git commit -m "fix the parser; flag -n is not used"
worker	allow	git commit -m "mention --force in the text only"
worker	allow	git push origin main
worker	allow	git push --dry-run origin HEAD
worker	allow	git push -u origin feature
worker	allow	git reset --soft HEAD~1
worker	allow	git reset HEAD file
worker	allow	git stash
worker	allow	git checkout -b feature
worker	allow	gh auth status
worker	allow	gh repo view signature-studio/signature-studio --json name
worker	allow	gh api repos/signature-studio/signature-studio --jq .private
worker	allow	gh pr list
worker	allow	gh workflow list
worker	allow	gh variable list
worker	allow	systemctl --user list-timers
worker	allow	systemctl --user status goal-nudge.timer
worker	allow	systemctl --user is-enabled goal-nudge.timer
worker	allow	journalctl --user -u goal-nudge.service -n 5
worker	allow	opencode api session.active
worker	allow	opencode api session.synthetic --param sessionID=ses_abc --data '{"text":"report"}'
worker	allow	sudo -n apt-get install -y brotli
worker	allow	python3 tools/x.py > out.txt
worker	allow	echo hi > docs/x.md
worker	allow	ls ~/.local/share/opencode/tool-output
worker	allow	cat ~/.local/share/opencode/shell/abc/out.txt
worker	allow	source scripts/env.sh && emcc --version
worker	allow	scripts/preflight.sh
worker	allow	scripts/audit-session.sh ses_abc
worker	allow	scripts/scan-forbidden.sh
worker	allow	scripts/setup-repo.sh
worker	allow	foo &
# ---- worker: denied (the short list: banned commands, irreversible shared effects, the owner's credentials)
worker	deny	sleep 0
worker	deny	sleep 1 && echo x
worker	deny	echo a; sleep 2
worker	deny	cd /tmp && sleep 3
worker	deny	(sleep 1)
worker	deny	echo $(sleep 1)
worker	deny	timeout 5 ls
worker	deny	timeout 100 npx wrangler whoami
worker	deny	nohup foo &
worker	deny	disown
worker	deny	systemd-run --user --scope -p MemoryMax=1G x
worker	deny	git push --force origin main
worker	deny	git push -f origin main
worker	deny	git push origin main --force
worker	deny	git push origin main -f
worker	deny	git push --force-with-lease origin main
worker	deny	git push origin +main
worker	deny	git push origin HEAD:+main
worker	deny	git push origin :main
worker	deny	git push origin --delete feature
worker	deny	git push --mirror origin
worker	deny	git push --delete origin feature
worker	deny	git push -d origin feature
worker	deny	git push origin -d feature
worker	deny	git push --force origin main
worker	deny	git push --no-verify origin main
worker	deny	git push origin main --no-verify
worker	deny	git commit --no-verify -m x
worker	deny	git commit -m x --no-verify
worker	deny	git commit -n -m x
worker	deny	git -c core.hooksPath=/dev/null commit -m x
worker	deny	git config core.hooksPath /dev/null
worker	deny	git reset --hard origin/main
worker	deny	git reset --hard HEAD~1
worker	deny	git filter-repo --path x
worker	deny	gh repo delete signature-studio/signature-studio --yes
worker	deny	gh repo edit --visibility private
worker	deny	gh repo archive x
worker	deny	gh secret set X
worker	allow	gh secret list
worker	deny	gh variable set X
worker	deny	gh workflow run deploy.yml
worker	deny	gh workflow run x
