worker	deny	git commit -m "see ~/.config/opencode/AGENTS.md"

# ---- worker: forms the rules cannot stop (LIMIT-allow). The plugin harness-guard stops the first group; audit-session.sh counts the rest.
worker	LIMIT-allow	env sleep 1
worker	LIMIT-allow	FOO=1 sleep 1
worker	LIMIT-allow	command sleep 1
worker	LIMIT-allow	xargs sleep 1
worker	LIMIT-allow	bash -c "sleep 1"
worker	LIMIT-allow	eval "sleep 1"
worker	LIMIT-allow	python3 -c "import time; time.sleep(1)"
worker	LIMIT-allow	rm -rf *
worker	LIMIT-allow	rm -rf ./*
worker	LIMIT-allow	rm -rf $HOME/work/other-project
worker	LIMIT-allow	rm -rf /etc/x
worker	LIMIT-allow	git -C /home/ubuntu/work/x push --force origin main
worker	LIMIT-allow	bash -c "git push --force origin main"
worker	LIMIT-allow	python3 -c "import shutil; shutil.rmtree('/home/ubuntu/x')"
worker	LIMIT-allow	bash -c "wrangler whoami"
worker	LIMIT-allow	env wrangler whoami

# ---- reviewer: read-only
reviewer	allow	git status --short
reviewer	allow	git diff --stat
reviewer	allow	git log --oneline -3
reviewer	allow	git show HEAD
reviewer	allow	cd /home/ubuntu/work/x && git status --short
reviewer	allow	cd /home/ubuntu/work/x && git diff --stat
reviewer	deny	git -C /home/ubuntu/work/x status --short
reviewer	deny	git -C /home/ubuntu/work/x commit -m status
reviewer	allow	ls -la src
reviewer	allow	wc -l README.md
reviewer	allow	stat README.md
reviewer	deny	cargo test
reviewer	deny	echo hi
reviewer	deny	cat README.md
reviewer	deny	rm -rf target
reviewer	deny	git add -A
reviewer	deny	git commit -m x
