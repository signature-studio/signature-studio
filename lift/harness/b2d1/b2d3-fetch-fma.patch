+// Decision 0195 (b2d3, opt-in -DB2D3_FETCH_FMA=1): the radial and conic gradient fetch of the JIT pipeline uses fused multiply-add where the CPU has it (asmjit: FMA3, i.e. every AVX2 machine); the reference code below uses x * y + a, which is
+// rounded twice. With the macro the multiply-adds of these two fetches are fused (one rounding), which reproduces the JIT's result on an AVX2/FMA CPU (measured, gradient quality DITHER); without it (the default) the result is that of the JIT restricted to SSE2.
+#ifdef B2D3_FETCH_FMA
+static BL_INLINE_NODEBUG float b3_madd(float x, float y, float a) noexcept { return __builtin_fmaf(x, y, a); }
+static BL_INLINE_NODEBUG double b3_madd(double x, double y, double a) noexcept { return __builtin_fma(x, y, a); }
+#else
+static BL_INLINE_NODEBUG float b3_madd(float x, float y, float a) noexcept { return Math::madd(x, y, a); }
+static BL_INLINE_NODEBUG double b3_madd(double x, double y, double a) noexcept { return Math::madd(x, y, a); }
+#endif
