{
  // Private FL Studio web app. NOT for public release.
  // Everything the deployment needs is in this file: deploy.yml runs wrangler deploy and nothing else (decision 0402).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fl-studio-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "account_id": "20de35ff3b74a604752032383451f8ed",
  // Access protects the hostnames you bind; the *.workers.dev name and preview URLs would be extra, separately-protected doors: both are off.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "r2_buckets": [
    { "binding": "ASSETS_BUCKET", "bucket_name": "fl-web-assets" },
    // decision 0224: the measurement beacons (POST /__perf) are kept in this bucket under perf/. A bucket that is NOT the serving one.
    { "binding": "PERF_BUCKET", "bucket_name": "fl-web-cache" }
  ],
  "vars": {
    // Fail closed: with these two empty the Worker answers 403 to every request.
    "ACCESS_TEAM_DOMAIN": "cabbage916.cloudflareaccess.com",
    "ACCESS_AUD": "88222f77dafac61c8406a9cbf1f87b032fc4777eceee37af97a56b7b7fcdbd88"
  },
  "observability": { "enabled": false }
}
